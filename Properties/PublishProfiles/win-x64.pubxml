<Project>
  <!--
    Aufruf: dotnet publish Ausgabenverwaltung.csproj -c Release -p:PublishProfile=win-x64

    Erzeugt eine einzelne, selbststaendig lauffaehige Ausgabenverwaltung.exe
    unter bin\Release\net10.0\publish\win-x64\ - beim Anwender ist keine
    .NET-Runtime vorausgesetzt.

    Diese Eigenschaften stehen absichtlich HIER und nicht im csproj: ein
    Condition="'$(RuntimeIdentifier)' != ''" im Hauptprojekt greift nicht,
    weil das Profil erst spaet ueber die SDK-Publish-Targets importiert
    wird - zu dem Zeitpunkt ist die Bedingung im Hauptprojekt schon
    ausgewertet.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLitePCLRaw legt e_sqlite3.dll als native Bibliothek daneben ab;
         ohne diese Einstellung fehlt sie in der Einzeldatei. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Kein Trimming: Avalonias XAML-Bindungen und der DI-Container
         arbeiten mit Reflection, die der Trimmer nicht zuverlaessig
         erkennt. Eine groessere Datei ist besser als eine, die erst beim
         Anwender an einer fehlenden Methode scheitert. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Sonst liegen drei .pdb-Dateien (auch die von Skia/HarfBuzz, gut
         100 MB) neben der einen .exe, die Einzeldatei-Publish eigentlich
         verspricht. Eingebettet bleibt die Stapelverfolgung im
         Fehlerdialog trotzdem lesbar. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- SkiaSharp und HarfBuzzSharp bringen ihre nativen .pdb-Dateien (rund
       100 MB) als Content-Item aus dem NuGet-Paket mit - das laeuft an
       DebugType/CopyOutputSymbolsToPublishDirectory vorbei, weshalb sie
       erst nach dem Publish aus dem Zielordner entfernt werden. Es sind
       Debug-Symbole nativer Bibliotheken, keine eigenen; ihr Fehlen
       aendert nichts an der Lauffaehigkeit. -->
  <Target Name="StreuPdbEntfernen" AfterTargets="Publish">
    <ItemGroup>
      <_StreuPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_StreuPdb)" />
  </Target>
</Project>
