<Project>
  <!--
    Aufruf: dotnet publish Ausgabenverwaltung.csproj -c Release -p:PublishProfile=osx-x64

    Erzeugt eine einzelne, selbststaendig lauffaehige Ausgabenverwaltung
    (ohne Dateiendung) unter bin\Release\net10.0\publish\osx-x64\ - fuer
    Macs mit Intel-Prozessor, keine .NET-Runtime beim Anwender
    vorausgesetzt.

    Diese Eigenschaften stehen absichtlich HIER und nicht im csproj: ein
    Condition="'$(RuntimeIdentifier)' != ''" im Hauptprojekt greift nicht,
    weil das Profil erst spaet ueber die SDK-Publish-Targets importiert
    wird - zu dem Zeitpunkt ist die Bedingung im Hauptprojekt schon
    ausgewertet. Siehe osx-arm64.pubxml/win-x64.pubxml fuer dasselbe
    Muster.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0\publish\osx-x64\</PublishDir>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLitePCLRaw legt libe_sqlite3.dylib als native Bibliothek daneben
         ab; ohne diese Einstellung fehlt sie in der Einzeldatei. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Kein Trimming: Avalonias XAML-Bindungen und der DI-Container
         arbeiten mit Reflection, die der Trimmer nicht zuverlaessig
         erkennt. Eine groessere Datei ist besser als eine, die erst beim
         Anwender an einer fehlenden Methode scheitert. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Sonst liegen mehrere Debug-Dateien (auch die von Skia/HarfBuzz,
         gut 100 MB) neben der einen Datei, die Einzeldatei-Publish
         eigentlich verspricht. Eingebettet bleibt die Stapelverfolgung im
         Fehlerdialog trotzdem lesbar. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- SkiaSharp und HarfBuzzSharp bringen ihre nativen .pdb-Dateien (rund
       100 MB) als Content-Item aus dem NuGet-Paket mit - das laeuft an
       DebugType/CopyOutputSymbolsToPublishDirectory vorbei, weshalb sie
       erst nach dem Publish aus dem Zielordner entfernt werden. Es sind
       Debug-Symbole nativer Bibliotheken, keine eigenen; ihr Fehlen
       aendert nichts an der Lauffaehigkeit. Faellt fuer diese RID nichts
       Passendes an, ist Delete mit leerer Trefferliste ein No-op. -->
  <Target Name="StreuPdbEntfernen" AfterTargets="Publish">
    <ItemGroup>
      <_StreuPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_StreuPdb)" />
  </Target>
</Project>
