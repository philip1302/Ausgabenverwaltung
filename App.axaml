<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ausgabenverwaltung.App"
             xmlns:local="using:Ausgabenverwaltung"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- ============ Zentrale Schriftgroessen ============
         Die drei Groessen, aus denen die gesamte Oberflaeche besteht.
         Einzelne Ansichten tragen KEINE eigenen Schriftgroessen mehr ein,
         sondern beziehen sie hier ueber DynamicResource.

         Die Werte hier gelten fuer die Stufe "Normal" und entsprechen
         dem, was vorher fest in den Ansichten stand. Beim Start und bei
         jeder Umstellung ueberschreibt Anzeige/Skalierung.cs sie mit den
         skalierten Werten - weil die Ansichten sie dynamisch beziehen,
         wirkt das sofort und ohne Neustart. -->
    <Application.Resources>
        <x:Double x:Key="SchriftKlein">11</x:Double>
        <x:Double x:Key="SchriftNormal">14</x:Double>
        <x:Double x:Key="SchriftUeberschrift">16</x:Double>

        <!-- Die Farbe negativer Betraege in der (unveraendert gebliebenen)
             Offene-Posten-Liste. Gedaempft und nicht signalrot: sie
             warnt nicht, sie ergaenzt nur. Ausserhalb der Offene-Posten-
             Liste steht dieselbe Bedeutung heute unter AusgabeFarbe -
             siehe dort. -->
        <SolidColorBrush x:Key="ErstattungFarbe">#A03A30</SolidColorBrush>

        <!-- Die Farbe von Ausgaben ausserhalb der Offene-Posten-Liste:
             derselbe gedaempfte Rotton wie ErstattungFarbe, unter eigenem
             Namen, weil er hier eine andere Bedeutung traegt (jede
             Ausgabe, nicht nur ein negativer Betrag). Auch hier ist die
             Farbe ein ZUSATZ - das Minuszeichen aus EuroText.FormatSigned
             steht ohnehin davor und traegt die Angabe auch ohne
             Farbwahrnehmung (Regel 10). -->
        <SolidColorBrush x:Key="AusgabeFarbe">#A03A30</SolidColorBrush>

        <!-- Die Farbe von Einnahmen - gedaempftes Hellgruen als
             Gegenstueck zum gedaempften Rot der Ausgaben, ebenso kein
             Signalton. Auch hier ist die Farbe ein ZUSATZ: das
             vorangestellte "+" (siehe EuroText.FormatSigned) traegt die
             Angabe bereits ohne Farbwahrnehmung (Regel 10). -->
        <SolidColorBrush x:Key="EinnahmeFarbe">#66BB6A</SolidColorBrush>
    </Application.Resources>

    <!-- Wiederverwendbare Tabellen-Styles fuer alle Listen-/Tabellenansichten
         (Offene Posten, Personen, ...): einheitliche Ausrichtung von
         Spaltenkoepfen und -werten, damit nicht jede Ansicht ihre eigenen
         Alignment-Werte definiert. "kopf" = klickbarer, sortierbarer
         Spaltenkopf (Button); "tabellenkopf" = statischer Spaltenkopf
         (TextBlock); "tabellenzelle" = Wert einer Tabellenzeile. Die
         Modifikatoren ".zahl" (rechtsbuendig) und ".mitte" (zentriert)
         lassen sich mit der Basisklasse kombinieren, z. B.
         Classes="tabellenzelle zahl". -->
    <Application.Styles>
        <FluentTheme />

        <!-- Die Grundschrift der Anwendung. Zwei Regeln, weil beide
             gebraucht werden: die erste setzt sie am Fenster (und an
             jedem Aufklapp-Fenster, das ein eigener Baum ist) und wird
             von dort an Eingabefelder, Schaltflaechen und Listen
             weitervererbt; die zweite fasst die Textbloecke direkt, die
             ihre Groesse sonst aus dem Thema bezoegen.

             Beide stehen VOR den uebrigen Regeln: bei gleichrangigen
             Regeln gewinnt in Avalonia die spaetere, und die Klassen
             .fehler und .filterbeschriftung weiter unten sollen die
             Grundgroesse ueberschreiben duerfen. Ein fest im Element
             eingetragener Wert schlaegt ohnehin jede Regel - deshalb
             stehen die Ueberschriften in den Ansichten mit
             DynamicResource am Element selbst. -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontSize" Value="{DynamicResource SchriftNormal}" />
        </Style>
        <!-- anzeige:Textzelle ausdruecklich mitgenannt: ein Selektor auf
             einen Typ trifft in Avalonia nur diesen Typ, nicht seine
             Ableitungen. Ohne die Ergaenzung stuenden die Tabellenzellen
             in der Groesse des Themas statt in der eingestellten. Bewusst
             nicht ":is(TextBlock)": davon waeren auch AccessText und
             TextPresenter aus den Theme-Vorlagen betroffen. -->
        <Style Selector="TextBlock, anzeige|Textzelle">
            <Setter Property="FontSize" Value="{DynamicResource SchriftNormal}" />
        </Style>

        <!-- Padding bewusst 0: der Abstand zwischen Spalten kommt
             ausschliesslich von den festen Gutter-Spalten im Grid, nicht
             von Innenabstand - sonst enden rechtsbuendige/zentrierte
             Spaltenkoepfe (zahl/mitte) nicht exakt ueber dem zugehoerigen
             Wert. -->
        <Style Selector="Button.kopf">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.kopf.zahl">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.kopf.mitte">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Statischer Spaltenkopf "Aktionen": bewusst ein (nicht
             interaktiver) Button statt eines TextBlock, damit er exakt
             dieselbe Theme-Polsterung wie die echten Buttons darunter
             erhaelt - mit einem TextBlock beginnt der Text sonst weiter
             links als der Button-Inhalt in der Zeile darunter. -->
        <Style Selector="Button.tabellenkopf-aktion">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style Selector="TextBlock.tabellenkopf">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.tabellenkopf.zahl">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.tabellenkopf.mitte">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Ab hier ":is(TextBlock)" statt "TextBlock": diese Klassen
             tragen auch die Textzellen der Tabellen (anzeige:Textzelle),
             und ein Selektor auf den blossen Typ wuerde eine Ableitung
             nicht erfassen. -->
        <Style Selector=":is(TextBlock).tabellenzelle">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBlock).tabellenzelle.zahl">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector=":is(TextBlock).tabellenzelle.mitte">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Negative Betraege in der Offene-Posten-Liste (dort weiterhin
             "Erstattung" im urspruenglichen Sinn). Zwei Regeln, weil
             Betraege an beiden Stellen stehen: als Text in den
             Tabellenzellen und als Inhalt der anklickbaren Zellen der
             Kreuztabelle. Bei den Schaltflaechen greift die Regel im
             Vorlagenbaum, weil das Thema die Vordergrundfarbe im Zustand
             "pointerover" sonst am ContentPresenter selbst ueberschreibt. -->
        <Style Selector=":is(TextBlock).erstattung">
            <Setter Property="Foreground" Value="{DynamicResource ErstattungFarbe}" />
        </Style>
        <Style Selector="Button.erstattung /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ErstattungFarbe}" />
        </Style>

        <!-- Ausgaben ausserhalb der Offene-Posten-Liste - dasselbe Muster
             wie .erstattung oben, unter eigenem Namen (siehe AusgabeFarbe). -->
        <Style Selector=":is(TextBlock).ausgabe">
            <Setter Property="Foreground" Value="{DynamicResource AusgabeFarbe}" />
        </Style>
        <Style Selector="Button.ausgabe /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AusgabeFarbe}" />
        </Style>

        <!-- Einnahmen - dasselbe Muster, nur gruen. Ausgabe und Einnahme
             schliessen sich beim Buchungstyp gegenseitig aus, und ein
             Betrag ist nach ExpenseValidator nie negativ - eine Zeile
             traegt also nie .ausgabe und .einnahme gleichzeitig. -->
        <Style Selector=":is(TextBlock).einnahme">
            <Setter Property="Foreground" Value="{DynamicResource EinnahmeFarbe}" />
        </Style>
        <Style Selector="Button.einnahme /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EinnahmeFarbe}" />
        </Style>

        <Style Selector=":is(TextBlock).archiviert">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.fehler">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
        </Style>

        <!-- Kleine Nebentexte: Feldbeschriftungen ueber den Filtern,
             Marker. Frueher in jeder Ansicht eigens mit FontSize 11
             eingetragen, jetzt eine Klasse mit einer Ressource. -->
        <Style Selector="TextBlock.klein">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
        </Style>

        <!-- Ueberschriften in Dialogen und Gruppen. -->
        <Style Selector="TextBlock.ueberschrift">
            <Setter Property="FontSize" Value="{DynamicResource SchriftUeberschrift}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Der Griff auf der Trennlinie hinter der Kategoriespalte. Er
             fuellt die ganze Abstandsspalte der Kopfzeile, damit er auch
             bei kleiner Schrift zu treffen ist; sichtbar ist davon nur
             eine haarfeine Linie in der Mitte, die beim Ueberfahren
             kraeftiger wird. Der durchsichtige Hintergrund ist nicht
             Zierde, sondern noetig: ohne ihn nimmt die Flaeche keine
             Zeigereingaben an. -->
        <Style Selector="anzeige|Spaltengriff">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Name="Linie" Width="1" Background="#D0D0D0"
                                HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="anzeige|Spaltengriff:pointerover /template/ Border#Linie">
            <Setter Property="Background" Value="#808080" />
        </Style>

        <!-- Der Farbpunkt vor einem Kategorienamen. Er ERGAENZT den
             Namen, er ersetzt ihn nie - deshalb klein, rund und immer
             neben dem Text. Die Groesse waechst mit der Schrift mit,
             sonst schrumpfte er bei "Sehr groß" optisch weg. -->
        <Style Selector="Border.farbpunkt">
            <Setter Property="Width" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Height" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>