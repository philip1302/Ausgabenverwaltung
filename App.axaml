<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ausgabenverwaltung.App"
             xmlns:local="using:Ausgabenverwaltung"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- ============ Zentrale Schriftgroessen ============
         Die drei Groessen, aus denen die gesamte Oberflaeche besteht.
         Einzelne Ansichten tragen KEINE eigenen Schriftgroessen mehr ein,
         sondern beziehen sie hier ueber DynamicResource.

         Die Werte hier gelten fuer die Stufe "Normal" und entsprechen
         dem, was vorher fest in den Ansichten stand. Beim Start und bei
         jeder Umstellung ueberschreibt Anzeige/Skalierung.cs sie mit den
         skalierten Werten - weil die Ansichten sie dynamisch beziehen,
         wirkt das sofort und ohne Neustart. -->
    <Application.Resources>
        <x:Double x:Key="SchriftKlein">11</x:Double>
        <x:Double x:Key="SchriftNormal">14</x:Double>
        <x:Double x:Key="SchriftUeberschrift">16</x:Double>

        <!-- Die Farbe negativer Betraege (Erstattungen). Gedaempft und
             nicht signalrot: sie unterscheidet eine Erstattung von einer
             Ausgabe, sie warnt nicht. Und sie ist ein ZUSATZ - das
             Minuszeichen steht ohnehin davor und traegt die Angabe auch
             ohne Farbwahrnehmung. -->
        <SolidColorBrush x:Key="ErstattungFarbe">#A03A30</SolidColorBrush>
    </Application.Resources>

    <!-- Wiederverwendbare Tabellen-Styles fuer alle Listen-/Tabellenansichten
         (Offene Posten, Personen, ...): einheitliche Ausrichtung von
         Spaltenkoepfen und -werten, damit nicht jede Ansicht ihre eigenen
         Alignment-Werte definiert. "kopf" = klickbarer, sortierbarer
         Spaltenkopf (Button); "tabellenkopf" = statischer Spaltenkopf
         (TextBlock); "tabellenzelle" = Wert einer Tabellenzeile. Die
         Modifikatoren ".zahl" (rechtsbuendig) und ".mitte" (zentriert)
         lassen sich mit der Basisklasse kombinieren, z. B.
         Classes="tabellenzelle zahl". -->
    <Application.Styles>
        <FluentTheme />

        <!-- Die Grundschrift der Anwendung. Zwei Regeln, weil beide
             gebraucht werden: die erste setzt sie am Fenster (und an
             jedem Aufklapp-Fenster, das ein eigener Baum ist) und wird
             von dort an Eingabefelder, Schaltflaechen und Listen
             weitervererbt; die zweite fasst die Textbloecke direkt, die
             ihre Groesse sonst aus dem Thema bezoegen.

             Beide stehen VOR den uebrigen Regeln: bei gleichrangigen
             Regeln gewinnt in Avalonia die spaetere, und die Klassen
             .fehler und .filterbeschriftung weiter unten sollen die
             Grundgroesse ueberschreiben duerfen. Ein fest im Element
             eingetragener Wert schlaegt ohnehin jede Regel - deshalb
             stehen die Ueberschriften in den Ansichten mit
             DynamicResource am Element selbst. -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontSize" Value="{DynamicResource SchriftNormal}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SchriftNormal}" />
        </Style>

        <!-- Padding bewusst 0: der Abstand zwischen Spalten kommt
             ausschliesslich von den festen Gutter-Spalten im Grid, nicht
             von Innenabstand - sonst enden rechtsbuendige/zentrierte
             Spaltenkoepfe (zahl/mitte) nicht exakt ueber dem zugehoerigen
             Wert. -->
        <Style Selector="Button.kopf">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.kopf.zahl">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.kopf.mitte">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Statischer Spaltenkopf "Aktionen": bewusst ein (nicht
             interaktiver) Button statt eines TextBlock, damit er exakt
             dieselbe Theme-Polsterung wie die echten Buttons darunter
             erhaelt - mit einem TextBlock beginnt der Text sonst weiter
             links als der Button-Inhalt in der Zeile darunter. -->
        <Style Selector="Button.tabellenkopf-aktion">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style Selector="TextBlock.tabellenkopf">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.tabellenkopf.zahl">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.tabellenkopf.mitte">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.tabellenzelle">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.tabellenzelle.zahl">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.tabellenzelle.mitte">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Negative Betraege (Erstattungen). Zwei Regeln, weil Betraege
             an beiden Stellen stehen: als Text in den Tabellenzellen und
             als Inhalt der anklickbaren Zellen der Kreuztabelle. Bei den
             Schaltflaechen greift die Regel im Vorlagenbaum, weil das
             Thema die Vordergrundfarbe im Zustand "pointerover" sonst am
             ContentPresenter selbst ueberschreibt. -->
        <Style Selector="TextBlock.erstattung">
            <Setter Property="Foreground" Value="{DynamicResource ErstattungFarbe}" />
        </Style>
        <Style Selector="Button.erstattung /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ErstattungFarbe}" />
        </Style>

        <Style Selector="TextBlock.archiviert">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.fehler">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
        </Style>

        <!-- Kleine Nebentexte: Feldbeschriftungen ueber den Filtern,
             Marker. Frueher in jeder Ansicht eigens mit FontSize 11
             eingetragen, jetzt eine Klasse mit einer Ressource. -->
        <Style Selector="TextBlock.klein">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
        </Style>

        <!-- Ueberschriften in Dialogen und Gruppen. -->
        <Style Selector="TextBlock.ueberschrift">
            <Setter Property="FontSize" Value="{DynamicResource SchriftUeberschrift}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Der Farbpunkt vor einem Kategorienamen. Er ERGAENZT den
             Namen, er ersetzt ihn nie - deshalb klein, rund und immer
             neben dem Text. Die Groesse waechst mit der Schrift mit,
             sonst schrumpfte er bei "Sehr groß" optisch weg. -->
        <Style Selector="Border.farbpunkt">
            <Setter Property="Width" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Height" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>