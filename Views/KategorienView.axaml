<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.KategorienView"
             x:Name="Wurzel"
             x:DataType="vm:KategorienViewModel">

    <UserControl.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:KategorieKnoten">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!-- Ein Eintrag der Farbauswahl: Punkt und Name nebeneinander.
             Der Name ist nicht schmueckend, sondern die einzige Angabe,
             die auch ohne Farbwahrnehmung traegt. -->
        <Style Selector="Button.farbwahl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Knoten der Zielauswahl beim Zusammenfuehren: sieht wie eine
             Beschriftung aus, ist aber die Schaltflaeche, ueber die
             gewaehlt wird - dasselbe Muster wie die Kategorie-Auswahl in
             AusgabenlisteView. -->
        <Style Selector="Button.kategoriewahl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Werkzeugleiste: alle Aktionen wirken auf AusgewaehlterKnoten -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Neue Oberkategorie" Command="{Binding NeueOberkategorieCommand}" />
            <Button Content="Neue Unterkategorie"
                    Command="{Binding NeueUnterkategorieCommand}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}" />
            <Button Content="Umbenennen"
                    Command="{Binding BearbeitenStartenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}" />

            <!-- Farbe der ausgewaehlten Kategorie. Feste Palette statt
                 eines freien Farbwaehlers: so kann keine Kombination
                 entstehen, die niemand mehr lesen kann. -->
            <Button x:Name="FarbAuswahl"
                    Content="Farbe…"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}"
                    Click="Farbwahl_Oeffnen"
                    ToolTip.Tip="Farbe der Kategorie wählen. Unterkategorien ohne eigene Farbe übernehmen sie.">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="{anzeige:Breite 300}" Spacing="4">
                            <!-- Die Ueberschrift nennt die Kategorie, um die
                                 es geht. Sie kommt aus FarbwahlKnoten und
                                 nicht aus der Baumauswahl: die ist
                                 verschwunden, sobald dieses Fenster den
                                 Fokus hat. -->
                            <TextBlock Text="{Binding FarbwahlHinweis}"
                                       Classes="klein" Foreground="Gray"
                                       TextWrapping="Wrap" Margin="6,0,0,4" />

                            <!-- Fuenfzehn Eintraege werden bei den grossen
                                 Schriftstufen hoeher als der Bildschirm -
                                 deshalb mit Bildlauf. -->
                            <ScrollViewer MaxHeight="{anzeige:Breite 360}">
                                <ItemsControl ItemsSource="{Binding Farboptionen}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FarbOption">
                                            <!-- Auswahl ueber das Click-Ereignis statt
                                                 ueber eine Command-Bindung: die muesste
                                                 aus dem Aufklappfenster heraus auf den
                                                 DataContext der Ansicht zugreifen, und
                                                 der Weg dorthin fuehrt ueber eine
                                                 Fenstergrenze. Was gesetzt wird, steht
                                                 weiterhin im ViewModel (Regel 7). -->
                                            <Button Classes="farbwahl"
                                                    Click="Farbe_Gewaehlt">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="farbpunkt" Background="{Binding Pinsel}" />
                                                    <TextBlock Text="{Binding Bezeichnung}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Archivieren"
                    Command="{Binding ArchivierenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}"
                    IsVisible="{Binding !AusgewaehlterKnotenIstArchiviert}" />
            <Button Content="Wiederherstellen"
                    Command="{Binding WiederherstellenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsVisible="{Binding AusgewaehlterKnotenIstArchiviert}" />

            <!-- Loeschen steht NEBEN dem Archivieren, nicht an seiner
                 Stelle: archiviert wird der Normalfall, geloescht nur,
                 was nirgends verwendet wird (Regel 8). Was im Weg steht,
                 erklaert das Band darunter. -->
            <Button Content="Löschen"
                    Command="{Binding LoeschenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}"
                    ToolTip.Tip="Endgültig löschen. Möglich nur, wenn die Kategorie weder Ausgaben noch Unterkategorien noch Vorlagen hat." />
            <Button Content="▲" ToolTip.Tip="Nach oben verschieben"
                    Command="{Binding NachObenVerschiebenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}" />
            <Button Content="▼" ToolTip.Tip="Nach unten verschieben"
                    Command="{Binding NachUntenVerschiebenCommand}"
                    CommandParameter="{Binding AusgewaehlterKnoten}"
                    IsEnabled="{Binding KnotenBestaetigtAusgewaehlt}" />
            <CheckBox Content="Archivierte anzeigen" IsChecked="{Binding ArchivierteAnzeigen}" Margin="24,0,0,0" />
        </StackPanel>

        <!-- Nachfrage, ob Unterkategorien beim Archivieren mitgenommen werden sollen -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ArchivierungAnfrageAktiv}"
                Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ArchivierungAnfrageText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Nur diese Kategorie" Command="{Binding ArchivierungNurDieseBestaetigenCommand}" />
                    <Button Content="Mit Unterkategorien" Command="{Binding ArchivierungMitUnterkategorienBestaetigenCommand}" />
                    <Button Content="Abbrechen" Command="{Binding ArchivierungAbbrechenCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sicherheitsabfrage vor dem Loeschen einer unbenutzten
             Kategorie. Der Name steht darin, damit nicht die falsche
             verschwindet. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding LoeschAnfrageAktiv}"
                Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding LoeschAnfrageText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Löschen" Command="{Binding LoeschenBestaetigenCommand}" />
                    <Button Content="Abbrechen" Command="{Binding LoeschenAbbrechenCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Erklaerung statt blossem "geht nicht": was genau haengt, und
             die beiden Wege daran vorbei. Archivieren steht zuerst und
             ist der empfohlene. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding LoeschHindernisAktiv}"
                Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding LoeschHindernisText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Archivieren (empfohlen)"
                            Command="{Binding HindernisArchivierenCommand}" />
                    <Button Content="Zusammenführen…"
                            Command="{Binding ZusammenfuehrenStartenCommand}"
                            IsEnabled="{Binding ZusammenfuehrenMoeglich}"
                            ToolTip.Tip="Alle Ausgaben und Vorlagen in eine andere Kategorie umhängen und diese hier löschen." />
                    <Button Content="Abbrechen" Command="{Binding LoeschenAbbrechenCommand}" />
                </StackPanel>
                <TextBlock Classes="klein" Foreground="Gray" TextWrapping="Wrap"
                           IsVisible="{Binding !ZusammenfuehrenMoeglich}"
                           Text="Zusammenführen geht nur ohne Unterkategorien — die müssen zuerst einzeln behandelt werden." />
            </StackPanel>
        </Border>

        <!-- Zusammenfuehren: Zielwahl, Vorschau, Bestaetigung. Die
             Zielwahl benutzt denselben Baum im Aufklappfenster wie die
             Kategorie-Auswahl der Ausgabenliste; waehlbar sind hier aber
             nur Blattknoten. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ZusammenfuehrenAktiv}"
                Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ZusammenfuehrenTitel}" Classes="ueberschrift" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ziel:" VerticalAlignment="Center" />
                    <Button x:Name="ZielAuswahl"
                            Content="{Binding ZielText}"
                            Width="{anzeige:Breite 300}"
                            HorizontalContentAlignment="Left">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ScrollViewer MaxHeight="{anzeige:Breite 360}">
                                    <TreeView Width="{anzeige:Breite 320}"
                                              ItemsSource="{Binding ZielWurzeln}">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:KategorieZielKnoten"
                                                              ItemsSource="{Binding Children}">
                                                <!-- Gewaehlt wird ueber den Knoten-Button und
                                                     NICHT ueber TreeView.SelectedItem: beim
                                                     Schliessen des Aufklappfensters gibt der
                                                     TreeView seine Auswahl her und wuerde das
                                                     Ziel sofort wieder leeren (dieselbe
                                                     Eigenheit wie in AusgabenlisteView). -->
                                                <Button Classes="kategoriewahl"
                                                        IsEnabled="{Binding IstWaehlbar}"
                                                        Command="{Binding #Wurzel.((vm:KategorienViewModel)DataContext).ZielWaehlenCommand}"
                                                        CommandParameter="{Binding}"
                                                        Click="ZielFlyout_Schliessen">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes.archiviert="{Binding IstArchiviert}" />
                                                </Button>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding ZusammenfuehrenVorschauText}"
                           IsVisible="{Binding ZusammenfuehrenBereit}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding ZusammenfuehrenFehler}"
                           IsVisible="{Binding ZusammenfuehrenFehlerSichtbar}"
                           Classes="fehler" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Zusammenführen"
                            Command="{Binding ZusammenfuehrenBestaetigenCommand}"
                            IsEnabled="{Binding ZusammenfuehrenBereit}" />
                    <Button Content="Abbrechen" Command="{Binding ZusammenfuehrenAbbrechenCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TreeView x:Name="Baum"
                  ItemsSource="{Binding Wurzelknoten}"
                  SelectedItem="{Binding AusgewaehlterKnoten}"
                  KeyDown="Baum_KeyDown">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:KategorieKnoten" ItemsSource="{Binding Children}">
                    <Panel>
                        <!-- Farbpunkt vor dem Namen: er zeigt die geltende
                             Farbe (eigene oder geerbte) und ergaenzt den
                             Namen, der unveraendert daneben steht. -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding !WirdBearbeitet}">
                            <Border Classes="farbpunkt"
                                    Background="{Binding Farbe}"
                                    ToolTip.Tip="{Binding FarbHinweis}" />
                            <TextBlock Text="{Binding Anzeigename}"
                                       Classes.archiviert="{Binding IsArchived}"
                                       DoubleTapped="Knoten_DoubleTapped"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding WirdBearbeitet}" Spacing="2">
                            <TextBox Text="{Binding BearbeitungsText}"
                                     MinWidth="{anzeige:Breite 160}"
                                     KeyDown="BearbeitungsTextBox_KeyDown"
                                     LostFocus="BearbeitungsTextBox_LostFocus" />
                            <TextBlock Text="{Binding BearbeitungsFehler}"
                                       IsVisible="{Binding BearbeitungsFehlerSichtbar}"
                                       Classes="fehler" />
                        </StackPanel>
                    </Panel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
