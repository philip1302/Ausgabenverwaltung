<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ausgabenverwaltung.ViewModels"
        xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Ausgabenverwaltung.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Wurzel"
        Icon="/Assets/AppIcon.ico"
        Title="Ausgabenverwaltung">

    <!-- ============ Vorlage eines Navigationseintrags ============
         Gemeinsam fuer alle vier Sidebar-Abschnitte (UI/UX-Redesign,
         Abschnitt 3): Icon + Label, nie Icon allein (Barrierefreiheit-
         Checkliste), 3px-Aktivbalken links, dezente Akzentflaeche.
         Ein (nicht interaktiver) Button statt ListBoxItem, damit sich
         Gruppen, Einrueckung und Badge frei zusammenbauen lassen -
         Tastaturbedienbarkeit bleibt ueber die native Button-Semantik
         erhalten. -->
    <Window.Resources>
        <DataTemplate x:Key="NavEintragVorlage" x:DataType="vm:NavigationItem">
            <Grid ColumnDefinitions="3,*" Margin="0,1">
                <Border Grid.Column="0" Classes="nav-aktiv-balken" IsVisible="{Binding IstAktiv}" />
                <Button Grid.Column="1" Classes="nav-item" Classes.aktiv="{Binding IstAktiv}"
                        Margin="4,0,0,0"
                        Command="{Binding #Wurzel.((vm:MainViewModel)DataContext).WaehleCommand}"
                        CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Classes="nav-icon"
                              Data="{Binding IconKey, Converter={x:Static anzeige:IconSchluesselZuGeometrie.Instanz}}"
                              Width="{anzeige:Breite 18}" Height="{anzeige:Breite 18}"
                              Stretch="Uniform" StrokeThickness="1.75"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Classes="badge neutral" IsVisible="{Binding BadgeSichtbar}"
                                Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeAnzahl}" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ============ Die eine app-weite Hinweiszone ============
             Bleibt oben andockbar ueber der ganzen App, unabhaengig vom
             gewaehlten Bereich (UI/UX-Redesign, Abschnitt 4).

             Frueher standen hier DREI eigene Baender untereinander -
             Aktualisierung, Sicherungsfehler und erzeugte wiederkehrende
             Buchungen. Alle drei zugleich schoben den Inhalt um ein
             Vielfaches ihrer eigenen Hoehe nach unten, und keines war
             dadurch wichtiger als das andere. Jetzt gibt es eine Zone, die
             hoechstens EIN Band zeigt; welches, entscheidet der Rang
             (Core.Errors.Bandauswahl), die uebrigen lassen sich
             durchblaettern.

             Aufbau: Icon | Titel + eine Zeile | Aktionen | Kreuz. Der
             lange Text steht nicht hier, sondern hinter "Details" - die
             Begruendung dazu bei Core.Errors.Bandmeldung. -->
        <Border DockPanel.Dock="Top"
                Classes="banner"
                Classes.hinweis="{Binding Baender.IstHinweis}"
                Classes.erfolg="{Binding Baender.IstErfolg}"
                Classes.warnung="{Binding Baender.IstWarnung}"
                Classes.fehler="{Binding Baender.IstFehler}"
                CornerRadius="0"
                BorderThickness="0,0,0,1"
                Padding="20,12"
                IsVisible="{Binding Baender.Sichtbar}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Vier Zeichen, je eines je Rang - sichtbar ist immer
                     genau das des gezeigten Bandes. Farbe allein traegt
                     die Bedeutung nicht (Regel 10). -->
                <Panel Grid.Column="0" Margin="0,1,12,0" VerticalAlignment="Top">
                    <Path Classes="bandicon" Data="{DynamicResource IconBandHinweis}"
                          Width="{anzeige:Breite 20}" Height="{anzeige:Breite 20}"
                          IsVisible="{Binding Baender.IstHinweis}" />
                    <Path Classes="bandicon" Data="{DynamicResource IconBandErfolg}"
                          Width="{anzeige:Breite 20}" Height="{anzeige:Breite 20}"
                          IsVisible="{Binding Baender.IstErfolg}" />
                    <Path Classes="bandicon" Data="{DynamicResource IconBandWarnung}"
                          Width="{anzeige:Breite 20}" Height="{anzeige:Breite 20}"
                          IsVisible="{Binding Baender.IstWarnung}" />
                    <Path Classes="bandicon" Data="{DynamicResource IconBandFehler}"
                          Width="{anzeige:Breite 20}" Height="{anzeige:Breite 20}"
                          IsVisible="{Binding Baender.IstFehler}" />
                </Panel>

                <!-- Gedeckelte Breite: ohne sie liefe die Zeile auf einem
                     breiten Bildschirm ueber die ganze Fensterbreite, und
                     eine 1800 Pixel lange Zeile liest niemand. -->
                <StackPanel Grid.Column="1" Spacing="2"
                            MaxWidth="{anzeige:Breite 760}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Classes="bandtitel" Text="{Binding Baender.Titel}" />
                    <TextBlock Classes="bandzeile" Text="{Binding Baender.Kurz}" />
                </StackPanel>

                <!-- Genau EIN hervorgehobener Knopf (primary). "Details"
                     tritt dahinter zurueck, "Weiter" erscheint nur, wenn
                     ueberhaupt mehr als eine Meldung ansteht. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Classes="bandzaehler"
                               Text="{Binding Baender.Zaehltext}"
                               IsVisible="{Binding Baender.MehrereVorhanden}" />
                    <Button Classes="ghost" Content="Weiter"
                            IsVisible="{Binding Baender.MehrereVorhanden}"
                            ToolTip.Tip="Zeigt den nächsten anstehenden Hinweis."
                            Command="{Binding Baender.WeiterCommand}" />
                    <Button Classes="secondary" Content="Details"
                            IsVisible="{Binding Baender.DetailsVorhanden}"
                            ToolTip.Tip="Zeigt den vollständigen Text zu diesem Hinweis."
                            Command="{Binding Baender.DetailsCommand}" />
                    <Button Classes="primary"
                            Content="{Binding Baender.AktionText}"
                            IsVisible="{Binding Baender.AktionVorhanden}"
                            ToolTip.Tip="{Binding Baender.AktionTipp}"
                            Command="{Binding Baender.AusfuehrenCommand}" />
                    <Button Classes="bandschliessen"
                            ToolTip.Tip="Blendet diesen Hinweis aus. Stehen weitere an, rückt der nächste nach."
                            Command="{Binding Baender.SchliessenCommand}">
                        <Path Data="{DynamicResource IconSchliessen}"
                              Width="{anzeige:Breite 14}" Height="{anzeige:Breite 14}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Sidebar + Inhalt ============
             Im Panel, damit Toast und Detailauflage DARUEBER liegen statt
             im Fluss: beide sollen nichts verschieben. -->
        <Panel>
        <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Classes="sidebar"
                    Width="{anzeige:Breite 240}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <!-- Grid mit drei Zeilen statt eines DockPanel: Marke fest oben,
                     Fusszeile fest unten, die Navigation dazwischen als
                     einzige sternbemessene (elastische) Zeile - eindeutig
                     und ohne die Mehrdeutigkeit "welches Kind ist das
                     fuellende Kind" eines DockPanel. -->
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Marke -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Margin="4,0,4,20">
                        <Border Classes="marken-icon" Width="{anzeige:Breite 28}" Height="{anzeige:Breite 28}">
                            <TextBlock Classes="marken-buchstabe" Text="A" />
                        </Border>
                        <TextBlock Classes="marke" Text="Ausgabenverwaltung"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="0,0,0,8">
                            <!-- Startseite: ohne Kopfzeile, direkt ueber den Gruppen -->
                            <ContentControl Content="{Binding StartseiteEintrag}"
                                            ContentTemplate="{StaticResource NavEintragVorlage}" />

                            <TextBlock Classes="nav-gruppe" Text="ERFASSEN &amp; VERWALTEN" Margin="8,16,8,4" />
                            <ItemsControl ItemsSource="{Binding ErfassenUndVerwaltenEintraege}"
                                          ItemTemplate="{StaticResource NavEintragVorlage}" />

                            <TextBlock Classes="nav-gruppe" Text="AUSWERTUNG" Margin="8,16,8,4" />
                            <ItemsControl ItemsSource="{Binding AuswertungEintraege}"
                                          ItemTemplate="{StaticResource NavEintragVorlage}" />

                            <TextBlock Classes="nav-gruppe" Text="EINSTELLUNGEN" Margin="8,16,8,4" />

                            <!-- "Verwaltung": statischer Gruppenkopf mit
                                 Zahnrad-Icon (UI/UX-Redesign, Abschnitt 3) -
                                 die echten Sprungziele stehen darunter,
                                 eingerueckt. Wiederkehrende Ausgaben und
                                 Darstellung sind seit dem Reiter-Umbau kein
                                 Unterpunkt hier mehr (siehe oben bzw. die
                                 Fusszeile). -->
                            <Grid ColumnDefinitions="Auto,*" Margin="8,4,8,2">
                                <Path Grid.Column="0" Data="{DynamicResource IconVerwaltung}"
                                      Width="{anzeige:Breite 18}" Height="{anzeige:Breite 18}"
                                      Stretch="Uniform" StrokeThickness="1.75"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Verwaltung" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EinstellungenEintraege}"
                                          ItemTemplate="{StaticResource NavEintragVorlage}"
                                          Margin="20,0,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Fusszeile: Thema und Schriftstufe auf einen Blick,
                         jetzt zugleich der einzige Zugang zu "Darstellung"
                         (seit dem Reiter-Umbau kein eigener Menuepunkt mehr) -
                         ein Klick wechselt wie jeder andere Bereichswechsel
                         den normalen Anzeigebereich rechts (UI/UX-Redesign,
                         Abschnitt 3). -->
                    <StackPanel Grid.Row="2">
                    <!-- Der ruhige Dauerplatz einer verfuegbaren Fassung.
                         Er ist der Grund, warum "Später" am Band wirklich
                         spaeter heissen darf: das Band kommt fuer diese
                         Fassung nicht wieder, die Auskunft bleibt
                         trotzdem erreichbar. Ohne ihn stuende die Wahl
                         zwischen Nerven und Vergessen. -->
                    <Button Classes="sidebar-fusszeile"
                            Height="{anzeige:Breite 36}"
                            BorderThickness="0,1,0,0" Padding="8,0" Margin="0,8,0,0"
                            IsVisible="{Binding Aktualisierung.FusszeileSichtbar}"
                            ToolTip.Tip="Zeigt den Hinweis zur neuen Fassung wieder an."
                            Command="{Binding Aktualisierung.BandWiederZeigenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconPfeilHoch}"
                                  Width="{anzeige:Breite 14}" Height="{anzeige:Breite 14}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource HinweisText}" />
                            <TextBlock Classes="klein" Foreground="{DynamicResource HinweisText}"
                                       Text="{Binding Aktualisierung.FusszeilenText}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="sidebar-fusszeile"
                            Height="{anzeige:Breite 44}"
                            BorderThickness="0,1,0,0" Padding="8,0" Margin="0,8,0,0"
                            Command="{Binding OeffneDarstellungCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconDarstellung}"
                                  Width="{anzeige:Breite 14}" Height="{anzeige:Breite 14}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}" />
                            <TextBlock Classes="klein" Foreground="{DynamicResource TextTertiaerFarbe}"
                                       Text="{Binding Darstellung.FusszeilenText}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                             Background="{DynamicResource CanvasFarbe}"
                             Content="{Binding SelectedNavigationItem.ViewModel}" />
        </Grid>

        <!-- ============ Toast ============
             Die kurzen Bestaetigungen ("Gespeichert.") - unten rechts,
             ueber dem Inhalt, selbstloeschend. Sie verschieben nichts:
             genau das war der Fehler ihrer frueheren Form als Band im
             Formular. -->
        <Border Classes="toast" IsVisible="{Binding Toast.Sichtbar}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{DynamicResource IconBandErfolg}"
                      Width="{anzeige:Breite 18}" Height="{anzeige:Breite 18}"
                      Stretch="Uniform" StrokeThickness="1.75"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Stroke="{DynamicResource ErfolgText}"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding Toast.Text}" VerticalAlignment="Center" />
                <Button Classes="ghost klein"
                        Content="{Binding Toast.AktionText}"
                        IsVisible="{Binding Toast.AktionVorhanden}"
                        Command="{Binding Toast.AusfuehrenCommand}" />
                <Button Classes="bandschliessen" Padding="4"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Blendet die Bestätigung aus."
                        Command="{Binding Toast.SchliessenCommand}">
                    <Path Data="{DynamicResource IconSchliessen}"
                          Width="{anzeige:Breite 12}" Height="{anzeige:Breite 12}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Der lange Text eines Bandes ============
             Kein eigenes Fenster, sondern eine Auflage wie ueberall sonst
             in dieser Anwendung (Vorlagen, Auswertung, Ausgabenliste). Sie
             traegt das, was frueher im Band selbst stand: die Erklaerung,
             die Aussage ueber die Daten und - beim Aktualisieren von Hand -
             die nummerierte Anleitung. -->
        <Panel IsVisible="{Binding Baender.DetailsAktiv}" Background="#60000000">
            <Border Background="{DynamicResource SurfaceRaisedFarbe}"
                    BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Margin="24"
                    MaxWidth="{anzeige:Breite 680}"
                    VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Baender.DetailsTitel}"
                               Classes="ueberschrift"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Button DockPanel.Dock="Bottom" Classes="primary"
                            Content="Schließen"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"
                            Command="{Binding Baender.DetailsSchliessenCommand}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Baender.DetailsText}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
        </Panel>
    </DockPanel>
</Window>
