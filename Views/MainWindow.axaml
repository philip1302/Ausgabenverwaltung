<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ausgabenverwaltung.ViewModels"
        xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Ausgabenverwaltung.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Ausgabenverwaltung">

    <DockPanel>
        <!-- Gescheiterte Sicherung beim Start: melden, aber nicht
             aufhalten. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding StartupNotice.BackupErrorVisible}"
                Background="#FFE0E0"
                BorderBrush="#D08080"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StartupNotice.BackupErrorText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Schliessen"
                        Command="{Binding StartupNotice.DismissBackupErrorCommand}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding StartupNotice.IsVisible}"
                Background="#FFF4CE"
                BorderBrush="#E0C36A"
                BorderThickness="0,0,0,1"
                Padding="12">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StartupNotice.SummaryText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Schliessen"
                            Command="{Binding StartupNotice.DismissCommand}" />
                </Grid>
                <Expander Header="Details anzeigen"
                          Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding StartupNotice.GeneratedExpenseDescriptions}" />
                </Expander>
            </StackPanel>
        </Border>

        <!-- Die Bereichsleiste richtet sich nach ihrem laengsten Eintrag
             statt nach einer festen Breite: so waechst sie mit der
             eingestellten Schriftgroesse genau so weit mit, wie der Text
             es braucht, und nimmt den Bereichen daneben bei "Sehr groß"
             nicht mehrere hundert Pixel weg. -->
        <Grid anzeige:Raster.Spalten="Auto,*">
            <ListBox Grid.Column="0"
                     MinWidth="{anzeige:Breite 160}"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavigationItem">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1"
                             Margin="16"
                             Content="{Binding SelectedNavigationItem.ViewModel}" />
        </Grid>
    </DockPanel>
</Window>
