<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.ReportView"
             x:Name="Wurzel"
             x:DataType="vm:ReportViewModel">

    <!-- Spaltenbreiten der Kreuztabelle: Kategorie 300, jeder
         Zeitabschnitt 125, Summe 145, Durchschnitt je Zeitabschnitt 145.
         Die drei Wertspalten sind je 15 Pixel breiter als frueher
         (110/130): seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz.
         Feste Breiten statt eines Grids,
         weil die Anzahl der Spalten erst zur Laufzeit feststeht - Kopf-
         und Wertzeilen bauen sich aus denselben Breiten auf und stehen
         dadurch exakt uebereinander. Die Tabellen-Styles
         (TextBlock.tabellenkopf, .zahl, .archiviert) kommen aus
         App.axaml.

         Alle festen Breiten stehen als {anzeige:Breite ...} da: die
         Werte gelten fuer die Stufe "Normal" und wachsen mit der
         eingestellten Schriftgroesse mit. Kopf- und Wertzeilen benutzen
         dieselben Werte und bleiben deshalb auf jeder Stufe buendig. -->
    <UserControl.Styles>
        <!-- Eine Zelle sieht wie ein Text aus, ist aber die Schaltflaeche,
             die die Einzelbuchungen oeffnet. Padding 0 wie bei den
             Spaltenkoepfen (siehe App.axaml), sonst enden die
             rechtsbuendigen Werte nicht exakt unter ihrer Ueberschrift. -->
        <Style Selector="Button.zelle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.zelle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDezentFlaeche}" />
        </Style>
        <!-- Leere Zellen sind nicht anklickbar und treten zurueck. -->
        <Style Selector="Button.zelle:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaerFarbe}" />
        </Style>

        <!-- Aufklapp-Pfeil vor dem Kategorienamen. -->
        <Style Selector="Button.aufklapp">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{anzeige:Breite 20}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSekundaerFarbe}" />
        </Style>

        <!-- Die Kategoriespalte bleibt beim waagerechten Schieben stehen.
             Sie liegt weiter in derselben Zeile wie die Werte und wird
             nur um die Bildlaufposition zurueckgeschoben - um eine
             gemeinsame Verschiebung fuer alle Zeilen, die
             ReportView.SpaltenVersatz fuehrt. Deshalb:
             - ZIndex 1, damit sie ueber den Werten liegt, die unter ihr
               wegwandern,
             - ein deckender Hintergrund in der Flaechenfarbe des
               Inhaltsbereichs, sonst schaeben die Werte durch,
             - eine Trennlinie rechts, die erst beim Schieben sichtbar
               wird. Ihre Breite steht immer, auch unsichtbar, sonst
               ruckte die Tabelle beim ersten Schieben um ein Pixel. -->
        <Style Selector="Border.fixspalte">
            <Setter Property="ZIndex" Value="1" />
            <Setter Property="Width" Value="{anzeige:Breite 300}" />
            <Setter Property="Background" Value="{DynamicResource CanvasFarbe}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="Border.fixspalte.verschoben">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDezentFarbe}" />
        </Style>

        <Style Selector="TextBlock.filterbeschriftung">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaerFarbe}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

    </UserControl.Styles>

    <Panel Margin="32,24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="seitentitel" Text="Report" Margin="0,0,0,20" />

            <!-- ============ Filterleiste ============
                 Eigene Karte statt einer reinen Trennlinie (UI/UX-Redesign,
                 Abschnitt 2.7) - grenzt den Filterbereich klarer vom
                 Inhalt ab. -->
            <Border DockPanel.Dock="Top" Classes="filterleiste" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <!-- Zeitraum

                         Jede Spalte ist ein Raster "Beschriftung, Rest"
                         statt eines StackPanel: in einem waagerechten
                         StackPanel dehnen sich die Kinder auf die Hoehe des
                         hoechsten: hier also auf die der Schnellwahl-Zeile.
                         Die Sternzeile gibt diese Hoehe an das Eingabefeld
                         weiter, das damit exakt so hoch wird wie die
                         Schaltflaechen daneben. Ein StackPanel gaebe jedem
                         Kind nur seine Wunschhoehe, und eine fest
                         eingetragene Hoehe waere bei grosser Schrift wieder
                         falsch (Regel 9). -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Von" Classes="filterbeschriftung" />
                            <TextBox Grid.Row="1" Text="{Binding VonText}"
                                     Width="{anzeige:Breite 110}"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </Grid>
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Bis" Classes="filterbeschriftung" />
                            <TextBox Grid.Row="1" Text="{Binding BisText}"
                                     Width="{anzeige:Breite 110}"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </Grid>

                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Schnellwahl" Classes="filterbeschriftung" />
                            <!-- Echte Button-Gruppe mit sichtbarem aktivem Zustand
                                 (UI/UX-Redesign, Abschnitt 5.3) statt gewoehnlicher,
                                 nicht unterscheidbarer Buttons. -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="secondary" Content="Dieses Jahr"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=DiesesJahr}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="DiesesJahr" />
                                <Button Classes="secondary" Content="Letztes Jahr"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=LetztesJahr}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="LetztesJahr" />
                                <Button Classes="secondary" Content="Letzte 12 Monate"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=Letzte12Monate}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Letzte12Monate" />
                                <Button Classes="secondary" Content="Letzte 3 Jahre"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=Letzte3Jahre}"
                                        ToolTip.Tip="Die letzten drei Kalenderjahre einschließlich des laufenden"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Letzte3Jahre" />
                                <Button Classes="secondary" Content="Alles"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=Alles}"
                                        ToolTip.Tip="Ohne zeitliche Einschränkung"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Alles" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding ZeitraumFehler}"
                                   IsVisible="{Binding ZeitraumFehlerSichtbar}"
                                   Classes="fehler"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </StackPanel>

                    <!-- Kategorie, Gruppierung, Zahler, Status, Sicht, Suche -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Kategorien" Classes="filterbeschriftung" />
                            <Button x:Name="KategorieAuswahl"
                                    Content="{Binding KategorieFilterText}"
                                    Width="{anzeige:Breite 260}"
                                    HorizontalContentAlignment="Left">
                                <Button.Flyout>
                                    <!-- Haekchen statt Auswahl, Flyout bleibt offen -
                                         siehe AusgabenlisteView. -->
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="{anzeige:Breite 320}" Spacing="6">
                                            <Button Content="Alle Kategorien"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip.Tip="Hebt alle Häkchen auf — ohne Auswahl zählen alle Kategorien."
                                                    Command="{Binding AlleKategorienCommand}" />
                                            <TreeView MaxHeight="{anzeige:Breite 320}"
                                                      ItemsSource="{Binding KategorieWurzeln}">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate x:DataType="vm:KategorieFilterKnoten"
                                                                      ItemsSource="{Binding Children}">
                                                        <CheckBox IsChecked="{Binding IstGewaehlt, Mode=TwoWay}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Classes.archiviert="{Binding IsArchived}" />
                                                        </CheckBox>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Zeitgruppierung" Classes="filterbeschriftung" />
                            <ComboBox ItemsSource="{Binding GruppierungOptionen}"
                                      SelectedItem="{Binding AusgewaehlteGruppierung}"
                                      Width="{anzeige:Breite 130}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GruppierungOption">
                                        <TextBlock Text="{Binding Bezeichnung}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Zahler" Classes="filterbeschriftung" />
                            <Button Content="{Binding ZahlerFilterText}"
                                    Width="{anzeige:Breite 180}"
                                    HorizontalContentAlignment="Left">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="{anzeige:Breite 240}" Spacing="6">
                                            <Button Content="Alle Zahler"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip.Tip="Hebt alle Häkchen auf — ohne Auswahl zählen alle Zahler."
                                                    Command="{Binding AlleZahlerCommand}" />
                                            <ScrollViewer MaxHeight="{anzeige:Breite 260}">
                                                <ItemsControl ItemsSource="{Binding ZahlerOptionen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ZahlerOption">
                                                            <CheckBox IsChecked="{Binding IstGewaehlt, Mode=TwoWay}"
                                                                      Content="{Binding Bezeichnung}"
                                                                      Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel>
                            <!-- Zwei unabhaengige Haekchen - siehe AusgabenlisteView. -->
                            <TextBlock Text="Status" Classes="filterbeschriftung" />
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <CheckBox Content="offen"
                                          IsChecked="{Binding StatusOffen, Mode=TwoWay}" />
                                <CheckBox Content="beglichen"
                                          IsChecked="{Binding StatusBeglichen, Mode=TwoWay}"
                                          ToolTip.Tip="Beide Häkchen zusammen lassen eigene Ausgaben heraus — die haben keinen Status. Ohne Häkchen sind alle Buchungen dabei." />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Sicht" Classes="filterbeschriftung" />
                            <CheckBox Content="Meine Kosten"
                                      IsChecked="{Binding MeineKosten, Mode=TwoWay}"
                                      ToolTip.Tip="Eigene Buchungen, alle noch nicht beglichenen Ausgaben anderer sowie alle bereits beglichenen Einnahmen von anderen im Zeitraum — was ich getragen habe und noch auf mich zukommt." />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Suche" Classes="filterbeschriftung" />
                            <!-- Dieselbe Suche wie in der Ausgabenliste -
                                 beide bauen denselben Filter, also muss
                                 hier auch dasselbe angeschrieben stehen. -->
                            <TextBox Text="{Binding Suchtext}"
                                     Width="{anzeige:Breite 200}"
                                     ToolTip.Tip="Durchsucht Bemerkung, Kategorie und Zahler. Bei der Kategorie zählt der ganze Pfad: „Wohnen“ findet auch „Wohnen › Nebenkosten › Strom“."
                                     PlaceholderText="Bemerkung, Kategorie, Zahler…" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Werkzeugleiste ============
                 "Filter zurücksetzen" steht hier statt in der Filterleiste
                 selbst: es gehoert zur ganzen Leiste, nicht zu einem
                 einzelnen Feld darin, und stuende zwischen den Filtern wie
                 ein weiterer Filter da. Auf derselben Linie wie der
                 CSV-Export, aber links davon - ein Knopf, der die Anzeige
                 aendert, gehoert nicht neben einen, der eine Datei
                 schreibt. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Kategorien ohne Ausgaben anzeigen"
                              IsChecked="{Binding KategorienOhneAusgabenAnzeigen}" />
                    <Button Classes="ghost" Content="Filter zurücksetzen"
                            Command="{Binding FilterZuruecksetzenCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding ExportHinweis}"
                               IsVisible="{Binding ExportHinweis, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource TextTertiaerFarbe}"
                               VerticalAlignment="Center" />
                    <Button Classes="secondary" Content="Als CSV exportieren"
                            ToolTip.Tip="Die angezeigte Tabelle mit der aufgeklappten Struktur"
                            Click="CsvExportieren_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Fusszeile ============ -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding TrefferText}"
                       Foreground="{DynamicResource TextTertiaerFarbe}"
                       Margin="4,10,0,0" />

            <!-- Leerer Zustand: Icon + Text statt des bisherigen grauen,
                 kursiven Einzeilers (UI/UX-Redesign, Abschnitt 2.7). -->
            <StackPanel DockPanel.Dock="Top" Spacing="8" HorizontalAlignment="Center"
                        IsVisible="{Binding KeineTreffer}" Margin="0,32">
                <Path Data="{DynamicResource IconReport}"
                      Width="{anzeige:Breite 40}" Height="{anzeige:Breite 40}"
                      Stretch="Uniform" StrokeThickness="1.5"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}"
                      HorizontalAlignment="Center" />
                <TextBlock Text="Keine Ausgaben für diesen Filter."
                           Foreground="{DynamicResource TextSekundaerFarbe}" />
            </StackPanel>

            <!-- ============ Kreuztabelle ============
                 Zwei ineinander liegende ScrollViewer: der aeussere
                 schiebt die Spalten waagerecht, der innere die Zeilen
                 senkrecht. Dadurch bleibt die Kopfzeile beim Blaettern
                 stehen und wandert beim waagerechten Schieben mit den
                 Spalten mit - ohne dass zwei Bildlaufpositionen von Hand
                 gleichgehalten werden muessen. -->
            <ScrollViewer x:Name="Kreuztabelle"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <DockPanel>
                    <!-- Kopfzeile -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="fixspalte"
                                    Classes.verschoben="{Binding #Wurzel.SpalteVerschoben}"
                                    RenderTransform="{Binding #Wurzel.SpaltenVersatz}">
                                <TextBlock Text="Kategorie" Classes="tabellenkopf" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Spalten}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReportSpalte">
                                        <TextBlock Text="{Binding Beschriftung}"
                                                   Classes="tabellenkopf zahl"
                                                   Width="{anzeige:Breite 125}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Summe" Classes="tabellenkopf zahl" Width="{anzeige:Breite 145}" />
                            <TextBlock Text="Ø je Zeitabschnitt" Classes="tabellenkopf zahl"
                                       Width="{anzeige:Breite 145}"
                                       ToolTip.Tip="Durchschnitt je angezeigtem Zeitabschnitt über den gesamten ausgewählten Zeitraum" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Kategoriezeilen. Bewusst ItemsControl statt
                                 ListBox: die Zeilenzahl entspricht der Zahl
                                 der Kategorien, nicht der Buchungen - da
                                 lohnt keine Virtualisierung, und jede Zelle
                                 ist eine eigene Schaltflaeche. -->
                            <ItemsControl ItemsSource="{Binding Zeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReportZeile">
                                        <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1"
                                                Padding="0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- DockPanel statt StackPanel, damit der
                                                     Name die Restbreite bekommt und lange
                                                     Bezeichnungen gekuerzt werden. Der Rahmen
                                                     darum haelt die Spalte beim waagerechten
                                                     Schieben an ihrem Platz (Style
                                                     "fixspalte"). -->
                                                <Border Classes="fixspalte"
                                                        Classes.verschoben="{Binding #Wurzel.SpalteVerschoben}"
                                                        RenderTransform="{Binding #Wurzel.SpaltenVersatz}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left"
                                                                Width="{Binding EinzugBreite}" />
                                                        <Button DockPanel.Dock="Left"
                                                                Classes="aufklapp"
                                                                Content="{Binding AufklappZeichen}"
                                                                IsVisible="{Binding HatKinder}"
                                                                Command="{Binding #Wurzel.((vm:ReportViewModel)DataContext).ZeileUmschaltenCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Border DockPanel.Dock="Left" Width="{anzeige:Breite 20}"
                                                                IsVisible="{Binding !HatKinder}" />

                                                        <!-- Farbe der Kategorie, vor dem Namen und
                                                             niemals an seiner Stelle. -->
                                                        <Border DockPanel.Dock="Left"
                                                                Classes="farbpunkt"
                                                                Background="{Binding Farbe}"
                                                                IsVisible="{Binding ZeigtFarbe}"
                                                                Margin="0,0,6,0" />

                                                        <!-- Hier steht nur der Name der Kategorie
                                                             und nicht ihr Pfad - gekuerzt wird
                                                             also hinten. Der Hilfetext erscheint
                                                             nur, wenn wirklich etwas fehlt. -->
                                                        <anzeige:Textzelle Inhalt="{Binding Name}"
                                                                           VerticalAlignment="Center"
                                                                           Classes.archiviert="{Binding IstArchiviert}" />
                                                    </DockPanel>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Zellen}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ReportZelle">
                                                            <Button Classes="zelle" Width="{anzeige:Breite 125}"
                                                                    Classes.einnahme="{Binding IstEinnahme}"
                                                                    Content="{Binding Text}"
                                                                    IsEnabled="{Binding HatWerte}"
                                                                    ToolTip.Tip="{Binding Beschreibung}"
                                                                    Command="{Binding #Wurzel.((vm:ReportViewModel)DataContext).ZelleOeffnenCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Classes="zelle" Width="{anzeige:Breite 145}"
                                                        FontWeight="SemiBold"
                                                        Classes.einnahme="{Binding Summe.IstEinnahme}"
                                                        Content="{Binding Summe.Text}"
                                                        IsEnabled="{Binding Summe.HatWerte}"
                                                        ToolTip.Tip="{Binding Summe.Beschreibung}"
                                                        Command="{Binding #Wurzel.((vm:ReportViewModel)DataContext).ZelleOeffnenCommand}"
                                                        CommandParameter="{Binding Summe}" />

                                                <!-- Kein Button wie die uebrigen Zellen: der
                                                     Durchschnitt ist eine Rechnung ueber die
                                                     Summe, kein eigener Ausschnitt der
                                                     Buchungen, den ein Klick oeffnen koennte. -->
                                                <TextBlock Classes="tabellenzelle zahl" Width="{anzeige:Breite 145}"
                                                           FontWeight="SemiBold"
                                                           Classes.einnahme="{Binding DurchschnittIstEinnahme}"
                                                           Text="{Binding DurchschnittText}"
                                                           ToolTip.Tip="Durchschnitt je angezeigtem Zeitabschnitt über den gesamten ausgewählten Zeitraum" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Summenzeile. Eigener Aufbau statt derselben
                                 Vorlage: sie braucht weder Einrueckung noch
                                 Aufklapp-Pfeil, dafuer eine kraeftigere
                                 Abgrenzung nach oben. Als ContentControl,
                                 damit sie ohne Auswertung schlicht
                                 wegbleibt (Content = NULL). -->
                            <ContentControl Content="{Binding SummenZeile}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ReportZeile">
                                        <Border BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="0,1,0,0"
                                                Padding="0,6,0,0" Margin="0,2,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Classes="fixspalte"
                                                        Classes.verschoben="{Binding #Wurzel.SpalteVerschoben}"
                                                        RenderTransform="{Binding #Wurzel.SpaltenVersatz}">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Zellen}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ReportZelle">
                                                            <Button Classes="zelle" Width="{anzeige:Breite 125}"
                                                                    FontWeight="Bold"
                                                                    Classes.einnahme="{Binding IstEinnahme}"
                                                                    Content="{Binding Text}"
                                                                    IsEnabled="{Binding HatWerte}"
                                                                    ToolTip.Tip="{Binding Beschreibung}"
                                                                    Command="{Binding #Wurzel.((vm:ReportViewModel)DataContext).ZelleOeffnenCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Classes="zelle" Width="{anzeige:Breite 145}"
                                                        FontWeight="Bold"
                                                        Classes.einnahme="{Binding Summe.IstEinnahme}"
                                                        Content="{Binding Summe.Text}"
                                                        IsEnabled="{Binding Summe.HatWerte}"
                                                        ToolTip.Tip="{Binding Summe.Beschreibung}"
                                                        Command="{Binding #Wurzel.((vm:ReportViewModel)DataContext).ZelleOeffnenCommand}"
                                                        CommandParameter="{Binding Summe}" />
                                                <TextBlock Classes="tabellenzelle zahl" Width="{anzeige:Breite 145}"
                                                           FontWeight="Bold"
                                                           Classes.einnahme="{Binding DurchschnittIstEinnahme}"
                                                           Text="{Binding DurchschnittText}"
                                                           ToolTip.Tip="Durchschnitt je angezeigtem Zeitabschnitt über den gesamten ausgewählten Zeitraum" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Overlay: Einzelbuchungen einer Zelle ============
             Dialog statt Sprung in die Ausgabenliste: nur so gilt hier
             derselbe Filter wie in der Auswertung (siehe
             ReportViewModel.ZelleOeffnen). -->
        <Panel IsVisible="{Binding DetailsAktiv}" Background="#60000000">
            <!-- Breite und Hoehe ergeben sich aus dem Fenster, gedeckelt
                 auf die gewuenschte Groesse: bei "Sehr groß" waere ein
                 fest 820 Pixel breiter Dialog breiter als der Bereich
                 dahinter und wuerde rechts abgeschnitten. -->
            <Border Background="{DynamicResource SurfaceRaisedFarbe}" BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="24"
                    MaxWidth="{anzeige:Breite 820}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding DetailTitel}"
                               Classes="ueberschrift"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <!-- Fusszeile: Anzahl und Summe stammen aus einer
                         eigenen Aggregatabfrage und muessen mit der
                         angeklickten Zelle uebereinstimmen. -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto"
                          Margin="0,10,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DetailTrefferText}"
                                   Foreground="{DynamicResource TextTertiaerFarbe}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                            <TextBlock FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Classes.einnahme="{Binding DetailSummeIstEinnahme}"
                                       Text="{Binding DetailSummeText, StringFormat='Summe: {0}'}" />
                            <Button Content="Schließen"
                                    Command="{Binding DetailsSchliessenCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Top" anzeige:Raster.Spalten="90,16,2*,16,110,16,110,16,2*"
                          Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Datum" Classes="tabellenkopf" />
                        <TextBlock Grid.Column="2" Text="Kategorie" Classes="tabellenkopf" />
                        <TextBlock Grid.Column="4" Text="Betrag" Classes="tabellenkopf zahl" />
                        <TextBlock Grid.Column="6" Text="Zahler" Classes="tabellenkopf" />
                        <TextBlock Grid.Column="8" Text="Bemerkung" Classes="tabellenkopf" />
                    </Grid>

                    <ListBox ItemsSource="{Binding DetailZeilen}"
                             SelectionMode="Single"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AusgabeZeile">
                                <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <!-- Dieselbe Behandlung wie in der Ausgabenliste:
                                         einzeilig, gekuerzt, Hilfetext nur wo noetig -
                                         die Kategorie vorne, alles uebrige hinten. Die
                                         Kategoriespalte bleibt hier anteilig und ist
                                         nicht zu ziehen: der Dialog hat eine feste
                                         Hoechstbreite, aus der sich alles ergibt. -->
                                    <Grid anzeige:Raster.Spalten="90,16,2*,16,110,16,110,16,2*">
                                        <TextBlock Grid.Column="0" Text="{Binding DatumText}"
                                                   Classes="tabellenzelle" />
                                        <anzeige:Textzelle Grid.Column="2"
                                                           Inhalt="{Binding CategoryFullPath}"
                                                           Kuerzung="Vorne"
                                                           Classes="tabellenzelle" />
                                        <TextBlock Grid.Column="4" Text="{Binding BetragText}"
                                                   Classes="tabellenzelle zahl"
                                                   Classes.offen="{Binding IstOffen}"
                                                   Classes.einnahme="{Binding IstBeglicheneEinnahme}"
                                                   Classes.beglichen-ausgabe="{Binding IstBeglichenAusgabe}" />
                                        <anzeige:Textzelle Grid.Column="6" Inhalt="{Binding PayerName}"
                                                           Classes="tabellenzelle" />
                                        <anzeige:Textzelle Grid.Column="8" Inhalt="{Binding Note}"
                                                           Classes="tabellenzelle" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
