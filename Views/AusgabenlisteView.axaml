<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:categories="using:Ausgabenverwaltung.Core.Categories"
             xmlns:entities="using:Ausgabenverwaltung.Core.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.AusgabenlisteView"
             x:Name="Wurzel"
             x:DataType="vm:AusgabenlisteViewModel">

    <!-- Spaltenraster "4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,300"
         gilt fuer Kopfzeile UND Zeilen gleichermassen: Farbbalken,
         Auswahl, Vorlagen-Marker, Datum, Kategorie, Betrag, Zahler,
         Status, Bemerkung, Aktionen - dazwischen feste Gutter-Spalten als
         Abstandhalter (Indizes 1,5,7,9,11,13,15). Die Tabellen-Styles
         (Button.kopf, TextBlock.tabellenzelle, ...) kommen aus App.axaml.

         Angegeben ueber anzeige:Raster.Spalten und nicht ueber
         ColumnDefinitions: die festen Breiten sind auf Text ausgelegt und
         muessen mit der eingestellten Schriftgroesse mitwachsen, sonst
         wird bei "Sehr groß" abgeschnitten. Kopfzeile und Zeilen rechnen
         mit demselben Faktor und stehen dadurch weiterhin exakt
         uebereinander.

         JEDE Spalte hat eine feste oder anteilige Breite - keine einzige
         richtet sich nach ihrem Inhalt. Nur so bleibt die Gesamtbreite
         konstant und kann ein langer Kategoriepfad die Spalten dahinter
         nicht nach rechts schieben. Die Zellen mit unbegrenzt langem
         Inhalt (Kategorie, Zahler, Bemerkung) sind deshalb
         anzeige:Textzelle: sie verlangen nie mehr Breite, als die Spalte
         ihnen gibt, bleiben einzeilig und kuerzen mit
         Auslassungspunkten - die Kategorie vorne, damit der Name der
         Kategorie selbst vollstaendig lesbar bleibt, alles uebrige hinten.

         "Kategorie" im Muster ist die einzige Breite, die der Benutzer
         selbst bestimmt: am Spaltengriff in der Kopfzeile zu ziehen
         (siehe anzeige:Spaltengriff), gemerkt ueber dieselbe
         Einstellungsdatei wie Schriftgroesse und Sicherungspfad. Was
         sie an Platz bekommt, geht der Bemerkung ab - die ist die
         einzige Sternspalte und faengt jede Aenderung auf.

         Die Statusspalte ist 175 statt der urspruenglichen 120 Pixel
         breit: der laengste Wert ist "beglichen am 29.09.2025" und wurde
         vorher abgeschnitten.

         Die Betragsspalte ist 110 statt der urspruenglichen 90 Pixel
         breit: seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz als vorher "1.234,56".

         Die Aktionsspalte fasst "Bearbeiten", "Duplizieren" und "Löschen"
         nebeneinander; 300 statt der urspruenglichen 150 Pixel, weil die
         Schaltflaechen mit der Theme-Polsterung sonst nicht nebeneinander
         passen und die letzte abgeschnitten wird. Waechst sie weiter,
         gehoert das in ein Kontextmenue statt in noch mehr Breite. -->
    <UserControl.Styles>
        <!-- Die ListBox dient hier nur als virtualisierender Behaelter:
             ausgewaehlt wird ueber die Checkbox-Spalte, weil die Zeilen
             eigene Schaltflaechen enthalten und ein Klick auf die Zeile
             sonst mit der Listenauswahl kollidiert. Deshalb Polsterung
             und Auswahl-Optik entfernen. -->
        <Style Selector="ListBox.tabelle > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tabelle > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tabelle > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CanvasFarbe}" />
        </Style>

        <Style Selector="TextBlock.vorlage">
            <Setter Property="Foreground" Value="{DynamicResource WarnungText}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.filterbeschriftung">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaerFarbe}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Der schmale Farbbalken am linken Zeilenrand: er zeigt die
             Farbe der Kategorie und ergaenzt damit die Kategoriespalte,
             die daneben unveraendert im Klartext steht. -->
        <Style Selector="Border.farbbalken">
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Panel Margin="32,24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="seitentitel" Text="Ausgabenliste" Margin="0,0,0,20" />

            <!-- ============ Filterleiste ============
                 Eigene Karte statt einer reinen Trennlinie (UI/UX-Redesign,
                 Abschnitt 5.4). -->
            <Border DockPanel.Dock="Top" Classes="filterleiste" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <!-- Zeitraum

                         Jede Spalte ist ein Raster "Beschriftung, Rest"
                         statt eines StackPanel: in einem waagerechten
                         StackPanel dehnen sich die Kinder auf die Hoehe des
                         hoechsten: hier also auf die der Schnellwahl-Zeile.
                         Die Sternzeile gibt diese Hoehe an das Eingabefeld
                         weiter, das damit exakt so hoch wird wie die
                         Schaltflaechen daneben. Ein StackPanel gaebe jedem
                         Kind nur seine Wunschhoehe, und eine fest
                         eingetragene Hoehe waere bei grosser Schrift wieder
                         falsch (Regel 9). -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Von" Classes="filterbeschriftung" />
                            <TextBox Grid.Row="1" Text="{Binding VonText}"
                                     Width="{anzeige:Breite 110}"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </Grid>
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Bis" Classes="filterbeschriftung" />
                            <TextBox Grid.Row="1" Text="{Binding BisText}"
                                     Width="{anzeige:Breite 110}"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </Grid>

                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Schnellwahl" Classes="filterbeschriftung" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="secondary" Content="Dieser Monat"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=DieserMonat}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="DieserMonat" />
                                <Button Classes="secondary" Content="Dieses Jahr"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=DiesesJahr}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="DiesesJahr" />
                                <Button Classes="secondary" Content="Letzte 12 Monate"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=Letzte12Monate}"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Letzte12Monate" />
                                <Button Classes="secondary" Content="Alles"
                                        Classes.aktiv="{Binding AktiverZeitraumSchluessel, Converter={x:Static anzeige:TextGleich.Instanz}, ConverterParameter=Alles}"
                                        ToolTip.Tip="Ohne zeitliche Einschränkung"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Alles" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding ZeitraumFehler}"
                                   IsVisible="{Binding ZeitraumFehlerSichtbar}"
                                   Classes="fehler"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </StackPanel>

                    <!-- Kategorie, Zahler, Status, Sicht, Suche -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Kategorien" Classes="filterbeschriftung" />
                            <Button x:Name="KategorieAuswahl"
                                    Content="{Binding KategorieFilterText}"
                                    Width="{anzeige:Breite 260}"
                                    HorizontalContentAlignment="Left">
                                <Button.Flyout>
                                    <!-- Haekchen statt Auswahl: mehrere Aeste sind
                                         gleichzeitig waehlbar, und ein abgewaehltes Kind
                                         unter einem angehakten Elternteil nimmt seinen
                                         Unter-Ast wieder heraus. Das Flyout bleibt beim
                                         Klick bewusst offen - wer mehrere Haekchen setzen
                                         will, soll es nicht je Haekchen neu aufklappen.
                                         Der TreeView liefert nur die Aufklapp-Struktur;
                                         SelectedItem wird nicht gebunden, weil er seine
                                         Auswahl beim Schliessen ohnehin zuruecksetzt. -->
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="{anzeige:Breite 320}" Spacing="6">
                                            <Button Content="Alle Kategorien"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip.Tip="Hebt alle Häkchen auf — ohne Auswahl zählen alle Kategorien."
                                                    Command="{Binding AlleKategorienCommand}" />
                                            <TreeView MaxHeight="{anzeige:Breite 320}"
                                                      ItemsSource="{Binding KategorieWurzeln}">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate x:DataType="vm:KategorieFilterKnoten"
                                                                      ItemsSource="{Binding Children}">
                                                        <CheckBox IsChecked="{Binding IstGewaehlt, Mode=TwoWay}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Classes.archiviert="{Binding IsArchived}" />
                                                        </CheckBox>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Zahler" Classes="filterbeschriftung" />
                            <Button Content="{Binding ZahlerFilterText}"
                                    Width="{anzeige:Breite 180}"
                                    HorizontalContentAlignment="Left">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="{anzeige:Breite 240}" Spacing="6">
                                            <Button Content="Alle Zahler"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    ToolTip.Tip="Hebt alle Häkchen auf — ohne Auswahl zählen alle Zahler."
                                                    Command="{Binding AlleZahlerCommand}" />
                                            <ScrollViewer MaxHeight="{anzeige:Breite 260}">
                                                <ItemsControl ItemsSource="{Binding ZahlerOptionen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ZahlerOption">
                                                            <CheckBox IsChecked="{Binding IstGewaehlt, Mode=TwoWay}"
                                                                      Content="{Binding Bezeichnung}"
                                                                      Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel>
                            <!-- Zwei unabhaengige Haekchen. Beide aus heisst "jeder
                                 Status"; beide an ist NICHT dasselbe, weil eine eigene
                                 Ausgabe nach Regel 4 gar keinen Status hat und dann
                                 herausfaellt - deshalb der Hilfetext. -->
                            <TextBlock Text="Status" Classes="filterbeschriftung" />
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <CheckBox Content="offen"
                                          IsChecked="{Binding StatusOffen, Mode=TwoWay}" />
                                <CheckBox Content="beglichen"
                                          IsChecked="{Binding StatusBeglichen, Mode=TwoWay}"
                                          ToolTip.Tip="Beide Häkchen zusammen lassen eigene Ausgaben heraus — die haben keinen Status. Ohne Häkchen sind alle Buchungen dabei." />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <!-- Zwei unabhaengige Haekchen wie beim Status. Beide
                                 aus heisst "beides"; beide an ebenfalls, weil
                                 eine Buchung nie zugleich Einnahme und Ausgabe
                                 ist. -->
                            <TextBlock Text="Art" Classes="filterbeschriftung" />
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <CheckBox Content="Ausgaben"
                                          IsChecked="{Binding NurAusgaben, Mode=TwoWay}" />
                                <CheckBox Content="Einnahmen"
                                          IsChecked="{Binding NurEinnahmen, Mode=TwoWay}"
                                          ToolTip.Tip="Ohne Häkchen — und ebenso mit beiden — sind Ausgaben und Einnahmen dabei." />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Sicht" Classes="filterbeschriftung" />
                            <CheckBox Content="Meine Kosten"
                                      IsChecked="{Binding MeineKosten, Mode=TwoWay}"
                                      ToolTip.Tip="Eigene Buchungen plus alles, was von anderen noch offen ist — was ich getragen habe und noch auf mich zukommt." />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Suche in der Bemerkung" Classes="filterbeschriftung" />
                            <!-- Ziel von Strg+F (siehe
                                 AusgabenlisteView.axaml.cs). -->
                            <TextBox x:Name="Suchfeld"
                                     Text="{Binding Suchtext}"
                                     Width="{anzeige:Breite 220}"
                                     ToolTip.Tip="Strg + F springt aus jedem Bereich hierher"
                                     PlaceholderText="Volltext…" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Einschraenkung auf eine Vorlage. Sie steht in keinem
                         Bedienelement der Filterleiste, deshalb muss sie hier
                         sichtbar sein - sonst waere unerklaerlich, warum
                         ploetzlich fast alle Buchungen fehlen. -->
                    <Border IsVisible="{Binding VorlageFilterAktiv}"
                            Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                            CornerRadius="8" Padding="8,4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding VorlageFilterText}"
                                       VerticalAlignment="Center" />
                            <Button Content="✕"
                                    ToolTip.Tip="Einschränkung auf die Vorlage aufheben"
                                    Command="{Binding VorlagenFilterEntfernenCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Einschraenkung auf genau eine Buchung - der Sprung aus
                         "Letzte Buchungen". Steht wie der Vorlagenfilter in
                         keinem Bedienelement der Leiste und muss deshalb
                         sichtbar sein: sonst waere unerklaerlich, warum die
                         Liste nur noch eine Zeile zeigt. -->
                    <Border IsVisible="{Binding BuchungFilterAktiv}"
                            Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                            CornerRadius="8" Padding="8,4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding BuchungFilterText}"
                                       VerticalAlignment="Center" />
                            <Button Content="✕"
                                    ToolTip.Tip="Einschränkung auf diese eine Buchung aufheben"
                                    Command="{Binding BuchungFilterAufhebenCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Werkzeugleiste ============
                 "Filter zurücksetzen" steht hier statt in der Filterleiste
                 selbst: es gehoert zur ganzen Leiste, nicht zu einem
                 einzelnen Feld darin, und stuende zwischen den Filtern wie
                 ein weiterer Filter da. Rechts, auf derselben Linie wie die
                 uebrigen Aktionen der Ansicht. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,10">
                <!-- Die Aktionsleiste erscheint erst mit der Auswahl: ohne
                     markierte Zeile hat keiner ihrer Knoepfe einen
                     Gegenstand. Ein WrapPanel, damit die Reihe bei grosser
                     Schriftstufe umbricht statt abzuschneiden (Regel 9). -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal"
                           IsVisible="{Binding HatAuswahl}">
                    <TextBlock Text="{Binding AuswahlText}"
                               Foreground="{DynamicResource TextTertiaerFarbe}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Button Classes="secondary" Content="Kategorie ändern"
                            Margin="0,0,8,4"
                            ToolTip.Tip="Bucht alle markierten Buchungen auf eine andere Kategorie um">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="{anzeige:Breite 320}">
                                    <ItemsControl ItemsSource="{Binding SammelKategorien}"
                                                  Width="{anzeige:Breite 320}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="categories:CategoryOption">
                                                <Button Classes="ghost"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).SammelKategorieSetzenCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!-- Farbe als Zusatz zum Text (Regel 10). -->
                                                        <Border Classes="farbpunkt"
                                                                Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                                                        <TextBlock Text="{Binding FullPath}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="secondary" Content="Zahler ändern"
                            Margin="0,0,8,4"
                            ToolTip.Tip="Bucht alle markierten Buchungen auf einen anderen Zahler um">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ItemsControl ItemsSource="{Binding ZahlerOptionen}"
                                              Width="{anzeige:Breite 220}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ZahlerOption">
                                            <Button Classes="ghost"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{Binding Bezeichnung}"
                                                    Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).SammelZahlerSetzenCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Classes="secondary" Content="Als beglichen markieren"
                            Margin="0,0,8,4"
                            ToolTip.Tip="Trägt das heutige Datum ein. Eigene Ausgaben haben keinen Beglichen-Status und bleiben unverändert."
                            Command="{Binding SammelAlsBeglichenCommand}" />

                    <Button Classes="danger" Content="Löschen"
                            Margin="0,0,0,4"
                            Command="{Binding AusgewaehlteLoeschenCommand}" />
                </WrapPanel>

                <Button Grid.Column="2" Classes="ghost" Content="Filter zurücksetzen"
                        Command="{Binding FilterZuruecksetzenCommand}" />
            </Grid>

            <!-- ============ Bänder über der Tabelle ============
                 Ein Schreibfehler beim Duplizieren steht hier statt in der
                 Lösch-Abfrage: die hat ihr eigenes Band, und ein Fehler
                 ohne offenen Dialog braucht einen Platz, an dem die Liste
                 unverändert darunter stehen bleiben kann (Regel 13). -->
            <Border DockPanel.Dock="Top" Classes="banner fehler"
                    IsVisible="{Binding SchreibFehlerAlsBand}"
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SchreibFehlerText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Content="Schließen"
                            VerticalAlignment="Top"
                            Command="{Binding SchreibFehlerSchliessenCommand}" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Classes="banner erfolg"
                    IsVisible="{Binding ErfolgSichtbar}"
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ErfolgText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Content="Schließen"
                            VerticalAlignment="Top"
                            Command="{Binding ErfolgSchliessenCommand}" />
                </Grid>
            </Border>

            <!-- Rückgängig nach dem Löschen. Es tritt an die Stelle der
                 früheren Sicherheitsabfrage: eine Nachfrage vor jedem
                 Löschen wird nach dem dritten Mal blind bestätigt, ein
                 Rückgängig-Band schützt auch den, der zu schnell geklickt
                 hat. Es verschwindet NICHT von selbst — erst beim
                 Bereichswechsel oder auf „Schließen“. -->
            <Border DockPanel.Dock="Top" Classes="banner hinweis"
                    IsVisible="{Binding RueckgaengigSichtbar}"
                    Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding RueckgaengigText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Content="Rückgängig"
                            VerticalAlignment="Top"
                            ToolTip.Tip="Legt die gelöschten Buchungen wieder an"
                            Command="{Binding LoeschenRueckgaengigCommand}" />
                    <Button Grid.Column="2" Classes="ghost" Content="Schließen"
                            VerticalAlignment="Top"
                            Command="{Binding RueckgaengigSchliessenCommand}" />
                </Grid>
            </Border>

            <!-- ============ Fusszeile ============ -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto"
                  Margin="4,10,20,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding TrefferText}"
                           Foreground="{DynamicResource TextTertiaerFarbe}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontWeight="Bold"
                           Classes.einnahme="{Binding SummeIstEinnahme}"
                           Text="{Binding SummeText, StringFormat='Summe: {0}'}" />
            </Grid>

            <!-- ============ Kopfzeile und Tabelle ============
                 Beides steckt in einem waagerechten Bildlauf: die festen
                 Spalten summieren sich bei der Stufe "Sehr groß" auf mehr
                 als das Fenster breit ist, und ohne ihn waeren die
                 Schaltflaechen der letzten Spalte nicht mehr erreichbar.
                 Aeusserer Bildlauf waagerecht, innerer (die ListBox)
                 senkrecht - dasselbe Muster wie in ReportView.

                 Die Breite kommt aus dem Bildlauffeld selbst, die
                 MinWidth setzt die Untergrenze. Ohne die feste Breite
                 misst der waagerechte Bildlauf seinen Inhalt mit
                 UNBEGRENZTER Breite; eine Sternspalte verhaelt sich dann
                 wie "Auto" und wird so breit wie ihr laengster Inhalt -
                 genau dadurch konnte ein langer Kategoriepfad die Spalten
                 dahinter nach rechts schieben und die Zeilen gegeneinander
                 versetzen.

                 Die MinWidth ist die Summe aller uebrigen Spalten (857)
                 plus rund 140 Pixel Rest fuer die Bemerkung; die
                 einstellbare Kategoriebreite kommt hinzu. Sie waechst also
                 mit, wenn die Kategoriespalte breiter gezogen wird -
                 sonst holte die sich ihren Platz aus der Bemerkung, bis
                 von der nichts mehr uebrig ist. -->
            <ScrollViewer x:Name="Waagerecht"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <DockPanel Width="{Binding #Waagerecht.Viewport.Width}"
                       MinWidth="{anzeige:BreitePlusKategorie 1100}">
            <!-- Breite aus der Zeilenliste statt geschaetzter Bildlaufleiste
                 (siehe PersonenView). Hier aber ueber Scroll.Viewport und
                 nicht ueber Bounds: die ListBox scrollt selbst, ihre
                 Gesamtbreite enthaelt also die Bildlaufleiste, waehrend die
                 Zeilen nur den Viewport davor fuellen. -->
            <Border DockPanel.Dock="Top"
                    Width="{Binding #Zeilenliste.Scroll.Viewport.Width}"
                    HorizontalAlignment="Left"
                    Padding="4,0,4,4">
                <Grid anzeige:Raster.Spalten="4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,300">
                    <Button Grid.Column="4" Classes="kopf" Content="{Binding DatumHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Datum" />
                    <Button Grid.Column="6" Classes="kopf" Content="{Binding KategorieHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Kategorie" />

                    <!-- Der Griff steht in der Abstandsspalte hinter der
                         Kategorie: dort ist die Trennlinie, und er nimmt
                         keiner Spalte Platz weg. -->
                    <anzeige:Spaltengriff Grid.Column="7"
                                          ToolTip.Tip="Breite der Kategoriespalte ziehen" />

                    <Button Grid.Column="8" Classes="kopf zahl" Content="{Binding BetragHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Betrag" />
                    <Button Grid.Column="10" Classes="kopf" Content="{Binding ZahlerHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Zahler" />
                    <Button Grid.Column="12" Classes="kopf" Content="{Binding StatusHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Status" />
                    <Button Grid.Column="14" Classes="kopf" Content="{Binding BemerkungHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Bemerkung" />
                    <Button Grid.Column="16" Content="Aktionen" Classes="tabellenkopf-aktion"
                            ToolTip.Tip="Rechtsklick auf eine Zeile: Als Vorlage anlegen" />
                </Grid>
            </Border>

            <TextBlock Text="Keine Ausgaben für diesen Filter."
                       IsVisible="{Binding KeineTreffer}"
                       DockPanel.Dock="Top"
                       Foreground="{DynamicResource TextTertiaerFarbe}"
                       FontStyle="Italic"
                       Margin="4,8" />

            <!-- ============ Tabelle ============
                 ListBox statt ItemsControl: ihr Standard-ItemsPanel ist
                 ein VirtualizingStackPanel und sie bringt den ScrollViewer
                 mit - noetig, weil die Liste ueber Jahre tausende Zeilen
                 enthalten kann. -->
            <ListBox x:Name="Zeilenliste"
                     Classes="tabelle"
                     ItemsSource="{Binding Zeilen}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AusgabeZeile">
                        <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1" Padding="4,6">
                            <!-- "Als Vorlage" steht im Kontextmenue und
                                 nicht als vierter Knopf in der
                                 Aktionsspalte: die ist bereits an ihrer
                                 Breitengrenze (siehe Kommentar am Kopf der
                                 Datei). Die uebrigen Aktionen wandern
                                 spaeter mit hierher. -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Als Vorlage anlegen…"
                                              Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).AlsVorlageCommand}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid anzeige:Raster.Spalten="4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,300">
                                <!-- Farbe der Kategorie. Bewusst ein schmaler
                                     Balken am Rand und keine eingefaerbte
                                     Zeile: der Text muss lesbar bleiben, und
                                     die Zeile darf nicht wie eine
                                     Hervorhebung wirken. -->
                                <Border Grid.Column="0"
                                        Classes="farbbalken"
                                        Background="{Binding Farbe}"
                                        ToolTip.Tip="{Binding CategoryFullPath}" />

                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding IstAusgewaehlt}"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="⟳"
                                           Classes="vorlage"
                                           IsVisible="{Binding IstAusVorlage}"
                                           ToolTip.Tip="{Binding VorlageHinweis}" />

                                <TextBlock Grid.Column="4" Text="{Binding DatumText}"
                                           Classes="tabellenzelle" />

                                <!-- Kuerzung vorne: aus "Pferde › Gesundheit ›
                                     Medizin › Impfungen" wird "… › Medizin ›
                                     Impfungen". Den vollen Pfad zeigt der
                                     Hilfetext - aber nur, wenn wirklich etwas
                                     weggefallen ist. -->
                                <anzeige:Textzelle Grid.Column="6"
                                                   Inhalt="{Binding CategoryFullPath}"
                                                   Kuerzung="Vorne"
                                                   Classes="tabellenzelle" />

                                <TextBlock Grid.Column="8" Text="{Binding BetragText}"
                                           Classes="tabellenzelle zahl"
                                           Classes.offen="{Binding IstOffen}"
                                           Classes.einnahme="{Binding IstBeglicheneEinnahme}"
                                           Classes.beglichen-ausgabe="{Binding IstBeglichenAusgabe}" />
                                <anzeige:Textzelle Grid.Column="10" Inhalt="{Binding PayerName}"
                                                   Classes="tabellenzelle" />
                                <TextBlock Grid.Column="12" Text="{Binding StatusText}"
                                           Classes="tabellenzelle" />
                                <anzeige:Textzelle Grid.Column="14" Inhalt="{Binding Note}"
                                                   Classes="tabellenzelle" />

                                <StackPanel Grid.Column="16" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary klein" Content="Bearbeiten"
                                            Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenOeffnenCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="secondary klein" Content="Duplizieren"
                                            ToolTip.Tip="Legt dieselbe Buchung noch einmal an, mit dem heutigen Datum"
                                            Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).DuplizierenCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="danger klein" Content="Löschen"
                                            Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).LoeschenCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Overlay: Sammelaktion bestätigen ============
             Erst ab 20 betroffenen Zeilen (siehe
             AusgabenlisteViewModel.SammelBestaetigungSchwelle). Darunter
             läuft die Aktion sofort - Reibung nach Schadensausmaß. -->
        <Panel IsVisible="{Binding SammelAnfrageAktiv}" Background="#60000000">
            <Border Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="24"
                    MaxWidth="{anzeige:Breite 520}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding SammelAnfrageText}" TextWrapping="Wrap" />

                    <!-- Ein Schreibfehler: die Nachfrage bleibt offen,
                         damit sich der Versuch ohne neue Auswahl
                         wiederholen lässt (Regel 13). -->
                    <Border IsVisible="{Binding SchreibFehlerSichtbar}"
                            Background="{DynamicResource FehlerFlaeche}" BorderBrush="{DynamicResource FehlerRahmen}" BorderThickness="1"
                            Padding="8">
                        <TextBlock Text="{Binding SchreibFehlerText}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Abbrechen"
                                Command="{Binding SammelAbbrechenCommand}" />
                        <Button Classes="primary" Content="Übernehmen"
                                Command="{Binding SammelBestaetigenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============ Overlay: Bearbeiten ============
             Dieselben Felder und dieselbe Reihenfolge wie die
             Erfassungsmaske (Views/ErfassenView.axaml). -->
        <Panel IsVisible="{Binding BearbeitenAktiv}" Background="#60000000">
            <!-- Der Bildlauf ist bei den grossen Schriftstufen noetig: das
                 Formular wird dann hoeher als das Fenster, und ohne ihn
                 waeren die unteren Felder samt Schaltflaechen nicht mehr
                 erreichbar. -->
            <Border Background="{DynamicResource SurfaceRaisedFarbe}" BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="24"
                    Width="{anzeige:Breite 460}"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <ScrollViewer>
                <StackPanel DataContext="{Binding Bearbeiten}"
                            x:DataType="vm:AusgabeBearbeitenViewModel"
                            Spacing="2">
                    <TextBlock Text="Ausgabe bearbeiten" Classes="ueberschrift"
                               Margin="0,0,0,10" />

                    <!-- Regel 6: die Vorlage bleibt unberuehrt -->
                    <Border IsVisible="{Binding IstAusVorlage}"
                            Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding VorlageHinweis}" TextWrapping="Wrap" />
                            <TextBlock Text="Die Änderung betrifft nur diese eine Buchung, nicht die Vorlage."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Das €-Zeichen steht in der Beschriftung, nicht im
                         Feld: eingegeben wird die blanke Zahl. -->
                    <TextBlock Text="Betrag (€)" />
                    <TextBox Text="{Binding BetragText}"
                             PlaceholderText="0,00 (auch 12,50+3,20)"
                             ToolTip.Tip="Mehrere Posten lassen sich zusammenzählen: 12,50+3,20"
                             LostFocus="BetragLostFocus" />
                    <TextBlock Text="{Binding BetragFehler}"
                               IsVisible="{Binding BetragFehlerSichtbar}"
                               Foreground="{DynamicResource FehlerText}" />

                    <!-- Einnahme statt Ausgabe: mindert die Summen in
                         Liste und Auswertung, statt sie zu erhoehen. -->
                    <CheckBox Content="Einnahme"
                              IsChecked="{Binding IstEinnahme}"
                              Margin="0,6,0,0" />

                    <TextBlock Text="Kategorie" Margin="0,10,0,0" />
                    <AutoCompleteBox ItemsSource="{Binding KategorieVorschlaege}"
                                     ValueMemberBinding="{Binding FullPath}"
                                     FilterMode="Contains"
                                     SelectedItem="{Binding AusgewaehlteKategorie}"
                                     PlaceholderText="Kategorie suchen...">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="categories:CategoryOption">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="farbpunkt"
                                            Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                                    <TextBlock Text="{Binding FullPath}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <TextBlock Text="{Binding KategorieFehler}"
                               IsVisible="{Binding KategorieFehlerSichtbar}"
                               Foreground="{DynamicResource FehlerText}" />

                    <TextBlock Text="Datum" Margin="0,10,0,0" />
                    <TextBox Text="{Binding DatumText}"
                             PlaceholderText="TT.MM.JJJJ oder heute"
                             ToolTip.Tip="Kurzformen: heute, gestern, vorgestern, -3 (vor drei Tagen), 15. (der 15. dieses Monats)"
                             LostFocus="DatumLostFocus" />
                    <TextBlock Text="{Binding DatumFehler}"
                               IsVisible="{Binding DatumFehlerSichtbar}"
                               Foreground="{DynamicResource FehlerText}" />

                    <!-- Rückfrage bei einem ungewöhnlichen Datum: kein
                         Verbot, sondern eine Bestätigung. -->
                    <Border IsVisible="{Binding DatumRueckfrageSichtbar}"
                            Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                            Padding="8" Margin="0,6,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DatumRueckfrageText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Ja, so speichern"
                                        Command="{Binding DatumBestaetigenCommand}" />
                                <Button Content="Datum ändern"
                                        Command="{Binding DatumRueckfrageAbbrechenCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Bemerkung" Margin="0,10,0,0" />
                    <TextBox Text="{Binding Bemerkung}" />

                    <TextBlock Text="Zahler" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                              SelectedItem="{Binding AusgewaehlterZahler}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Person">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ZahlerFehler}"
                               IsVisible="{Binding ZahlerFehlerSichtbar}"
                               Foreground="{DynamicResource FehlerText}" />

                    <!-- Kein anderer Zahler vorhanden, um eine gerade
                         angekreuzte Einnahme zuzuordnen - das Haekchen
                         wurde deshalb bereits automatisch zurueckgesetzt
                         (siehe AusgabeBearbeitenViewModel.AktualisiereZahlerAuswahl). -->
                    <TextBlock Text="{Binding EinnahmeHinweisText}"
                               IsVisible="{Binding EinnahmeHinweisSichtbar}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarnungText}"
                               Margin="0,6,0,0" />

                    <!-- Nur bei fremdem Zahler ueberhaupt gemeint (Regel
                         4) - das Abhaken selbst bleibt Aufgabe von
                         "Offene Posten", hier laesst sich nur ein
                         bereits eingetragenes Datum korrigieren. Leer =
                         weiterhin offen. -->
                    <StackPanel IsVisible="{Binding BezahltAmSichtbar}">
                        <TextBlock Text="{Binding BezahltAmLabelText}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding BezahltAmText}"
                                 PlaceholderText="TT.MM.JJJJ (leer = offen)"
                                 Width="{anzeige:Breite 150}"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding BezahltAmFehler}"
                                   IsVisible="{Binding BezahltAmFehlerSichtbar}"
                                   Foreground="{DynamicResource FehlerText}" />
                    </StackPanel>

                    <!-- Schreibfehler: der Dialog bleibt offen und
                         gefüllt, damit keine Änderung verloren geht. -->
                    <Border IsVisible="{Binding SpeicherFehlerSichtbar}"
                            Background="{DynamicResource FehlerFlaeche}" BorderBrush="{DynamicResource FehlerRahmen}" BorderThickness="1"
                            Padding="8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SpeicherFehlerText}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Classes="ghost" Content="Abbrechen"
                                Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenAbbrechenCommand}" />
                        <Button Classes="primary" Content="Speichern"
                                Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenSpeichernCommand}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>
    </Panel>
</UserControl>
