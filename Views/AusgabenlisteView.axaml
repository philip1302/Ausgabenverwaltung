<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:categories="using:Ausgabenverwaltung.Core.Categories"
             xmlns:entities="using:Ausgabenverwaltung.Core.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.AusgabenlisteView"
             x:Name="Wurzel"
             x:DataType="vm:AusgabenlisteViewModel">

    <!-- Spaltenraster "4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,200"
         gilt fuer Kopfzeile UND Zeilen gleichermassen: Farbbalken,
         Auswahl, Vorlagen-Marker, Datum, Kategorie, Betrag, Zahler,
         Status, Bemerkung, Aktionen - dazwischen feste Gutter-Spalten als
         Abstandhalter (Indizes 1,5,7,9,11,13,15). Die Tabellen-Styles
         (Button.kopf, TextBlock.tabellenzelle, ...) kommen aus App.axaml.

         Angegeben ueber anzeige:Raster.Spalten und nicht ueber
         ColumnDefinitions: die festen Breiten sind auf Text ausgelegt und
         muessen mit der eingestellten Schriftgroesse mitwachsen, sonst
         wird bei "Sehr groß" abgeschnitten. Kopfzeile und Zeilen rechnen
         mit demselben Faktor und stehen dadurch weiterhin exakt
         uebereinander.

         JEDE Spalte hat eine feste oder anteilige Breite - keine einzige
         richtet sich nach ihrem Inhalt. Nur so bleibt die Gesamtbreite
         konstant und kann ein langer Kategoriepfad die Spalten dahinter
         nicht nach rechts schieben. Die Zellen mit unbegrenzt langem
         Inhalt (Kategorie, Zahler, Bemerkung) sind deshalb
         anzeige:Textzelle: sie verlangen nie mehr Breite, als die Spalte
         ihnen gibt, bleiben einzeilig und kuerzen mit
         Auslassungspunkten - die Kategorie vorne, damit der Name der
         Kategorie selbst vollstaendig lesbar bleibt, alles uebrige hinten.

         "Kategorie" im Muster ist die einzige Breite, die der Benutzer
         selbst bestimmt: am Spaltengriff in der Kopfzeile zu ziehen
         (siehe anzeige:Spaltengriff), gemerkt ueber dieselbe
         Einstellungsdatei wie Schriftgroesse und Sicherungspfad. Was
         sie an Platz bekommt, geht der Bemerkung ab - die ist die
         einzige Sternspalte und faengt jede Aenderung auf.

         Die Statusspalte ist 175 statt der urspruenglichen 120 Pixel
         breit: der laengste Wert ist "beglichen am 29.09.2025" und wurde
         vorher abgeschnitten.

         Die Betragsspalte ist 110 statt der urspruenglichen 90 Pixel
         breit: seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz als vorher "1.234,56".

         Die Aktionsspalte fasst "Bearbeiten" und "Löschen" nebeneinander;
         200 statt der urspruenglichen 150 Pixel, weil die beiden
         Schaltflaechen mit der Theme-Polsterung sonst nicht nebeneinander
         passen und die zweite abgeschnitten wird. -->
    <UserControl.Styles>
        <!-- Die ListBox dient hier nur als virtualisierender Behaelter:
             ausgewaehlt wird ueber die Checkbox-Spalte, weil die Zeilen
             eigene Schaltflaechen enthalten und ein Klick auf die Zeile
             sonst mit der Listenauswahl kollidiert. Deshalb Polsterung
             und Auswahl-Optik entfernen. -->
        <Style Selector="ListBox.tabelle > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tabelle > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.tabelle > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F5F5F5" />
        </Style>

        <Style Selector="TextBlock.vorlage">
            <Setter Property="Foreground" Value="#7A5C00" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Knoten der Kategorie-Auswahl: sieht wie eine Beschriftung aus,
             ist aber die Schaltflaeche, ueber die gewaehlt wird. -->
        <Style Selector="Button.kategoriewahl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="TextBlock.filterbeschriftung">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Der schmale Farbbalken am linken Zeilenrand: er zeigt die
             Farbe der Kategorie und ergaenzt damit die Kategoriespalte,
             die daneben unveraendert im Klartext steht. -->
        <Style Selector="Border.farbbalken">
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel>
            <!-- ============ Filterleiste ============ -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Padding="0,0,0,10" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <!-- Zeitraum -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Von" Classes="filterbeschriftung" />
                            <TextBox Text="{Binding VonText}"
                                     Width="{anzeige:Breite 110}"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bis" Classes="filterbeschriftung" />
                            <TextBox Text="{Binding BisText}"
                                     Width="{anzeige:Breite 110}"
                                     PlaceholderText="TT.MM.JJJJ" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Schnellwahl" Classes="filterbeschriftung" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Dieser Monat"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="DieserMonat" />
                                <Button Content="Dieses Jahr"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="DiesesJahr" />
                                <Button Content="Letzte 12 Monate"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Letzte12Monate" />
                                <Button Content="Alles"
                                        ToolTip.Tip="Ohne zeitliche Einschränkung"
                                        Command="{Binding SchnellwahlCommand}"
                                        CommandParameter="Alles" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding ZeitraumFehler}"
                                   IsVisible="{Binding ZeitraumFehlerSichtbar}"
                                   Classes="fehler"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,6" />
                    </StackPanel>

                    <!-- Kategorie, Zahler, Status, Suche -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Kategorie (immer inkl. Unterkategorien)"
                                       Classes="filterbeschriftung" />
                            <Button x:Name="KategorieAuswahl"
                                    Content="{Binding KategorieFilterText}"
                                    Width="{anzeige:Breite 260}"
                                    HorizontalContentAlignment="Left">
                                <Button.Flyout>
                                    <!-- Gewaehlt wird ueber den Knoten-Button, NICHT ueber
                                         TreeView.SelectedItem: beim Schliessen des Flyouts
                                         setzt der TreeView seine Auswahl zurueck und wuerde
                                         den Filter ueber die Bindung sofort wieder leeren.
                                         Der TreeView liefert hier nur noch die Aufklapp-
                                         Struktur. -->
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="{anzeige:Breite 320}" Spacing="6">
                                            <Button Content="Alle Kategorien"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding AlleKategorienCommand}"
                                                    Click="KategorieFlyout_Schliessen" />
                                            <TreeView MaxHeight="{anzeige:Breite 320}"
                                                      ItemsSource="{Binding KategorieWurzeln}">
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate x:DataType="vm:KategorieFilterKnoten"
                                                                      ItemsSource="{Binding Children}">
                                                        <Button Classes="kategoriewahl"
                                                                Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).KategorieWaehlenCommand}"
                                                                CommandParameter="{Binding}"
                                                                Click="KategorieFlyout_Schliessen">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Classes.archiviert="{Binding IsArchived}" />
                                                        </Button>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Zahler" Classes="filterbeschriftung" />
                            <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                                      SelectedItem="{Binding AusgewaehlterZahler}"
                                      Width="{anzeige:Breite 160}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ZahlerOption">
                                        <TextBlock Text="{Binding Bezeichnung}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Status" Classes="filterbeschriftung" />
                            <ComboBox ItemsSource="{Binding StatusOptionen}"
                                      SelectedItem="{Binding AusgewaehlterStatus}"
                                      Width="{anzeige:Breite 150}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusOption">
                                        <TextBlock Text="{Binding Bezeichnung}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Suche in der Bemerkung" Classes="filterbeschriftung" />
                            <TextBox Text="{Binding Suchtext}"
                                     Width="{anzeige:Breite 220}"
                                     PlaceholderText="Volltext…" />
                        </StackPanel>

                        <Button Content="Filter zurücksetzen"
                                Command="{Binding FilterZuruecksetzenCommand}"
                                VerticalAlignment="Bottom" />
                    </StackPanel>

                    <!-- Einschraenkung auf eine Vorlage. Sie steht in keinem
                         Bedienelement der Filterleiste, deshalb muss sie hier
                         sichtbar sein - sonst waere unerklaerlich, warum
                         ploetzlich fast alle Buchungen fehlen. -->
                    <Border IsVisible="{Binding VorlageFilterAktiv}"
                            Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                            CornerRadius="2" Padding="8,4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding VorlageFilterText}"
                                       VerticalAlignment="Center" />
                            <Button Content="✕"
                                    ToolTip.Tip="Einschränkung auf die Vorlage aufheben"
                                    Command="{Binding VorlagenFilterEntfernenCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ Werkzeugleiste ============ -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12"
                        Margin="0,0,0,10">
                <Button Content="Ausgewählte löschen"
                        Command="{Binding AusgewaehlteLoeschenCommand}" />
                <TextBlock Text="{Binding AnzahlAusgewaehlt, StringFormat='{}{0} ausgewählt'}"
                           IsVisible="{Binding HatAuswahl}"
                           Foreground="Gray"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- ============ Fusszeile ============ -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto"
                  Margin="4,10,20,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding TrefferText}"
                           Foreground="Gray"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontWeight="Bold"
                           Classes.erstattung="{Binding SummeIstErstattung}"
                           Text="{Binding SummeText, StringFormat='Summe: {0}'}" />
            </Grid>

            <!-- ============ Kopfzeile und Tabelle ============
                 Beides steckt in einem waagerechten Bildlauf: die festen
                 Spalten summieren sich bei der Stufe "Sehr groß" auf mehr
                 als das Fenster breit ist, und ohne ihn waeren die
                 Schaltflaechen der letzten Spalte nicht mehr erreichbar.
                 Aeusserer Bildlauf waagerecht, innerer (die ListBox)
                 senkrecht - dasselbe Muster wie in ReportView.

                 Die Breite kommt aus dem Bildlauffeld selbst, die
                 MinWidth setzt die Untergrenze. Ohne die feste Breite
                 misst der waagerechte Bildlauf seinen Inhalt mit
                 UNBEGRENZTER Breite; eine Sternspalte verhaelt sich dann
                 wie "Auto" und wird so breit wie ihr laengster Inhalt -
                 genau dadurch konnte ein langer Kategoriepfad die Spalten
                 dahinter nach rechts schieben und die Zeilen gegeneinander
                 versetzen.

                 Die MinWidth ist die Summe aller uebrigen Spalten (857)
                 plus rund 140 Pixel Rest fuer die Bemerkung; die
                 einstellbare Kategoriebreite kommt hinzu. Sie waechst also
                 mit, wenn die Kategoriespalte breiter gezogen wird -
                 sonst holte die sich ihren Platz aus der Bemerkung, bis
                 von der nichts mehr uebrig ist. -->
            <ScrollViewer x:Name="Waagerecht"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <DockPanel Width="{Binding #Waagerecht.Viewport.Width}"
                       MinWidth="{anzeige:BreitePlusKategorie 1000}">
            <!-- Breite aus der Zeilenliste statt geschaetzter Bildlaufleiste
                 (siehe PersonenView). Hier aber ueber Scroll.Viewport und
                 nicht ueber Bounds: die ListBox scrollt selbst, ihre
                 Gesamtbreite enthaelt also die Bildlaufleiste, waehrend die
                 Zeilen nur den Viewport davor fuellen. -->
            <Border DockPanel.Dock="Top"
                    Width="{Binding #Zeilenliste.Scroll.Viewport.Width}"
                    HorizontalAlignment="Left"
                    Padding="4,0,4,4">
                <Grid anzeige:Raster.Spalten="4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,200">
                    <Button Grid.Column="4" Classes="kopf" Content="{Binding DatumHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Datum" />
                    <Button Grid.Column="6" Classes="kopf" Content="{Binding KategorieHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Kategorie" />

                    <!-- Der Griff steht in der Abstandsspalte hinter der
                         Kategorie: dort ist die Trennlinie, und er nimmt
                         keiner Spalte Platz weg. -->
                    <anzeige:Spaltengriff Grid.Column="7"
                                          ToolTip.Tip="Breite der Kategoriespalte ziehen" />

                    <Button Grid.Column="8" Classes="kopf zahl" Content="{Binding BetragHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Betrag" />
                    <Button Grid.Column="10" Classes="kopf" Content="{Binding ZahlerHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Zahler" />
                    <Button Grid.Column="12" Classes="kopf" Content="{Binding StatusHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Status" />
                    <Button Grid.Column="14" Classes="kopf" Content="{Binding BemerkungHeaderText}"
                            Command="{Binding SpalteSortierenCommand}" CommandParameter="Bemerkung" />
                    <Button Grid.Column="16" Content="Aktionen" Classes="tabellenkopf-aktion" />
                </Grid>
            </Border>

            <TextBlock Text="Keine Ausgaben für diesen Filter."
                       IsVisible="{Binding KeineTreffer}"
                       DockPanel.Dock="Top"
                       Foreground="Gray"
                       FontStyle="Italic"
                       Margin="4,8" />

            <!-- ============ Tabelle ============
                 ListBox statt ItemsControl: ihr Standard-ItemsPanel ist
                 ein VirtualizingStackPanel und sie bringt den ScrollViewer
                 mit - noetig, weil die Liste ueber Jahre tausende Zeilen
                 enthalten kann. -->
            <ListBox x:Name="Zeilenliste"
                     Classes="tabelle"
                     ItemsSource="{Binding Zeilen}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AusgabeZeile">
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,6">
                            <Grid anzeige:Raster.Spalten="4,8,32,24,90,16,Kategorie,16,110,24,110,16,175,16,*,16,200">
                                <!-- Farbe der Kategorie. Bewusst ein schmaler
                                     Balken am Rand und keine eingefaerbte
                                     Zeile: der Text muss lesbar bleiben, und
                                     die Zeile darf nicht wie eine
                                     Hervorhebung wirken. -->
                                <Border Grid.Column="0"
                                        Classes="farbbalken"
                                        Background="{Binding Farbe}"
                                        ToolTip.Tip="{Binding CategoryFullPath}" />

                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding IstAusgewaehlt}"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="⟳"
                                           Classes="vorlage"
                                           IsVisible="{Binding IstAusVorlage}"
                                           ToolTip.Tip="{Binding VorlageHinweis}" />

                                <TextBlock Grid.Column="4" Text="{Binding DatumText}"
                                           Classes="tabellenzelle" />

                                <!-- Kuerzung vorne: aus "Pferde › Gesundheit ›
                                     Medizin › Impfungen" wird "… › Medizin ›
                                     Impfungen". Den vollen Pfad zeigt der
                                     Hilfetext - aber nur, wenn wirklich etwas
                                     weggefallen ist. -->
                                <anzeige:Textzelle Grid.Column="6"
                                                   Inhalt="{Binding CategoryFullPath}"
                                                   Kuerzung="Vorne"
                                                   Classes="tabellenzelle" />

                                <TextBlock Grid.Column="8" Text="{Binding BetragText}"
                                           Classes="tabellenzelle zahl"
                                           Classes.erstattung="{Binding IstErstattung}" />
                                <anzeige:Textzelle Grid.Column="10" Inhalt="{Binding PayerName}"
                                                   Classes="tabellenzelle" />
                                <TextBlock Grid.Column="12" Text="{Binding StatusText}"
                                           Classes="tabellenzelle" />
                                <anzeige:Textzelle Grid.Column="14" Inhalt="{Binding Note}"
                                                   Classes="tabellenzelle" />

                                <StackPanel Grid.Column="16" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Bearbeiten"
                                            Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenOeffnenCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Löschen"
                                            Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).LoeschenCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Overlay: Loesch-Sicherheitsabfrage ============ -->
        <Panel IsVisible="{Binding LoeschAnfrageAktiv}" Background="#60000000">
            <Border Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                    CornerRadius="2" Padding="16" Margin="24"
                    MaxWidth="{anzeige:Breite 520}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding LoeschAnfrageText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Löschen" Command="{Binding LoeschenBestaetigenCommand}" />
                        <Button Content="Abbrechen" Command="{Binding LoeschenAbbrechenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============ Overlay: Bearbeiten ============
             Dieselben Felder und dieselbe Reihenfolge wie die
             Erfassungsmaske (Views/ErfassenView.axaml). -->
        <Panel IsVisible="{Binding BearbeitenAktiv}" Background="#60000000">
            <!-- Der Bildlauf ist bei den grossen Schriftstufen noetig: das
                 Formular wird dann hoeher als das Fenster, und ohne ihn
                 waeren die unteren Felder samt Schaltflaechen nicht mehr
                 erreichbar. -->
            <Border Background="White" BorderBrush="#C0C0C0" BorderThickness="1"
                    CornerRadius="2" Padding="16" Margin="24"
                    Width="{anzeige:Breite 460}"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                <ScrollViewer>
                <StackPanel DataContext="{Binding Bearbeiten}"
                            x:DataType="vm:AusgabeBearbeitenViewModel"
                            Spacing="2">
                    <TextBlock Text="Ausgabe bearbeiten" Classes="ueberschrift"
                               Margin="0,0,0,10" />

                    <!-- Regel 6: die Vorlage bleibt unberuehrt -->
                    <Border IsVisible="{Binding IstAusVorlage}"
                            Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                            Padding="8" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding VorlageHinweis}" TextWrapping="Wrap" />
                            <TextBlock Text="Die Änderung betrifft nur diese eine Buchung, nicht die Vorlage."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Das €-Zeichen steht in der Beschriftung, nicht im
                         Feld: eingegeben wird die blanke Zahl. -->
                    <TextBlock Text="Betrag (€)" />
                    <TextBox Text="{Binding BetragText}" PlaceholderText="0,00" />
                    <TextBlock Text="{Binding BetragFehler}"
                               IsVisible="{Binding BetragFehlerSichtbar}"
                               Foreground="Red" />

                    <TextBlock Text="Kategorie" Margin="0,10,0,0" />
                    <AutoCompleteBox ItemsSource="{Binding KategorieVorschlaege}"
                                     ValueMemberBinding="{Binding FullPath}"
                                     FilterMode="Contains"
                                     SelectedItem="{Binding AusgewaehlteKategorie}"
                                     PlaceholderText="Kategorie suchen...">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="categories:CategoryOption">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="farbpunkt"
                                            Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                                    <TextBlock Text="{Binding FullPath}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <TextBlock Text="{Binding KategorieFehler}"
                               IsVisible="{Binding KategorieFehlerSichtbar}"
                               Foreground="Red" />

                    <TextBlock Text="Datum" Margin="0,10,0,0" />
                    <TextBox Text="{Binding DatumText}" PlaceholderText="TT.MM.JJJJ" />
                    <TextBlock Text="{Binding DatumFehler}"
                               IsVisible="{Binding DatumFehlerSichtbar}"
                               Foreground="Red" />

                    <TextBlock Text="Bemerkung" Margin="0,10,0,0" />
                    <TextBox Text="{Binding Bemerkung}" />

                    <TextBlock Text="Zahler" Margin="0,10,0,0" />
                    <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                              SelectedItem="{Binding AusgewaehlterZahler}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Person">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Speichern"
                                Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenSpeichernCommand}" />
                        <Button Content="Abbrechen"
                                Command="{Binding #Wurzel.((vm:AusgabenlisteViewModel)DataContext).BearbeitenAbbrechenCommand}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>
    </Panel>
</UserControl>
