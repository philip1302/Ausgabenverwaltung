<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.OffenePostenView"
             x:Name="Wurzel"
             x:DataType="vm:OffenePostenViewModel">

    <!-- Spaltenraster "32,90,16,2*,16,110,24,2*,16,100,24,190" gilt fuer
         Kopfzeile UND Zeilen-Grid gleichermassen: Checkbox, Datum,
         Kategorie, Betrag, Bemerkung, TageOffen, Aktionen, dazwischen feste
         Gutter-Spalten als Abstandhalter (Indizes 2,4,6,8,10).

         Die Betragsspalte ist 110 statt der urspruenglichen 90 Pixel
         breit: seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz als vorher "1.234,56". -->
    <UserControl.Styles>
        <Style Selector="TextBlock.beglichen">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Rueckgaengig-Hinweis nach dem Abhaken -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding RueckgaengigSichtbar}"
                Background="#DFF5DF"
                BorderBrush="#8FCB8F"
                BorderThickness="0,0,0,1"
                Padding="8"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding RueckgaengigText}" VerticalAlignment="Center" />
                <Button Content="Rückgängig" Command="{Binding RueckgaengigCommand}" />
            </StackPanel>
        </Border>

        <!-- Werkzeugleiste -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <Button Content="Ausgewählte abhaken" Command="{Binding AusgewaehlteAbhakenCommand}" />
                <CheckBox Content="Beglichene der letzten 30 Tage anzeigen"
                          IsChecked="{Binding BeglicheneLetzte30TageAnzeigen}"
                          VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Classes.erstattung="{Binding GesamtsummeIstErstattung}"
                       Text="{Binding GesamtsummeText, StringFormat='Gesamt offen: {0}'}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                    Text="Keine offenen Posten."
                    IsVisible="{Binding KeineEintraege}"
                    Foreground="Gray"
                    FontStyle="Italic"
                    Margin="0,8" />

        <!-- Kopfzeile
             Breite aus der Zeilenliste statt geschaetzter Bildlaufleiste -
             siehe die gleichlautende Stelle in PersonenView. -->
        <Border DockPanel.Dock="Top"
                Width="{Binding #Zeilenliste.Bounds.Width}"
                HorizontalAlignment="Left"
                IsVisible="{Binding !KeineEintraege}"
                Padding="4,0,4,4">
            <Grid anzeige:Raster.Spalten="32,90,16,2*,16,110,24,2*,16,100,24,190">
                <TextBlock Grid.Column="0" />
                <Button Grid.Column="1" Classes="kopf" Content="{Binding DatumHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Datum" />
                <Button Grid.Column="3" Classes="kopf" Content="{Binding KategorieHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Kategorie" />
                <Button Grid.Column="5" Classes="kopf zahl" Content="{Binding BetragHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Betrag" />
                <Button Grid.Column="7" Classes="kopf" Content="{Binding BemerkungHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Bemerkung" />
                <Button Grid.Column="9" Classes="kopf mitte" Content="{Binding TageOffenHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="TageOffen" />
                <Button Grid.Column="11" Content="Aktionen" Classes="tabellenkopf-aktion" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl x:Name="Zeilenliste" ItemsSource="{Binding Gruppen}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonenGruppe">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding PersonName}" Classes="ueberschrift" Margin="0,8,0,4" />

                            <ItemsControl ItemsSource="{Binding Zeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OffenerPostenZeile">
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,6">
                                            <StackPanel>
                                                <Grid anzeige:Raster.Spalten="32,90,16,2*,16,110,24,2*,16,100,24,190">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IstAusgewaehlt}"
                                                              IsVisible="{Binding !IstBeglichen}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DatumText}"
                                                               Classes="tabellenzelle"
                                                               Classes.beglichen="{Binding IstBeglichen}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CategoryFullPath}"
                                                               Classes="tabellenzelle"
                                                               Classes.beglichen="{Binding IstBeglichen}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="5" Text="{Binding BetragText}"
                                                               Classes="tabellenzelle zahl"
                                                               Classes.erstattung="{Binding IstErstattung}"
                                                               Classes.beglichen="{Binding IstBeglichen}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding Note}"
                                                               Classes="tabellenzelle"
                                                               Classes.beglichen="{Binding IstBeglichen}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="9" Text="{Binding TageOffen}"
                                                               Classes="tabellenzelle mitte"
                                                               Classes.beglichen="{Binding IstBeglichen}" />

                                                    <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding !IstBeglichen}">
                                                        <Button Content="Abhaken"
                                                                ToolTip.Tip="Heute als beglichen markieren"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbhakenCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Datum…"
                                                                ToolTip.Tip="Mit abweichendem Datum abhaken"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumOeffnenCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="11" Orientation="Vertical" Spacing="2"
                                                                IsVisible="{Binding IstBeglichen}">
                                                        <TextBlock Text="{Binding BeglichenText}"
                                                                   FontStyle="Italic" Foreground="Gray" />
                                                        <Button Content="Rückgängig"
                                                                ToolTip.Tip="Begleichung rückgängig machen"
                                                                HorizontalAlignment="Left"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).RueckgaengigZeileCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Eingabe eines abweichenden Begleichungsdatums -->
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="32,6,0,0"
                                                            IsVisible="{Binding WaehltAbweichendesDatum}">
                                                    <TextBox Text="{Binding AbweichendesDatumText}"
                                                             Width="{anzeige:Breite 110}"
                                                             PlaceholderText="TT.MM.JJJJ" />
                                                    <Button Content="Übernehmen"
                                                            Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumUebernehmenCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Abbrechen"
                                                            Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumAbbrechenCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding AbweichendesDatumFehler}"
                                                               IsVisible="{Binding AbweichendesDatumFehlerSichtbar}"
                                                               Classes="fehler"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Margin="0,4,20,0"
                                       Classes.erstattung="{Binding ZwischensummeIstErstattung}"
                                       Text="{Binding ZwischensummeText, StringFormat='Zwischensumme: {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
