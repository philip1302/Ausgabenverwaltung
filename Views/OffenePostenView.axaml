<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.OffenePostenView"
             x:Name="Wurzel"
             x:DataType="vm:OffenePostenViewModel">

    <!-- Spaltenraster "32,90,16,Kategorie,16,110,24,*,16,100,24,270" gilt
         fuer Kopfzeile UND Zeilen-Grid gleichermassen: Checkbox, Datum,
         Kategorie, Betrag, Bemerkung, TageOffen, Aktionen, dazwischen feste
         Gutter-Spalten als Abstandhalter (Indizes 2,4,6,8,10).

         Alle Spalten sind fest oder anteilig - keine richtet sich nach
         ihrem Inhalt, die Gesamtbreite bleibt konstant. Kategorie und
         Bemerkung sind anzeige:Textzelle: einzeilig, mit
         Auslassungspunkten gekuerzt und mit Hilfetext nur dort, wo
         wirklich etwas fehlt. Die Kategorie kuerzt vorne (aus
         "Pferde › Gesundheit › Medizin › Impfungen" wird
         "… › Medizin › Impfungen"), die Bemerkung hinten.

         Die Kategoriespalte traegt dieselbe einstellbare Breite wie in
         der Ausgabenliste; gezogen wird am Griff in der Kopfzeile.

         Die Betragsspalte ist 110 statt der urspruenglichen 90 Pixel
         breit: seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz als vorher "1.234,56".

         Die Aktionsspalte ist 270 statt der urspruenglichen 190 Pixel
         breit: bei einer beglichenen Zeile stehen Datum und
         "Rückgängig" NEBENeinander statt untereinander, damit alle Zeilen
         gleich hoch bleiben. -->
    <UserControl.Styles>
        <!-- ":is(TextBlock)", weil die Klasse auch an den Textzellen der
             Kategorie- und Bemerkungsspalte haengt (siehe App.axaml).
             Opacity statt reiner Graufaerbung (UI/UX-Redesign, Abschnitt
             5.2) - deutlicher gedaempft, funktioniert in Hell UND Dunkel. -->
        <Style Selector=":is(TextBlock).beglichen">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="32,24">
        <!-- ============ Kopfzeile mit Gesamtsumme ============
             Prominent oben rechts statt unten in der Werkzeugleiste
             (UI/UX-Redesign, Abschnitt 5.2). -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Classes="seitentitel" Text="Offene Posten" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Gesamt offen" Classes="klein" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextTertiaerFarbe}" />
                <!-- Bleibt neutral: die Summe addiert offene Ausgaben UND
                     Einnahmen in dieselbe Richtung (siehe
                     OpenItemsRepository.GetOpenSumsByPayer) - ihr Vorzeichen
                     sagt nichts ueber Gewinn/Verlust aus wie im Report,
                     sondern nur "wie viel liegt insgesamt offen". -->
                <TextBlock FontSize="{DynamicResource SchriftKpi}" FontWeight="Bold" HorizontalAlignment="Right"
                           Text="{Binding GesamtsummeText}" />
            </StackPanel>
        </Grid>

        <!-- ============ Band: Schreibfehler ============
             Die Liste darunter zeigt danach den tatsächlichen Stand aus
             der Datenbank, nicht den erhofften. -->
        <Border DockPanel.Dock="Top" Classes="banner fehler"
                IsVisible="{Binding SchreibFehlerSichtbar}" Margin="0,0,0,8">
            <Grid anzeige:Raster.Spalten="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding SchreibFehlerText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Schließen"
                        VerticalAlignment="Top"
                        Command="{Binding SchreibFehlerSchliessenCommand}" />
            </Grid>
        </Border>

        <!-- Rueckgaengig-Hinweis nach dem Abhaken -->
        <Border DockPanel.Dock="Top" Classes="banner erfolg"
                IsVisible="{Binding RueckgaengigSichtbar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding RueckgaengigText}" VerticalAlignment="Center" />
                <Button Classes="secondary" Content="Rückgängig" Command="{Binding RueckgaengigCommand}" />
            </StackPanel>
        </Border>

        <!-- Werkzeugleiste -->
        <Border DockPanel.Dock="Top" Classes="filterleiste" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Classes="secondary" Content="Ausgewählte abhaken" Command="{Binding AusgewaehlteAbhakenCommand}" />
                <CheckBox Content="Beglichene der letzten 30 Tage anzeigen"
                          IsChecked="{Binding BeglicheneLetzte30TageAnzeigen}"
                          VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Leerer Zustand: Icon + Text statt des bisherigen grauen,
             kursiven Einzeilers (UI/UX-Redesign, Abschnitt 2.7). -->
        <StackPanel DockPanel.Dock="Top" Classes="empty-state" Spacing="8"
                    IsVisible="{Binding KeineEintraege}" Margin="0,32">
            <Path Data="{DynamicResource IconOffenePosten}"
                  Width="{anzeige:Breite 40}" Height="{anzeige:Breite 40}"
                  Stretch="Uniform" StrokeThickness="1.5"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}"
                  HorizontalAlignment="Center" />
            <TextBlock Text="Keine offenen Posten."
                       Foreground="{DynamicResource TextSekundaerFarbe}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ============ Kopfzeile und Tabelle ============
             Beides in einem waagerechten Bildlauf: bei den grossen
             Schriftstufen summieren sich die festen Spalten auf mehr, als
             das Fenster breit ist, und ohne ihn waeren die Schaltflaechen
             der letzten Spalte nicht mehr erreichbar. Aeusserer Bildlauf
             waagerecht, innerer senkrecht - dasselbe Muster wie in der
             Ausgabenliste.

             Die feste Breite aus dem Bildlauffeld ist noetig, damit die
             Sternspalte eine Sternspalte bleibt: ohne sie misst der
             waagerechte Bildlauf seinen Inhalt mit unbegrenzter Breite,
             und eine lange Bemerkung wuerde die Spalten dahinter nach
             rechts schieben. Die MinWidth ist die Summe der uebrigen
             Spalten (698) plus rund 140 Pixel Rest fuer die Bemerkung;
             die einstellbare Kategoriebreite kommt hinzu. -->
        <ScrollViewer x:Name="Waagerecht"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
        <DockPanel Width="{Binding #Waagerecht.Viewport.Width}"
                   MinWidth="{anzeige:BreitePlusKategorie 840}">
        <!-- Breite aus der Zeilenliste statt geschaetzter Bildlaufleiste -
             siehe die gleichlautende Stelle in PersonenView. -->
        <Border DockPanel.Dock="Top"
                Width="{Binding #Zeilenliste.Bounds.Width}"
                HorizontalAlignment="Left"
                IsVisible="{Binding !KeineEintraege}"
                Padding="4,0,4,4">
            <Grid anzeige:Raster.Spalten="32,90,16,Kategorie,16,110,24,*,16,100,24,270">
                <TextBlock Grid.Column="0" />
                <Button Grid.Column="1" Classes="kopf" Content="{Binding DatumHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Datum" />
                <Button Grid.Column="3" Classes="kopf" Content="{Binding KategorieHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Kategorie" />

                <!-- Griff auf der Trennlinie hinter der Kategorie -->
                <anzeige:Spaltengriff Grid.Column="4"
                                      ToolTip.Tip="Breite der Kategoriespalte ziehen" />

                <Button Grid.Column="5" Classes="kopf zahl" Content="{Binding BetragHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Betrag" />
                <Button Grid.Column="7" Classes="kopf" Content="{Binding BemerkungHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="Bemerkung" />
                <Button Grid.Column="9" Classes="kopf mitte" Content="{Binding TageOffenHeaderText}"
                        Command="{Binding SpalteSortierenCommand}" CommandParameter="TageOffen" />
                <Button Grid.Column="11" Content="Aktionen" Classes="tabellenkopf-aktion" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl x:Name="Zeilenliste" ItemsSource="{Binding Gruppen}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonenGruppe">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding PersonName}" Classes="ueberschrift" Margin="0,8,0,4" />

                            <ItemsControl ItemsSource="{Binding Zeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OffenerPostenZeile">
                                        <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <StackPanel>
                                                <Grid anzeige:Raster.Spalten="32,90,16,Kategorie,16,110,24,*,16,100,24,270">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IstAusgewaehlt}"
                                                              IsVisible="{Binding !IstBeglichen}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DatumText}"
                                                               Classes="tabellenzelle"
                                                               Classes.beglichen="{Binding IstBeglichen}" />
                                                    <anzeige:Textzelle Grid.Column="3"
                                                                       Inhalt="{Binding CategoryFullPath}"
                                                                       Kuerzung="Vorne"
                                                                       Classes="tabellenzelle"
                                                                       Classes.beglichen="{Binding IstBeglichen}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding BetragText}"
                                                               Classes="tabellenzelle zahl"
                                                               Classes.offen="{Binding IstOffen}"
                                                               Classes.einnahme="{Binding IstBeglicheneEinnahme}"
                                                               Classes.beglichen-ausgabe="{Binding IstBeglichenAusgabe}"
                                                               Classes.beglichen="{Binding IstBeglichen}" />
                                                    <anzeige:Textzelle Grid.Column="7" Inhalt="{Binding Note}"
                                                                       Classes="tabellenzelle"
                                                                       Classes.beglichen="{Binding IstBeglichen}" />
                                                    <TextBlock Grid.Column="9" Text="{Binding TageOffen}"
                                                               Classes="tabellenzelle mitte"
                                                               Classes.beglichen="{Binding IstBeglichen}" />

                                                    <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding !IstBeglichen}">
                                                        <Button Classes="secondary klein" Content="{Binding AbhakenButtonText}"
                                                                ToolTip.Tip="{Binding AbhakenToolTip}"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbhakenCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="ghost klein" Content="Datum…"
                                                                ToolTip.Tip="Mit abweichendem Datum abhaken"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumOeffnenCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <!-- Nebeneinander und nicht untereinander:
                                                         eine zweizeilige Zelle machte die
                                                         beglichenen Zeilen hoeher als die
                                                         offenen daneben. -->
                                                    <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="6"
                                                                IsVisible="{Binding IstBeglichen}">
                                                        <TextBlock Text="{Binding BeglichenText}"
                                                                   FontStyle="Italic" Foreground="{DynamicResource TextTertiaerFarbe}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Classes="ghost klein" Content="Rückgängig"
                                                                ToolTip.Tip="Begleichung rückgängig machen"
                                                                Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).RueckgaengigZeileCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Eingabe eines abweichenden Begleichungsdatums -->
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            Margin="32,6,0,0"
                                                            IsVisible="{Binding WaehltAbweichendesDatum}">
                                                    <TextBox Text="{Binding AbweichendesDatumText}"
                                                             Width="{anzeige:Breite 110}"
                                                             PlaceholderText="TT.MM.JJJJ" />
                                                    <Button Classes="secondary klein" Content="Übernehmen"
                                                            Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumUebernehmenCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="ghost klein" Content="Abbrechen"
                                                            Command="{Binding #Wurzel.((vm:OffenePostenViewModel)DataContext).AbweichendesDatumAbbrechenCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding AbweichendesDatumFehler}"
                                                               IsVisible="{Binding AbweichendesDatumFehlerSichtbar}"
                                                               Classes="fehler"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bleibt neutral, wie die Gesamtsumme oben. -->
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Margin="0,4,20,0"
                                       Text="{Binding ZwischensummeText, StringFormat='Zwischensumme: {0}'}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </DockPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
