<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.DarstellungView"
             x:DataType="vm:DarstellungViewModel">

    <UserControl.Styles>
        <Style Selector="Border.kasten">
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16">
            <Border Classes="kasten">
                <StackPanel Spacing="8">
                    <TextBlock Text="Schriftgröße" Classes="ueberschrift" />

                    <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Foreground="Gray" />

                    <!-- Die Einstellung ließ sich nicht dauerhaft merken.
                         Ein Hinweis, kein Dialog: die Schriftgröße wirkt
                         ja bereits. -->
                    <Border IsVisible="{Binding SpeicherHinweisSichtbar}"
                            Background="#FFF6DF" BorderBrush="#E0C070" BorderThickness="1"
                            Padding="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SpeicherHinweis}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Auswahlknoepfe statt einer Auswahlliste: alle vier
                         Stufen stehen gleichzeitig da, und die Beschriftung
                         jeder Stufe ist bereits in der neuen Groesse
                         geschrieben - man sieht also, was man waehlt,
                         bevor man es waehlt. -->
                    <ItemsControl ItemsSource="{Binding Stufen}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchriftgroesseOption">
                                <RadioButton GroupName="Schriftgroesse"
                                             IsChecked="{Binding IstAusgewaehlt, Mode=TwoWay}"
                                             Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Bezeichnung}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FaktorText}"
                                                   Classes="klein"
                                                   Foreground="Gray"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Probezeile: zeigt alle drei Groessen der Oberflaeche
                 nebeneinander, damit die Wirkung ohne Bereichswechsel
                 sichtbar ist. -->
            <Border Classes="kasten">
                <StackPanel Spacing="6">
                    <TextBlock Text="So sieht es aus" Classes="ueberschrift" />
                    <TextBlock Text="Fließtext, Tabellen und Schaltflächen." />
                    <TextBlock Text="Kleine Nebentexte wie Feldbeschriftungen."
                               Classes="klein" Foreground="Gray" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Schaltfläche" IsHitTestVisible="False" />
                        <TextBox Text="Eingabefeld" IsReadOnly="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
