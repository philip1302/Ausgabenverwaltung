<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.DarstellungView"
             x:DataType="vm:DarstellungViewModel">

    <UserControl.Styles>
        <!-- Eine Themen-Kachel: die aeussere Border traegt die Kastenoptik
             (RadioButton selbst hat dafuer keine Border-Eigenschaften im
             Standardtemplate), Akzentrahmen im ausgewaehlten Zustand -
             dasselbe Muster wie mockups/10-verwaltung-darstellung.png. -->
        <Style Selector="Border.thema-kachel">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDezentFarbe}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceFarbe}" />
        </Style>
        <Style Selector="Border.thema-kachel.aktiv">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFarbe}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="32,24">
        <TextBlock DockPanel.Dock="Top" Classes="seitentitel"
                   Text="Darstellung" Margin="0,0,0,20" />

        <ScrollViewer>
            <StackPanel Spacing="16">
            <Border Classes="karte">
                <StackPanel Spacing="8">
                    <TextBlock Text="Thema" Classes="ueberschrift" />
                    <TextBlock Text="{Binding ThemaHinweis}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaerFarbe}" />

                    <ItemsControl ItemsSource="{Binding ThemaOptionen}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemaOption">
                                <Border Classes="thema-kachel" Classes.aktiv="{Binding IstAusgewaehlt}"
                                        Width="{anzeige:Breite 120}">
                                    <RadioButton GroupName="Thema"
                                                 HorizontalAlignment="Center"
                                                 IsChecked="{Binding IstAusgewaehlt, Mode=TwoWay}">
                                        <TextBlock Text="{Binding Bezeichnung}" />
                                    </RadioButton>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="karte">
                <StackPanel Spacing="8">
                    <TextBlock Text="Schriftgröße" Classes="ueberschrift" />

                    <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaerFarbe}" />

                    <!-- Die Einstellung ließ sich nicht dauerhaft merken.
                         Ein Hinweis, kein Dialog: die Schriftgröße wirkt
                         ja bereits. -->
                    <Border IsVisible="{Binding SpeicherHinweisSichtbar}"
                            Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                            Padding="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SpeicherHinweis}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Auswahlknoepfe statt einer Auswahlliste: alle vier
                         Stufen stehen gleichzeitig da, und die Beschriftung
                         jeder Stufe ist bereits in der neuen Groesse
                         geschrieben - man sieht also, was man waehlt,
                         bevor man es waehlt. -->
                    <ItemsControl ItemsSource="{Binding Stufen}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchriftgroesseOption">
                                <RadioButton GroupName="Schriftgroesse"
                                             IsChecked="{Binding IstAusgewaehlt, Mode=TwoWay}"
                                             Margin="0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Bezeichnung}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FaktorText}"
                                                   Classes="klein"
                                                   Foreground="{DynamicResource TextTertiaerFarbe}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Selbstaktualisierung. Der Text am Kaestchen sagt, was
                 tatsaechlich passiert - ein blosses "Automatische
                 Updates" liesse offen, ob dabei etwas gesendet wird. -->
            <Border Classes="karte">
                <StackPanel Spacing="6">
                    <TextBlock Text="Aktualisierung" Classes="ueberschrift" />
                    <CheckBox Content="Beim Programmstart nach einer neuen Fassung sehen"
                              IsChecked="{Binding AktualisierungAutomatisch, Mode=TwoWay}" />
                    <TextBlock Classes="klein"
                               Foreground="{DynamicResource TextTertiaerFarbe}"
                               TextWrapping="Wrap"
                               Text="Dabei wird die Veröffentlichungsseite des Projekts abgerufen. Eine gefundene Fassung wird geladen und beim nächsten Start übernommen; Buchungen und Sicherungen bleiben davon unberührt." />
                </StackPanel>
            </Border>

            <!-- Probezeile: zeigt alle drei Groessen der Oberflaeche
                 nebeneinander, damit die Wirkung ohne Bereichswechsel
                 sichtbar ist. -->
            <Border Classes="karte">
                <StackPanel Spacing="6">
                    <TextBlock Text="So sieht es aus" Classes="ueberschrift" />
                    <TextBlock Text="Fließtext, Tabellen und Schaltflächen." />
                    <TextBlock Text="Kleine Nebentexte wie Feldbeschriftungen."
                               Classes="klein" Foreground="{DynamicResource TextTertiaerFarbe}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Schaltfläche" IsHitTestVisible="False" />
                        <TextBox Text="Eingabefeld" IsReadOnly="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
