<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.DatensicherungView"
             x:Name="Wurzel"
             x:DataType="vm:DatensicherungViewModel">

    <!-- Aufbau der Seite: Zustand zuerst, EINE Aussage.
         ┌──────────────────────────────────────────────┐
         │ ●  <Überschrift>                             │  aus BackupHealth
         │    <Zeitangabe über beide Ziele>             │  berechnet, nicht
         │    <Was das bedeutet, was zu tun ist>        │  hier
         │                          [ Jetzt sichern ]   │
         └──────────────────────────────────────────────┘
           Ziele          (Karte, je Ziel EINE Zeile)
           Sicherungen    (Karte, je Zeile ein „Prüfen“)
           ▸ Hilfe        (Expander, im Normalfall zu)

         Vorher trugen Banner, Meldungsband, zwei Statustexte und zwei
         verschieden gebaute Fehlerkaesten Teilaussagen nebeneinander.
         Jetzt gibt es genau eine Zustandskarte, eine Bauform je Ziel und
         genau EINEN Meldungsweg.

         Sicherungen sind hoechstens ein paar Dutzend, deshalb bewusst
         ScrollViewer + ItemsControl statt einer virtualisierenden ListBox. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.abschnitt">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Farben bewusst hier und nicht als Attribut am Element: ein
             direkt gesetzter Wert schlaegt jeden Style, die Umschaltung
             auf .fehler griffe dann nie. Aus demselben Grund haben die
             beiden frueheren Inline-Fehlerkaesten dieser Seite keine
             Nachfolger - ihr Inhalt steht jetzt in der Zielzeile. -->
        <Style Selector="TextBlock.zielzeit">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaerFarbe}" />
        </Style>
        <Style Selector="TextBlock.pruefmerkmal">
            <Setter Property="FontSize" Value="{DynamicResource SchriftKlein}" />
            <Setter Property="Foreground" Value="{DynamicResource ErfolgText}" />
        </Style>
        <Style Selector="TextBlock.pruefmerkmal.fehler">
            <Setter Property="Foreground" Value="{DynamicResource WarnungText}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- ============ Zustand ============
             Die einzige Statusaussage der Seite. Der Punkt ist Zusatz zum
             Text, nicht sein Ersatz - die Ueberschrift daneben sagt
             dasselbe in Worten. -->
        <Border DockPanel.Dock="Top" Classes="zustandskarte" Margin="0,0,0,12"
                Classes.gut="{Binding ZustandGut}"
                Classes.eingeschraenkt="{Binding ZustandEingeschraenkt}"
                Classes.schlecht="{Binding ZustandSchlecht}">
            <Grid ColumnDefinitions="Auto,12,*,16,Auto">
                <Ellipse Grid.Column="0" Classes="statuspunkt"
                         Classes.gut="{Binding ZustandGut}"
                         Classes.eingeschraenkt="{Binding ZustandEingeschraenkt}"
                         Classes.schlecht="{Binding ZustandSchlecht}"
                         VerticalAlignment="Top" Margin="0,6,0,0" />

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{Binding ZustandUeberschrift}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource SchriftUeberschrift}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ZustandZeitangabe}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ZustandText}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="4" Classes="primary" Content="Jetzt sichern"
                        VerticalAlignment="Top"
                        Command="{Binding SicherungJetztCommand}"
                        ToolTip.Tip="Sichert sofort, unabhängig davon, ob heute schon gesichert wurde." />
            </Grid>
        </Border>

        <!-- ============ Band: Meldung ============
             Der EINZIGE Meldungsweg. Was dauerhaft gilt, steht in der
             Zustandskarte bzw. der Zielzeile; hier steht nur, was gerade
             auf eine Handlung hin passiert ist. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding MeldungSichtbar}"
                Classes="banner"
                Classes.fehler="{Binding MeldungIstFehler}"
                Classes.erfolg="{Binding !MeldungIstFehler}"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding MeldungText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Schliessen"
                        Command="{Binding MeldungSchliessenCommand}" />
            </Grid>
        </Border>

        <!-- ============ Band: Rueckgaengig ============
             Reibung nach Schadensausmass: das Entfernen des zweiten Ziels
             loescht nichts und ist umkehrbar, ein Bestaetigungsdialog
             waere zu viel. Das Band bleibt fuer die Dauer der Sitzung. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding RueckgaengigSichtbar}"
                Classes="banner hinweis"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="{Binding RueckgaengigText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Content="Rückgängig"
                        Command="{Binding ZweitesZielWiederherstellenCommand}" />
                <Button Grid.Column="3" Classes="ghost" Content="Schliessen"
                        Command="{Binding RueckgaengigSchliessenCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="16">

                <!-- ============ Ziele ============
                     Je Ziel EINE Zeile in derselben Bauform: Punkt, Name,
                     Zeitpunkt, gekuerzter Pfad, Aktionen. Der volle Pfad
                     steht im Hilfetext und hinter den Knoepfen - als
                     Dauerinhalt in Monospace hat er die wichtigen Zeilen
                     verdraengt. -->
                <Border Classes="karte">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ziele" Classes="abschnitt" />

                        <!-- Ziel 1 -->
                        <Grid anzeige:Raster.Spalten="Auto,10,180,16,*,16,Auto"
                              Margin="0,4">
                            <Ellipse Grid.Column="0" Classes="statuspunkt"
                                     Classes.gut="{Binding Ziel1.PunktGut}"
                                     Classes.eingeschraenkt="{Binding Ziel1.PunktEingeschraenkt}"
                                     Classes.schlecht="{Binding Ziel1.PunktSchlecht}" />
                            <TextBlock Grid.Column="2" Text="{Binding Ziel1.Name}"
                                       Classes="tabellenzelle"
                                       ToolTip.Tip="Läuft immer und braucht keine Einrichtung. Beim Programmstart wird höchstens einmal pro Tag gesichert." />
                            <TextBlock Grid.Column="4" Text="{Binding Ziel1.ZeitpunktText}"
                                       Classes="tabellenzelle zielzeit" />
                            <!-- Der volle Pfad steckt hinter diesen beiden
                                 Eintraegen und im Hilfetext - als
                                 Dauerinhalt in Monospace hat er vorher
                                 die wichtigen Zeilen verdraengt. -->
                            <Button Grid.Column="6" Classes="ghost klein" Content="⋯"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="Pfad kopieren, Ordner öffnen">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Pfad kopieren"
                                                  Click="Ziel1PfadKopieren_Click" />
                                        <MenuItem Header="Ordner öffnen"
                                                  Click="SicherungsordnerOeffnen_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Ziel1.PfadKurz}" Classes="zielzeit"
                                   FontSize="{DynamicResource SchriftKlein}"
                                   ToolTip.Tip="{Binding Ziel1.Pfad}"
                                   Margin="22,0,0,4" />
                        <Border IsVisible="{Binding Ziel1.ProblemSichtbar}"
                                Classes="banner warnung" Margin="22,0,0,8">
                            <TextBlock Text="{Binding Ziel1.ProblemText}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Ziel 2 -->
                        <Grid anzeige:Raster.Spalten="Auto,10,180,16,*,16,Auto"
                              Margin="0,4">
                            <Ellipse Grid.Column="0" Classes="statuspunkt"
                                     Classes.gut="{Binding Ziel2.PunktGut}"
                                     Classes.eingeschraenkt="{Binding Ziel2.PunktEingeschraenkt}"
                                     Classes.schlecht="{Binding Ziel2.PunktSchlecht}" />
                            <TextBlock Grid.Column="2" Text="{Binding Ziel2.Name}"
                                       Classes="tabellenzelle"
                                       ToolTip.Tip="Ein beliebiger Ordner — ob dahinter ein Cloud-Ordner, ein USB-Stick oder ein Netzlaufwerk steckt, spielt keine Rolle. Beim Auswählen wird einmal testweise geschrieben, damit fehlende Berechtigungen sofort auffallen. Ist das Ziel beim Start nicht erreichbar, läuft die Anwendung ohne Meldung weiter." />
                            <TextBlock Grid.Column="4" Text="{Binding Ziel2.ZeitpunktText}"
                                       Classes="tabellenzelle zielzeit" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary klein" Content="Ordner wählen..."
                                        Click="ZweitesZielWaehlen_Click" />
                                <Button Classes="ghost klein" Content="Entfernen"
                                        IsVisible="{Binding Ziel2.IstEingerichtet}"
                                        Command="{Binding ZweitesZielEntfernenCommand}" />
                                <Button Classes="ghost klein" Content="⋯"
                                        IsVisible="{Binding Ziel2.IstEingerichtet}"
                                        ToolTip.Tip="Pfad kopieren, Ordner öffnen">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Pfad kopieren"
                                                      Click="Ziel2PfadKopieren_Click" />
                                            <MenuItem Header="Ordner öffnen"
                                                      Click="Ziel2OrdnerOeffnen_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Ziel2.PfadKurz}" Classes="zielzeit"
                                   FontSize="{DynamicResource SchriftKlein}"
                                   IsVisible="{Binding Ziel2.PfadVorhanden}"
                                   ToolTip.Tip="{Binding Ziel2.Pfad}"
                                   Margin="22,0,0,4" />
                        <Border IsVisible="{Binding Ziel2.ProblemSichtbar}"
                                Classes="banner warnung" Margin="22,0,0,8">
                            <TextBlock Text="{Binding Ziel2.ProblemText}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Der eine Satz, der erklaert, warum das zweite
                             Ziel ueberhaupt da ist - eingeklappt, weil er
                             nach dem ersten Lesen nichts mehr beitraegt. -->
                        <Expander Header="Kein zweites Ziel? Dann liegt alles auf einer Platte."
                                  IsVisible="{Binding !Ziel2.IstEingerichtet}">
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Sicherungen auf demselben Rechner helfen gegen versehentliches Löschen und gegen eine beschädigte Datei — nicht aber gegen einen Defekt der Platte, einen Diebstahl oder einen Wasserschaden. Ein zweiter Ordner auf einem USB-Stick, einem Netzlaufwerk oder in einem Cloud-Ordner deckt genau diesen Fall ab." />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ============ Vorhandene Sicherungen ============
                     Neu: jede Zeile laesst sich pruefen. Eine Sicherung
                     ist nur so viel wert wie ihre Wiederherstellbarkeit -
                     eine Liste von Dateinamen belegt gar nichts. -->
                <Border Classes="karte">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Sicherungen" Classes="abschnitt"
                                       ToolTip.Tip="Behalten werden die letzten zehn Sicherungen und zusätzlich, dauerhaft, die jeweils letzte Sicherung jedes Monats. Alles andere wird beim nächsten Lauf gelöscht." />
                            <TextBlock Grid.Column="1" Text="{Binding AnzahlText}"
                                       Foreground="{DynamicResource TextTertiaerFarbe}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Noch keine Sicherung vorhanden. „Jetzt sichern“ erstellt die erste."
                                   IsVisible="{Binding KeineSicherungen}"
                                   Foreground="{DynamicResource TextTertiaerFarbe}" FontStyle="Italic" Margin="0,8" />

                        <!-- Spaltenraster gilt fuer Kopfzeile UND Zeilen:
                             Dateiname, Datum, Groesse, Aktion. Dazwischen
                             feste Gutter-Spalten (ungerade Indizes), damit
                             die Spaltengrenzen exakt aufeinander fallen. -->
                        <Grid anzeige:Raster.Spalten="*,16,150,16,100,16,90" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="Datei"   Classes="tabellenkopf" />
                            <TextBlock Grid.Column="2" Text="Datum"   Classes="tabellenkopf" />
                            <TextBlock Grid.Column="4" Text="Größe"   Classes="tabellenkopf zahl" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sicherungen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SicherungZeile">
                                    <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel Spacing="2">
                                            <Grid anzeige:Raster.Spalten="*,16,150,16,100,16,90">
                                                <!-- Einzeilig und notfalls gekuerzt, damit ein
                                                     langer Dateiname weder umbricht noch die
                                                     Spalten dahinter verschiebt. -->
                                                <anzeige:Textzelle Grid.Column="0" Inhalt="{Binding Dateiname}"
                                                                   Classes="tabellenzelle" />
                                                <TextBlock Grid.Column="2" Text="{Binding DatumText}"
                                                           Classes="tabellenzelle" />
                                                <TextBlock Grid.Column="4" Text="{Binding GroesseText}"
                                                           Classes="tabellenzelle zahl" />
                                                <Button Grid.Column="6" Classes="secondary klein" Content="Prüfen"
                                                        HorizontalAlignment="Right"
                                                        ToolTip.Tip="Entpackt die Sicherung, öffnet die Datenbank darin und zählt die Buchungen — ohne die aktiven Daten anzufassen."
                                                        Command="{Binding #Wurzel.((vm:DatensicherungViewModel)DataContext).SicherungPruefenCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                            <TextBlock Text="{Binding PruefungText}"
                                                       IsVisible="{Binding PruefungSichtbar}"
                                                       Classes="pruefmerkmal"
                                                       Classes.fehler="{Binding PruefungIstFehler}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Hilfe ============
                     Selten Gebrauchtes eingeklappt: die Anleitung zum
                     Wiederherstellen und die Pfade. Beides wird im
                     Normalfall nie gebraucht und belegte vorher als
                     eigene Karte dauerhaft Platz. -->
                <Border Classes="karte">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hilfe" Classes="abschnitt" />

                        <Expander Header="Wie stelle ich eine Sicherung wieder her?">
                            <TextBlock Text="{Binding WiederherstellungHinweis}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>

                        <Expander Header="Wo liegen meine Dateien?">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="Aktive Datenbank" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DatenbankPfad}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="secondary klein" Content="Pfad kopieren"
                                            Click="DatenbankPfadKopieren_Click" />
                                    <!-- Geoeffnet wird der ORDNER, nicht die
                                         Datei. Beschriftung bewusst ohne
                                         "Explorer": unter macOS heisst
                                         dasselbe Finder. -->
                                    <Button Grid.Column="4" Classes="secondary klein" Content="Ordner öffnen"
                                            ToolTip.Tip="Öffnet den Ordner der aktiven Datenbank im Dateimanager."
                                            Click="DatenbankOrdnerOeffnen_Click" />
                                </Grid>

                                <TextBlock Text="Protokoll" FontWeight="SemiBold"
                                           IsVisible="{Binding ProtokollordnerVerfuegbar}"
                                           Margin="0,8,0,0" />
                                <Grid ColumnDefinitions="*,8,Auto"
                                      IsVisible="{Binding ProtokollordnerVerfuegbar}">
                                    <TextBlock Grid.Column="0" Text="{Binding ProtokollordnerPfad}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="secondary klein" Content="Ordner öffnen"
                                            Click="ProtokollordnerOeffnen_Click"
                                            ToolTip.Tip="Enthält das Protokoll der letzten 30 Tage — Programmstarts, Sicherungen, Fehler. Es enthält keine Beträge, Bemerkungen oder Namen und lässt sich deshalb weitergeben." />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
