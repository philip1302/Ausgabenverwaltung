<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.DatensicherungView"
             x:Name="Wurzel"
             x:DataType="vm:DatensicherungViewModel">

    <!-- Spaltenraster "*,16,150,16,100" gilt fuer Kopfzeile UND Zeilen:
         Dateiname, Datum, Groesse. Dazwischen feste Gutter-Spalten
         (ungerade Indizes), damit die Spaltengrenzen exakt aufeinander
         fallen - dasselbe Muster wie in VorlagenView und PersonenView.
         Sicherungen sind hoechstens ein paar Dutzend, deshalb bewusst
         ScrollViewer + ItemsControl statt einer virtualisierenden ListBox. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.abschnitt">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.pfad">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Farben bewusst hier und nicht als Attribut am Element: ein
             direkt gesetzter Wert schlaegt jeden Style, die Umschaltung
             auf .fehler bzw. .veraltet griffe dann nie. -->
        <Style Selector="Border.meldung">
            <Setter Property="Background" Value="{DynamicResource ErfolgFlaeche}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErfolgRahmen}" />
        </Style>
        <Style Selector="Border.meldung.fehler">
            <Setter Property="Background" Value="{DynamicResource WarnungFlaeche}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnungRahmen}" />
        </Style>

        <!-- "Dezent hervorheben" bei laenger zurueckliegender externer
             Sicherung: derselbe Text, nur nicht mehr in Grau. -->
        <Style Selector="TextBlock.zielstatus">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaerFarbe}" />
        </Style>
        <Style Selector="TextBlock.zielstatus.veraltet">
            <Setter Property="Foreground" Value="{DynamicResource WarnungText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- ============ Status der externen Sicherung ============
             Ganz oben als Banner statt einer separaten Textzeile
             (UI/UX-Redesign, Abschnitt 5.8): die wichtigste Frage der
             Seite ("bin ich gerade abgesichert?") faellt so zuerst auf. -->
        <Border DockPanel.Dock="Top" Classes="banner" Margin="0,0,0,12"
                Classes.erfolg="{Binding ExterneSicherungIstAktuell}"
                Classes.warnung="{Binding ExterneSicherungIstVeraltet}"
                Classes.hinweis="{Binding ExterneSicherungFehlt}">
            <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="Externe Sicherung aktuell" IsVisible="{Binding ExterneSicherungIstAktuell}" />
                <TextBlock FontWeight="SemiBold" Text="Externe Sicherung veraltet" IsVisible="{Binding ExterneSicherungIstVeraltet}" />
                <TextBlock FontWeight="SemiBold" Text="Kein zweites Sicherungsziel" IsVisible="{Binding ExterneSicherungFehlt}" />
                <TextBlock Text="{Binding ExterneSicherungBannerText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ Werkzeugleiste ============ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                    Margin="0,0,0,8">
            <Button Classes="primary" Content="Sicherung jetzt"
                    Command="{Binding SicherungJetztCommand}"
                    ToolTip.Tip="Sichert sofort, unabhängig davon, ob heute schon gesichert wurde." />
            <Button Classes="secondary" Content="Sicherungsordner öffnen"
                    Click="SicherungsordnerOeffnen_Click" />
            <Button Classes="secondary" Content="Protokollordner öffnen"
                    IsVisible="{Binding ProtokollordnerVerfuegbar}"
                    Click="ProtokollordnerOeffnen_Click"
                    ToolTip.Tip="Enthält das Protokoll der letzten 30 Tage — Programmstarts, Sicherungen, Fehler. Es enthält keine Beträge, Bemerkungen oder Namen und lässt sich deshalb weitergeben." />
        </StackPanel>

        <!-- ============ Band: Meldung ============ -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding MeldungSichtbar}"
                Classes="banner"
                Classes.fehler="{Binding MeldungIstFehler}"
                Classes.erfolg="{Binding !MeldungIstFehler}"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding MeldungText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Schliessen"
                        Command="{Binding MeldungSchliessenCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="16">

                <!-- ============ Ziel 1 ============
                     Die dauerhafte Erklaerung dazu ("laeuft immer, braucht
                     keine Einrichtung") steht nicht mehr fest im Bild,
                     sondern als Hilfetext an der Ueberschrift. -->
                <Border Classes="karte">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ziel 1 — dieser Rechner" Classes="abschnitt"
                                   ToolTip.Tip="Läuft immer und braucht keine Einrichtung. Beim Programmstart wird höchstens einmal pro Tag gesichert." />
                        <TextBlock Text="{Binding SicherungsordnerPfad}" Classes="pfad" />
                        <TextBlock Text="{Binding Ziel1StatusText}" Foreground="{DynamicResource TextTertiaerFarbe}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <!-- Eine beim Start gescheiterte Sicherung hält den
                             Start nicht auf — sichtbar bleiben muss sie
                             trotzdem, und zwar hier und dauerhaft, nicht
                             nur als wegklickbares Band im Hauptfenster. -->
                        <Border IsVisible="{Binding Ziel1FehlerSichtbar}"
                                Background="{DynamicResource FehlerFlaeche}" BorderBrush="{DynamicResource FehlerRahmen}" BorderThickness="1"
                                Padding="8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Ziel1FehlerText}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Ziel 2 ============ -->
                <Border Classes="karte">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ziel 2 — zusätzlicher Ordner (optional)" Classes="abschnitt"
                                   ToolTip.Tip="Ein beliebiger Ordner — ob dahinter ein Cloud-Ordner, ein USB-Stick oder ein Netzlaufwerk steckt, spielt keine Rolle. Beim Auswählen wird einmal testweise geschrieben, damit fehlende Berechtigungen sofort auffallen. Ist das Ziel beim Start nicht erreichbar, läuft die Anwendung ohne Meldung weiter." />

                        <TextBlock Text="{Binding Ziel2Pfad}" Classes="pfad"
                                   IsVisible="{Binding Ziel2Eingerichtet}" />

                        <!-- Der Alterungshinweis ist der einzige Ort, an dem
                             ein dauerhaft nicht erreichbares zweites Ziel
                             auffaellt - beim Start wird es still uebergangen. -->
                        <TextBlock Text="{Binding Ziel2StatusText}"
                                   Classes="zielstatus"
                                   Classes.veraltet="{Binding Ziel2Veraltet}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <!-- Ein nicht erreichbares zweites Ziel: eigener
                             Text, ruhiger im Ton — Ziel 1 hat ja
                             funktioniert, es fehlt nur die Kopie. -->
                        <Border IsVisible="{Binding Ziel2FehlerSichtbar}"
                                Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                Padding="8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Ziel2FehlerText}" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Classes="secondary" Content="Ordner wählen..." Click="ZweitesZielWaehlen_Click" />
                            <Button Classes="ghost" Content="Ziel entfernen"
                                    IsVisible="{Binding Ziel2Eingerichtet}"
                                    Command="{Binding ZweitesZielEntfernenCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Wiederherstellen ============
                     Die Anleitung steht nicht mehr dauerhaft im Bild,
                     sondern eingeklappt - verfuegbar, wenn sie gebraucht
                     wird, sonst nicht im Weg. -->
                <Border Classes="karte">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Wiederherstellen" Classes="abschnitt" />
                        <Expander Header="Anleitung anzeigen">
                            <TextBlock Text="{Binding WiederherstellungHinweis}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>

                        <TextBlock Text="Aktive Datenbank:" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding DatenbankPfad}"
                                       Classes="pfad" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="secondary" Content="Pfad kopieren"
                                    Click="DatenbankPfadKopieren_Click" />
                            <!-- Der zweite Schritt der Anleitung oben ist
                                 "Datei an den Ort der aktiven Datenbank
                                 kopieren" - genau dorthin fuehrt dieser
                                 Knopf, statt den Pfad von Hand nachzugehen.
                                 Beschriftung bewusst ohne "Explorer": unter
                                 macOS heisst dasselbe Finder. -->
                            <Button Grid.Column="4" Classes="secondary" Content="Ordner öffnen"
                                    ToolTip.Tip="Öffnet den Ordner der aktiven Datenbank im Dateimanager."
                                    Click="DatenbankOrdnerOeffnen_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Vorhandene Sicherungen ============ -->
                <Border Classes="karte">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Vorhandene Sicherungen" Classes="abschnitt"
                                       ToolTip.Tip="Behalten werden die letzten zehn Sicherungen und zusätzlich, dauerhaft, die jeweils letzte Sicherung jedes Monats. Alles andere wird beim nächsten Lauf gelöscht." />
                            <TextBlock Grid.Column="1" Text="{Binding AnzahlText}"
                                       Foreground="{DynamicResource TextTertiaerFarbe}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Noch keine Sicherung vorhanden. „Sicherung jetzt“ erstellt die erste."
                                   IsVisible="{Binding KeineSicherungen}"
                                   Foreground="{DynamicResource TextTertiaerFarbe}" FontStyle="Italic" Margin="0,8" />

                        <Grid anzeige:Raster.Spalten="*,16,150,16,100" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Text="Datei"   Classes="tabellenkopf" />
                            <TextBlock Grid.Column="2" Text="Datum"   Classes="tabellenkopf" />
                            <TextBlock Grid.Column="4" Text="Größe"   Classes="tabellenkopf zahl" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sicherungen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SicherungZeile">
                                    <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid anzeige:Raster.Spalten="*,16,150,16,100">
                                            <!-- Einzeilig und notfalls gekuerzt, damit ein
                                                 langer Dateiname weder umbricht noch die
                                                 beiden Spalten dahinter verschiebt. -->
                                            <anzeige:Textzelle Grid.Column="0" Inhalt="{Binding Dateiname}"
                                                               Classes="tabellenzelle" />
                                            <TextBlock Grid.Column="2" Text="{Binding DatumText}"
                                                       Classes="tabellenzelle" />
                                            <TextBlock Grid.Column="4" Text="{Binding GroesseText}"
                                                       Classes="tabellenzelle zahl" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
