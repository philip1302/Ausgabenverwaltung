<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:categories="using:Ausgabenverwaltung.Core.Categories"
             xmlns:entities="using:Ausgabenverwaltung.Core.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.VorlagenView"
             x:Name="Wurzel"
             x:DataType="vm:VorlagenViewModel">

    <!-- Spaltenraster "2*,16,Kategorie,16,105,16,135,16,95,16,90,16,70,16,80,24,300"
         gilt fuer Kopfzeile UND Zeilen gleichermassen: Titel, Kategorie,
         Betrag, Rhythmus, Zahler, naechste Faelligkeit, erzeugte Buchungen,
         Status, Aktionen - dazwischen feste Gutter-Spalten als Abstandhalter
         (ungerade Indizes). Die Tabellen-Styles (TextBlock.tabellenkopf,
         .tabellenzelle, .archiviert, ...) kommen aus App.axaml.

         Alle Spalten sind fest oder anteilig, keine richtet sich nach
         ihrem Inhalt - die Gesamtbreite bleibt dadurch konstant. Titel,
         Kategorie, Rhythmus und Zahler sind anzeige:Textzelle: einzeilig,
         mit Auslassungspunkten gekuerzt und mit Hilfetext nur dort, wo
         wirklich etwas fehlt. Die Kategorie kuerzt vorne, damit der Name
         der Kategorie selbst stehen bleibt; alles uebrige hinten.

         Die Kategoriespalte traegt dieselbe einstellbare Breite wie in der
         Ausgabenliste und den Offenen Posten - eine gezogene Breite, die
         nur in einem Bereich gilt, waere schwer zu erklaeren.

         Die Betragsspalte ist 105 statt der urspruenglichen 85 Pixel
         breit: seit die Betraege das €-Zeichen tragen, braucht
         "-1.234,56 €" mehr Platz als vorher "1.234,56".

         Bewusst ScrollViewer + ItemsControl statt der virtualisierenden
         ListBox der Ausgabenliste: Vorlagen sind eine Handvoll, nicht
         tausende - dasselbe Muster wie in PersonenView. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.formularbeschriftung">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style Selector="TextBlock.hinweis">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel>
            <!-- ============ Werkzeugleiste ============ -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                        Margin="0,0,0,8">
                <Button Classes="primary" Content="Neue Vorlage" Command="{Binding NeueVorlageCommand}" />
                <Button Classes="secondary" Content="Jetzt erzeugen"
                        Command="{Binding JetztErzeugenCommand}"
                        ToolTip.Tip="Erzeugt alle bis heute fälligen Buchungen aller aktiven Vorlagen — dasselbe, was auch beim Programmstart läuft." />
            </StackPanel>

            <!-- ============ Band: Schreibfehler ============
                 Die Liste darunter bleibt unverändert stehen: was nicht
                 geschrieben wurde, wird auch nicht angezeigt. -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding SchreibFehlerSichtbar}"
                    Background="{DynamicResource FehlerFlaeche}" BorderBrush="{DynamicResource FehlerRahmen}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <Grid anzeige:Raster.Spalten="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SchreibFehlerText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Schließen"
                            VerticalAlignment="Top"
                            Command="{Binding SchreibFehlerSchliessenCommand}" />
                </Grid>
            </Border>

            <!-- ============ Band: Ergebnis der Erzeugung ============ -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding ErgebnisSichtbar}"
                    Background="{DynamicResource ErfolgFlaeche}" BorderBrush="{DynamicResource ErfolgRahmen}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ErgebnisText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Schliessen"
                                Command="{Binding ErgebnisSchliessenCommand}" />
                    </Grid>
                    <Expander Header="Details anzeigen"
                              IsVisible="{Binding ErgebnisHatZeilen}">
                        <ItemsControl ItemsSource="{Binding ErgebnisZeilen}" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ============ Band: Rueckstand beim Reaktivieren ============
                 GeneratedThrough bleibt beim Deaktivieren stehen. Ohne diese
                 Abfrage wuerde ein einziger Klick die gesamte Pause
                 nachbuchen. -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding ReaktivierungAnfrageAktiv}"
                    Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ReaktivierungAnfrageText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="Rückstand nachholen"
                                Command="{Binding ReaktivierungNachholenCommand}" />
                        <Button Classes="secondary" Content="Erst ab heute weiterlaufen"
                                Command="{Binding ReaktivierungAbHeuteCommand}" />
                        <Button Classes="ghost" Content="Abbrechen"
                                Command="{Binding ReaktivierungAbbrechenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Fusszeile ============ -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto"
                  Margin="4,10,20,0">
                <TextBlock Grid.Column="0" Text="{Binding AnzahlText}"
                           Foreground="{DynamicResource TextTertiaerFarbe}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" FontWeight="Bold"
                           ToolTip.Tip="Alle aktiven, nicht abgelaufenen Vorlagen auf Monatsbasis umgerechnet (jährlich durch zwölf, wöchentlich mit der mittleren Monatslänge)."
                           Classes.einnahme="{Binding MonatlicheBelastungIstEinnahme}"
                           Text="{Binding MonatlicheBelastungText, StringFormat='Monatliche Belastung: {0}'}" />
            </Grid>

            <!-- ============ Kopfzeile und Tabelle ============
                 Beides in einem waagerechten Bildlauf: die neun festen
                 Spalten dieser Tabelle summieren sich bei der Stufe
                 "Sehr groß" auf annaehernd zweitausend Pixel, mehr als
                 jedes Fenster hergibt. Aeusserer Bildlauf waagerecht,
                 innerer senkrecht - dasselbe Muster wie in ReportView.

                 Die feste Breite aus dem Bildlauffeld ist noetig, damit
                 die Sternspalte eine Sternspalte bleibt: ohne sie misst
                 der waagerechte Bildlauf seinen Inhalt mit unbegrenzter
                 Breite, und der Titel wuerde alle Spalten dahinter nach
                 rechts schieben. Die MinWidth ist die Summe der uebrigen
                 Spalten (1011) plus rund 150 Pixel Rest fuer den Titel;
                 die einstellbare Kategoriebreite kommt hinzu. -->
            <ScrollViewer x:Name="Waagerecht"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <DockPanel Width="{Binding #Waagerecht.Viewport.Width}"
                       MinWidth="{anzeige:BreitePlusKategorie 1160}">
            <!-- Die Breite kommt aus der Zeilenliste, statt ueber einen
                 rechten Rand die Bildlaufleiste zu schaetzen. Der Grund:
                 die Differenz zwischen geschaetzter und tatsaechlicher
                 Breite landet vollstaendig in den beiden 2*-Spalten, und
                 damit stehen ALLE Spalten ab der zweiten um einige Pixel
                 versetzt ueber ihren Werten. Mit gleicher Breite und
                 gleichem Innenabstand (hier Padding 4, in der Zeile das
                 Padding des Borders) fallen die Spaltengrenzen exakt
                 aufeinander. -->
            <Border DockPanel.Dock="Top"
                    Width="{Binding #Zeilenliste.Bounds.Width}"
                    HorizontalAlignment="Left"
                    Padding="4,0,4,4">
                <Grid anzeige:Raster.Spalten="2*,16,Kategorie,16,105,16,135,16,95,16,90,16,70,16,80,24,300">
                    <TextBlock Grid.Column="0"  Text="Titel"       Classes="tabellenkopf" />
                    <TextBlock Grid.Column="2"  Text="Kategorie"   Classes="tabellenkopf" />

                    <!-- Griff auf der Trennlinie hinter der Kategorie -->
                    <anzeige:Spaltengriff Grid.Column="3"
                                          ToolTip.Tip="Breite der Kategoriespalte ziehen" />
                    <TextBlock Grid.Column="4"  Text="Betrag"      Classes="tabellenkopf zahl" />
                    <TextBlock Grid.Column="6"  Text="Rhythmus"    Classes="tabellenkopf" />
                    <TextBlock Grid.Column="8"  Text="Zahler"      Classes="tabellenkopf" />
                    <TextBlock Grid.Column="10" Text="Nächste"     Classes="tabellenkopf" />
                    <TextBlock Grid.Column="12" Text="Erzeugt"     Classes="tabellenkopf mitte" />
                    <TextBlock Grid.Column="14" Text="Status"      Classes="tabellenkopf" />
                    <Button    Grid.Column="16" Content="Aktionen" Classes="tabellenkopf-aktion" />
                </Grid>
            </Border>

            <TextBlock Text="Noch keine Vorlagen angelegt. „Neue Vorlage“ legt die erste an."
                       IsVisible="{Binding KeineVorlagen}"
                       DockPanel.Dock="Top"
                       Foreground="{DynamicResource TextTertiaerFarbe}" FontStyle="Italic"
                       Margin="4,8" />

            <!-- ============ Tabelle ============ -->
            <ScrollViewer>
                <ItemsControl x:Name="Zeilenliste" ItemsSource="{Binding Zeilen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VorlageZeile">
                            <Border BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="0,0,0,1" Padding="4,6">
                                <Grid anzeige:Raster.Spalten="2*,16,Kategorie,16,105,16,135,16,95,16,90,16,70,16,80,24,300">
                                    <anzeige:Textzelle Grid.Column="0" Inhalt="{Binding Titel}"
                                                       Classes="tabellenzelle"
                                                       Classes.archiviert="{Binding !IstAktiv}" />
                                    <anzeige:Textzelle Grid.Column="2" Inhalt="{Binding CategoryFullPath}"
                                                       Kuerzung="Vorne"
                                                       Classes="tabellenzelle"
                                                       Classes.archiviert="{Binding !IstAktiv}" />
                                    <TextBlock Grid.Column="4" Text="{Binding BetragText}"
                                               Classes="tabellenzelle zahl"
                                               Classes.einnahme="{Binding IstEinnahme}"
                                               Classes.archiviert="{Binding !IstAktiv}" />
                                    <anzeige:Textzelle Grid.Column="6" Inhalt="{Binding RhythmusText}"
                                                       Classes="tabellenzelle"
                                                       Classes.archiviert="{Binding !IstAktiv}" />
                                    <anzeige:Textzelle Grid.Column="8" Inhalt="{Binding PayerName}"
                                                       Classes="tabellenzelle"
                                                       Classes.archiviert="{Binding !IstAktiv}" />
                                    <TextBlock Grid.Column="10" Text="{Binding NaechsteFaelligkeitText}"
                                               Classes="tabellenzelle"
                                               Classes.archiviert="{Binding !IstAktiv}" />

                                    <!-- Anzahl bereits erzeugter Buchungen, zugleich der
                                         Sprung in die gefilterte Ausgabenliste. -->
                                    <Panel Grid.Column="12">
                                        <Button Content="{Binding ErzeugtText}"
                                                IsVisible="{Binding HatErzeugteBuchungen}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Diese Buchungen in der Ausgabenliste zeigen"
                                                Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).BuchungenAnzeigenCommand}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="—"
                                                   IsVisible="{Binding !HatErzeugteBuchungen}"
                                                   Classes="tabellenzelle mitte" />
                                    </Panel>

                                    <!-- Status als farbiges Badge statt reinem Text
                                         (UI/UX-Redesign, Abschnitt 5.7) - auf einen
                                         Blick erkennbar, welche Vorlagen gerade wirken. -->
                                    <Border Grid.Column="14" Classes="badge" HorizontalAlignment="Left"
                                            Classes.aktiv="{Binding IstAktiv}"
                                            Classes.pausiert="{Binding !IstAktiv}">
                                        <TextBlock Text="{Binding StatusText}" />
                                    </Border>

                                    <StackPanel Grid.Column="16" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="secondary klein" Content="Bearbeiten"
                                                Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).BearbeitenOeffnenCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="secondary klein" Content="Deaktivieren"
                                                IsVisible="{Binding IstAktiv}"
                                                ToolTip.Tip="Stoppt die künftige Erzeugung. Bereits erzeugte Buchungen bleiben unverändert."
                                                Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).DeaktivierenCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="secondary klein" Content="Aktivieren"
                                                IsVisible="{Binding !IstAktiv}"
                                                Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).AktivierenCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="danger klein" Content="Löschen"
                                                Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).LoeschenCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ Overlay: Loesch-Sicherheitsabfrage ============ -->
        <Panel IsVisible="{Binding LoeschAnfrageAktiv}" Background="#60000000">
            <Border Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="24"
                    MaxWidth="{anzeige:Breite 560}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding LoeschAnfrageText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Abbrechen" Command="{Binding LoeschenAbbrechenCommand}" />
                        <Button Classes="danger" Content="Löschen" Command="{Binding LoeschenBestaetigenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============ Overlay: Formular ============ -->
        <Panel IsVisible="{Binding BearbeitenAktiv}" Background="#60000000">
            <!-- Hoehe aus dem Fenster statt fest: das Formular wird mit
                 der Schriftgroesse hoeher, und der ScrollViewer darin
                 faengt den Rest ab. -->
            <Border Background="{DynamicResource SurfaceRaisedFarbe}" BorderBrush="{DynamicResource BorderStarkFarbe}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="24"
                    MaxWidth="{anzeige:Breite 520}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DockPanel DataContext="{Binding Bearbeiten}"
                           x:DataType="vm:VorlageBearbeitenViewModel">

                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Titelzeile}"
                               Classes="ueberschrift" Margin="0,0,0,10" />

                    <!-- Abschluss unten festgenagelt, damit die Schaltflaechen
                         beim Scrollen im Formular sichtbar bleiben. -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                        <!-- Rueckwirkende Erzeugung ab elf Buchungen: ausdrueckliche Abfrage -->
                        <Border IsVisible="{Binding RueckwirkendAbfrageSichtbar}"
                                Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                CornerRadius="8" Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding RueckwirkendAbfrageText}" Classes="hinweis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Content="Ja, erzeugen"
                                            Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).RueckwirkendBestaetigenCommand}" />
                                    <Button Classes="ghost" Content="Abbrechen"
                                            Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).RueckwirkendAbbrechenCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Schreibfehler: das Formular bleibt offen und
                             vollständig gefüllt. -->
                        <Border IsVisible="{Binding SpeicherFehlerSichtbar}"
                                Background="{DynamicResource FehlerFlaeche}" BorderBrush="{DynamicResource FehlerRahmen}" BorderThickness="1"
                                CornerRadius="8" Padding="8">
                            <TextBlock Text="{Binding SpeicherFehlerText}" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="ghost" Content="Abbrechen"
                                    Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).BearbeitenAbbrechenCommand}" />
                            <Button Classes="primary" Content="Speichern"
                                    Command="{Binding #Wurzel.((vm:VorlagenViewModel)DataContext).BearbeitenSpeichernCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel Spacing="2">
                            <!-- Regel 6: die Historie haengt nicht an der Vorlage -->
                            <Border IsVisible="{Binding BetragHinweisSichtbar}"
                                    Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,10">
                                <TextBlock Classes="hinweis"
                                           Text="Änderungen wirken nur auf künftig erzeugte Buchungen. Bereits erzeugte Buchungen behalten Betrag, Kategorie und Zahler, die zum Zeitpunkt ihrer Erzeugung galten." />
                            </Border>

                            <!-- Startdatum nach vorne verschoben, obwohl schon erzeugt wurde -->
                            <Border IsVisible="{Binding StartVorverlegtHinweisSichtbar}"
                                    Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding StartVorverlegtHinweis}" Classes="hinweis" />
                            </Border>

                            <TextBlock Text="Titel" />
                            <TextBox Text="{Binding Titel}" PlaceholderText="z. B. Stallmiete Ponyhof Weber" />
                            <TextBlock Text="{Binding TitelFehler}"
                                       IsVisible="{Binding TitelFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <!-- Das €-Zeichen steht in der Beschriftung, nicht
                                 im Feld: eingegeben wird die blanke Zahl. -->
                            <TextBlock Text="Betrag (€)" Classes="formularbeschriftung" />
                            <TextBox Text="{Binding BetragText}" PlaceholderText="0,00" />
                            <TextBlock Text="{Binding BetragFehler}"
                                       IsVisible="{Binding BetragFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <!-- Einnahme statt Ausgabe: mindert die
                                 Summen in Liste und Auswertung, statt
                                 sie zu erhoehen. Gilt fuer alle aus
                                 dieser Vorlage erzeugten Buchungen. -->
                            <CheckBox Content="Einnahme"
                                      IsChecked="{Binding IstEinnahme}" />

                            <TextBlock Text="Kategorie" Classes="formularbeschriftung" />
                            <AutoCompleteBox ItemsSource="{Binding KategorieVorschlaege}"
                                             ValueMemberBinding="{Binding FullPath}"
                                             FilterMode="Contains"
                                             SelectedItem="{Binding AusgewaehlteKategorie}"
                                             PlaceholderText="Kategorie suchen...">
                                <AutoCompleteBox.ItemTemplate>
                                    <DataTemplate x:DataType="categories:CategoryOption">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="farbpunkt"
                                                    Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                                            <TextBlock Text="{Binding FullPath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <TextBlock Text="{Binding KategorieFehler}"
                                       IsVisible="{Binding KategorieFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <TextBlock Text="Zahler" Classes="formularbeschriftung" />
                            <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                                      SelectedItem="{Binding AusgewaehlterZahler}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Person">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ZahlerFehler}"
                                       IsVisible="{Binding ZahlerFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <!-- Kein anderer Zahler vorhanden, um eine
                                 gerade angekreuzte Einnahme zuzuordnen -
                                 das Haekchen wurde deshalb bereits
                                 automatisch zurueckgesetzt (siehe
                                 VorlageBearbeitenViewModel.AktualisiereZahlerAuswahl). -->
                            <TextBlock Text="{Binding EinnahmeHinweisText}"
                                       IsVisible="{Binding EinnahmeHinweisSichtbar}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarnungText}"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="Bemerkung" Classes="formularbeschriftung" />
                            <TextBox Text="{Binding Bemerkung}" />

                            <TextBlock Text="Rhythmus" FontWeight="Bold" Margin="0,16,0,4" />

                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Einheit" />
                                    <ComboBox ItemsSource="{Binding IntervallOptionen}"
                                              SelectedItem="{Binding AusgewaehlteIntervallEinheit}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:IntervallOption">
                                                <TextBlock Text="{Binding Bezeichnung}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="alle ..." />
                                    <TextBox Text="{Binding IntervallAnzahlText}" />
                                </StackPanel>

                                <!-- Ankertag gibt es nur bei Monat und Jahr;
                                     bei Tag und Woche waere er sinnlos. -->
                                <StackPanel Grid.Column="4" IsVisible="{Binding AnkertagSichtbar}">
                                    <TextBlock Text="Tag im Monat" />
                                    <TextBox Text="{Binding AnkertagText}" PlaceholderText="1-31" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding IntervallAnzahlFehler}"
                                       IsVisible="{Binding IntervallAnzahlFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />
                            <TextBlock Text="{Binding AnkertagFehler}"
                                       IsVisible="{Binding AnkertagFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <!-- Regel 5: Kuerzung auf den Monatsletzten -->
                            <Border IsVisible="{Binding AnkertagHinweisSichtbar}"
                                    Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                    Padding="8" Margin="0,8,0,0">
                                <TextBlock Classes="hinweis"
                                           Text="Diesen Tag gibt es nicht in jedem Monat. In kürzeren Monaten wird auf den letzten Tag des Monats gekürzt — der Termin wandert dadurch nicht dauerhaft, im nächsten langen Monat trifft er wieder genau." />
                            </Border>

                            <Grid ColumnDefinitions="*,12,*" Margin="0,10,0,0">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Startdatum" />
                                    <TextBox Text="{Binding StartDatumText}" PlaceholderText="TT.MM.JJJJ" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Enddatum (optional)" />
                                    <TextBox Text="{Binding EndDatumText}" PlaceholderText="leer = unbefristet" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding StartDatumFehler}"
                                       IsVisible="{Binding StartDatumFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />
                            <TextBlock Text="{Binding EndDatumFehler}"
                                       IsVisible="{Binding EndDatumFehlerSichtbar}" Foreground="{DynamicResource FehlerText}" />

                            <CheckBox Content="Aktiv" IsChecked="{Binding IstAktiv}" Margin="0,10,0,0"
                                      ToolTip.Tip="Inaktive Vorlagen erzeugen nichts mehr, bleiben aber erhalten." />

                            <TextBlock Text="Nächste Fälligkeiten" FontWeight="Bold" Margin="0,16,0,4" />

                            <Border Background="{DynamicResource CanvasFarbe}" BorderBrush="{DynamicResource BorderDezentFarbe}" BorderThickness="1"
                                    CornerRadius="8" Padding="8">
                                <StackPanel Spacing="4">
                                    <ItemsControl ItemsSource="{Binding VorschauTermine}"
                                                  IsVisible="{Binding VorschauSichtbar}" />
                                    <TextBlock Text="{Binding VorschauLeerText}"
                                               IsVisible="{Binding !VorschauSichtbar}"
                                               Foreground="{DynamicResource TextTertiaerFarbe}" FontStyle="Italic"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding RueckwirkendSichtbar}"
                                    Background="{DynamicResource WarnungFlaeche}" BorderBrush="{DynamicResource WarnungRahmen}" BorderThickness="1"
                                    Padding="8" Margin="0,8,0,0">
                                <TextBlock Text="{Binding RueckwirkendText}" Classes="hinweis" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
