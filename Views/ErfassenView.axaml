<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:categories="using:Ausgabenverwaltung.Core.Categories"
             xmlns:entities="using:Ausgabenverwaltung.Core.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.ErfassenView"
             x:DataType="vm:ErfassenViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SpeichernCommand}" />
    </UserControl.KeyBindings>

    <!-- UI/UX-Redesign, Abschnitt 5.1: zweispaltiges Layout - Formular
         links in fester Kartenbreite, "Letzte Buchungen" rechts statt
         darunter, beide gleichzeitig sichtbar ohne Scrollen.
         Feldbeschriftungen als kleine Versalien ueber dem Feld
         (Classes="feldbeschriftung"), Meldungen im neuen Banner-Stil. -->
    <DockPanel Margin="32,24">
        <TextBlock DockPanel.Dock="Top" Classes="seitentitel" Text="Erfassen" Margin="0,0,0,20" />

        <Grid ColumnDefinitions="Auto,16,*">
            <!-- ============ Formular ============ -->
            <StackPanel Grid.Column="0" Width="{anzeige:Breite 420}" Spacing="12">
                <Border Classes="karte">
                    <StackPanel Spacing="2">
                        <!-- Das €-Zeichen steht in der Beschriftung, nicht im Feld:
                             eingegeben wird die blanke Zahl. -->
                        <TextBlock Text="BETRAG (€)" Classes="feldbeschriftung" Margin="0,0,0,3" />
                        <TextBox x:Name="BetragBox"
                                 Text="{Binding BetragText}"
                                 PlaceholderText="0,00"
                                 FontSize="{DynamicResource SchriftUeberschrift}"
                                 TabIndex="1" />
                        <TextBlock Text="{Binding BetragFehler}"
                                   IsVisible="{Binding BetragFehlerSichtbar}"
                                   Classes="fehler" />

                        <!-- Einnahme statt Ausgabe: mindert die Summen in Liste und
                             Auswertung, statt sie zu erhoehen (Regel 4-aehnliches
                             Attribut, siehe Entities.Expense.IsIncome). -->
                        <CheckBox Content="Einnahme"
                                  IsChecked="{Binding IstEinnahme}"
                                  Margin="0,10,0,0"
                                  TabIndex="2" />

                        <TextBlock Text="KATEGORIE" Classes="feldbeschriftung" />
                        <AutoCompleteBox ItemsSource="{Binding KategorieVorschlaege}"
                                          ValueMemberBinding="{Binding FullPath}"
                                          FilterMode="Contains"
                                          SelectedItem="{Binding AusgewaehlteKategorie}"
                                          PlaceholderText="Kategorie suchen..."
                                          TabIndex="3">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="categories:CategoryOption">
                                    <!-- Farbe der Kategorie vor dem Pfad. Sie hilft beim
                                         Wiedererkennen, gesucht und ausgewaehlt wird
                                         aber weiterhin ueber den Text. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Classes="farbpunkt"
                                                Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                                        <TextBlock Text="{Binding FullPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                        <TextBlock Text="{Binding KategorieFehler}"
                                   IsVisible="{Binding KategorieFehlerSichtbar}"
                                   Classes="fehler" />

                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DATUM" Classes="feldbeschriftung" />
                                <TextBox Text="{Binding DatumText}"
                                         PlaceholderText="TT.MM.JJJJ"
                                         TabIndex="4" />
                                <TextBlock Text="{Binding DatumFehler}"
                                           IsVisible="{Binding DatumFehlerSichtbar}"
                                           Classes="fehler" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ZAHLER" Classes="feldbeschriftung" />
                                <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                                          SelectedItem="{Binding AusgewaehlterZahler}"
                                          HorizontalAlignment="Stretch"
                                          TabIndex="6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Person">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding ZahlerFehler}"
                                           IsVisible="{Binding ZahlerFehlerSichtbar}"
                                           Classes="fehler" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="BEMERKUNG" Classes="feldbeschriftung" />
                        <TextBox Text="{Binding Bemerkung}" TabIndex="5" />

                        <!-- Kein anderer Zahler vorhanden, um eine gerade angekreuzte
                             Einnahme zuzuordnen - das Haekchen wurde deshalb bereits
                             automatisch zurueckgesetzt (siehe
                             ErfassenViewModel.AktualisiereZahlerAuswahl). -->
                        <Border Classes="banner warnung" IsVisible="{Binding EinnahmeHinweisSichtbar}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding EinnahmeHinweisText}" TextWrapping="Wrap" />
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                            <Button Grid.Column="0" Classes="primary"
                                    Command="{Binding SpeichernCommand}"
                                    TabIndex="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{DynamicResource IconErfassen}"
                                          Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                                          Stretch="Uniform" StrokeThickness="1.75"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" Stroke="{DynamicResource TextAufAccentFarbe}" />
                                    <TextBlock Text="Speichern" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Text="Strg+Enter speichert direkt"
                                       Classes="klein" Foreground="{DynamicResource TextTertiaerFarbe}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="banner erfolg" IsVisible="{Binding BestaetigungSichtbar}">
                    <TextBlock Text="Gespeichert." />
                </Border>

                <!-- Schreibfehler: das Formular bleibt darunter unveraendert
                     stehen, damit keine Eingabe verloren geht. -->
                <Border Classes="banner fehler" IsVisible="{Binding SpeicherFehlerSichtbar}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SpeicherFehlerText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost"
                                Content="Schließen"
                                VerticalAlignment="Top"
                                Command="{Binding SpeicherFehlerSchliessenCommand}" />
                    </Grid>
                </Border>

                <!-- Rueckfrage bei einem ungewoehnlichen Datum. Kein Verbot: der
                     Anwender bestaetigt einmal und speichert dann. -->
                <Border Classes="banner warnung" IsVisible="{Binding DatumRueckfrageSichtbar}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DatumRueckfrageText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="Ja, so speichern"
                                    Command="{Binding DatumBestaetigenCommand}" />
                            <Button Classes="ghost" Content="Datum ändern"
                                    Command="{Binding DatumRueckfrageAbbrechenCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Letzte Buchungen ============ -->
            <Border Grid.Column="2" Classes="karte" VerticalAlignment="Top">
                <StackPanel Spacing="4">
                    <TextBlock Text="Letzte Buchungen" Classes="ueberschrift" Margin="0,0,0,6" />

                    <!-- Drei Textbloecke statt eines: nur so laesst sich der
                         Betrag als Erstattung einfaerben, waehrend der Rest der
                         Zeile in der gewoehnlichen Schriftfarbe stehen bleibt. -->
                    <ItemsControl ItemsSource="{Binding LetzteAusgaben}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LetzteAusgabeZeile">
                                <Border BorderBrush="{DynamicResource BorderDezentFarbe}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VorText}" />
                                        <TextBlock Text="{Binding BetragText}"
                                                   Classes.offen="{Binding IstOffen}"
                                                   Classes.einnahme="{Binding IstEinnahme}"
                                                   Classes.beglichen-ausgabe="{Binding IstBeglichenAusgabe}" />
                                        <TextBlock Text="{Binding NachText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
