<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:categories="using:Ausgabenverwaltung.Core.Categories"
             xmlns:entities="using:Ausgabenverwaltung.Core.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.ErfassenView"
             x:DataType="vm:ErfassenViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SpeichernCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding BestaetigungSichtbar}"
                Background="#DFF5DF"
                BorderBrush="#8FCB8F"
                BorderThickness="0,0,0,1"
                Padding="8"
                Margin="0,0,0,12">
            <TextBlock Text="Gespeichert." />
        </Border>

        <!-- Schreibfehler: das Formular bleibt darunter unverändert
             stehen, damit keine Eingabe verloren geht. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding SpeicherFehlerSichtbar}"
                Background="#FFE0E0"
                BorderBrush="#D08080"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,12">
            <Grid anzeige:Raster.Spalten="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SpeicherFehlerText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Schließen"
                        VerticalAlignment="Top"
                        Command="{Binding SpeicherFehlerSchliessenCommand}" />
            </Grid>
        </Border>

        <!-- Rückfrage bei einem ungewöhnlichen Datum. Kein Verbot: der
             Anwender bestätigt einmal und speichert dann. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding DatumRueckfrageSichtbar}"
                Background="#FFF4CE"
                BorderBrush="#E0C36A"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding DatumRueckfrageText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Ja, so speichern"
                            Command="{Binding DatumBestaetigenCommand}" />
                    <Button Content="Datum ändern"
                            Command="{Binding DatumRueckfrageAbbrechenCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Width="{anzeige:Breite 420}"
                    HorizontalAlignment="Left" Spacing="2">
            <!-- Das €-Zeichen steht in der Beschriftung, nicht im Feld:
                 eingegeben wird die blanke Zahl. -->
            <TextBlock Text="Betrag (€)" />
            <TextBox x:Name="BetragBox"
                     Text="{Binding BetragText}"
                     PlaceholderText="0,00"
                     TabIndex="1" />
            <TextBlock Text="{Binding BetragFehler}"
                       IsVisible="{Binding BetragFehlerSichtbar}"
                       Foreground="Red" />

            <TextBlock Text="Kategorie" Margin="0,10,0,0" />
            <AutoCompleteBox ItemsSource="{Binding KategorieVorschlaege}"
                              ValueMemberBinding="{Binding FullPath}"
                              FilterMode="Contains"
                              SelectedItem="{Binding AusgewaehlteKategorie}"
                              PlaceholderText="Kategorie suchen..."
                              TabIndex="2">
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="categories:CategoryOption">
                        <!-- Farbe der Kategorie vor dem Pfad. Sie hilft beim
                             Wiedererkennen, gesucht und ausgewaehlt wird
                             aber weiterhin ueber den Text. -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="farbpunkt"
                                    Background="{Binding Color, Converter={x:Static anzeige:FarbeZuPinsel.Instanz}}" />
                            <TextBlock Text="{Binding FullPath}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <TextBlock Text="{Binding KategorieFehler}"
                       IsVisible="{Binding KategorieFehlerSichtbar}"
                       Foreground="Red" />

            <TextBlock Text="Datum" Margin="0,10,0,0" />
            <TextBox Text="{Binding DatumText}"
                     PlaceholderText="TT.MM.JJJJ"
                     TabIndex="3" />
            <TextBlock Text="{Binding DatumFehler}"
                       IsVisible="{Binding DatumFehlerSichtbar}"
                       Foreground="Red" />

            <TextBlock Text="Bemerkung" Margin="0,10,0,0" />
            <TextBox Text="{Binding Bemerkung}" TabIndex="4" />

            <TextBlock Text="Zahler" Margin="0,10,0,0" />
            <ComboBox ItemsSource="{Binding ZahlerOptionen}"
                      SelectedItem="{Binding AusgewaehlterZahler}"
                      HorizontalAlignment="Stretch"
                      TabIndex="5">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="entities:Person">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Speichern"
                    Command="{Binding SpeichernCommand}"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    TabIndex="6" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" Spacing="4">
            <TextBlock Text="Letzte Ausgaben" FontWeight="Bold" />

            <!-- Drei Textbloecke statt eines: nur so laesst sich der
                 Betrag als Erstattung einfaerben, waehrend der Rest der
                 Zeile in der gewoehnlichen Schriftfarbe stehen bleibt. -->
            <ItemsControl ItemsSource="{Binding LetzteAusgaben}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LetzteAusgabeZeile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VorText}" />
                            <TextBlock Text="{Binding BetragText}"
                                       Classes.erstattung="{Binding IstErstattung}" />
                            <TextBlock Text="{Binding NachText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</UserControl>
