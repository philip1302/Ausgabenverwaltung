<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:anzeige="using:Ausgabenverwaltung.Anzeige"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.StartseiteView"
             x:Name="Wurzel"
             x:DataType="vm:StartseiteViewModel">

    <!-- Neue Startseite (UI/UX-Redesign, Abschnitt 4): ersetzt "Erfassen"
         als ersten Eindruck durch einen Ueberblick statt eines leeren
         Formulars. Reiner Lesezugriff auf bestehende Core-Abfragen (siehe
         StartseiteViewModel) - hier steht nur die Zusammenstellung. -->
    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="24">

            <!-- ============ Kopfzeile ============ -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="seitentitel" Text="Guten Tag" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" VerticalAlignment="Top"
                        Command="{Binding AusgabeErfassenCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="{DynamicResource IconErfassen}"
                              Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                              Stretch="Uniform" StrokeThickness="1.75"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent" Stroke="{DynamicResource TextAufAccentFarbe}" />
                        <TextBlock Text="Ausgabe erfassen" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ Vier KPI-Kacheln ============
                 Prozentuale Spalten (UniformGrid) statt fester Pixelbreiten
                 (Regel 9) - alle vier greifen auf bereits vorhandene
                 Core-Abfragen zurueck, keine neue Fachlogik.

                 Jede Kachel ist ganzflaechig anklickbar und fuehrt dorthin,
                 wo ihre Zahl herkommt (Button.kachel in App.axaml zeichnet
                 selbst nichts, die Border.kpi darin behaelt ihr Aussehen).
                 Hat eine Kachel nichts zu zeigen, ist ihr Knopf
                 ausgeschaltet - ein Sprung ins Nichts ist schlimmer als
                 kein Sprung. -->
            <UniformGrid Columns="4" Rows="1">
                <Button Classes="kachel" Margin="0,0,8,0"
                        IsEnabled="{Binding AusgabenMonatVorhanden}"
                        ToolTip.Tip="Zeigt die Ausgaben dieses Monats in der Ausgabenliste"
                        Command="{Binding AusgabenMonatOeffnenCommand}">
                <Border Classes="kpi">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,6,*">
                            <!-- Neutral statt rot: die Kachel mischt eigene UND noch
                                 offene fremde Ausgaben (PayerScope.SelfAndOpen) zu
                                 einer Summe - unter der Summen-Regel (negativ =
                                 neutral) verliert sie ihre bisherige rote
                                 Hervorhebung, wie die uebrigen neutralen Kacheln
                                 rechts daneben. -->
                            <Path Grid.Column="0" Data="{DynamicResource IconPfeilHoch}"
                                  Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}" />
                            <TextBlock Grid.Column="2" Classes="kpi-label" Text="Ausgaben, diesen Monat" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="kpi-wert" Text="{Binding AusgabenMonatText}" />

                        <!-- Der Verlauf der letzten zwoelf Monate. Keine
                             Achse und keine Zahl: die Zahl steht darueber,
                             die Linie sagt nur, wohin es geht. Sie bleibt
                             weg, solange es nichts zu zeigen gibt.

                             Verborgen wird die LINIE, nicht der Rahmen:
                             ein unsichtbares Element wird nicht vermessen
                             und meldet dann auch keine Groesse mehr - die
                             Linie kann dann nie erscheinen. Der stehen
                             bleibende Rahmen haelt ausserdem die
                             Hinweiszeilen beider Kacheln auf einer Hoehe.

                             Nur DIESE Flaeche meldet ihre Groesse - beide
                             Kacheln sind gleich breit, weil sie in einem
                             UniformGrid stehen. -->
                        <Border Height="{anzeige:Breite 28}"
                                SizeChanged="Verlaufflaeche_Groesse">
                            <Polyline Classes="sparkline"
                                      IsVisible="{Binding AusgabenVerlaufVorhanden}"
                                      Points="{Binding AusgabenVerlauf}" />
                        </Border>

                        <TextBlock Classes="kpi-hinweis" Text="{Binding AusgabenMonatHinweis}" />
                    </StackPanel>
                </Border>
                </Button>

                <Button Classes="kachel" Margin="8,0"
                        IsEnabled="{Binding EinnahmenMonatVorhanden}"
                        ToolTip.Tip="Zeigt die eingegangenen Einnahmen dieses Monats in der Ausgabenliste"
                        Command="{Binding EinnahmenMonatOeffnenCommand}">
                <Border Classes="kpi">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,6,*">
                            <Path Grid.Column="0" Data="{DynamicResource IconPfeilRunter}"
                                  Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource EinnahmeFarbe}" />
                            <TextBlock Grid.Column="2" Classes="kpi-label" Text="Einnahmen, diesen Monat" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="kpi-wert einnahme" Text="{Binding EinnahmenMonatText}" />

                        <Border Height="{anzeige:Breite 28}">
                            <Polyline Classes="sparkline einnahme"
                                      IsVisible="{Binding EinnahmenVerlaufVorhanden}"
                                      Points="{Binding EinnahmenVerlauf}" />
                        </Border>

                        <TextBlock Classes="kpi-hinweis" Text="{Binding EinnahmenMonatHinweis}" />
                    </StackPanel>
                </Border>
                </Button>

                <Button Classes="kachel" Margin="8,0"
                        IsEnabled="{Binding OffenePostenVorhanden}"
                        ToolTip.Tip="Öffnet den Bereich „Offene Posten“"
                        Command="{Binding OffenePostenOeffnenCommand}">
                <Border Classes="kpi">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,6,*">
                            <Path Grid.Column="0" Data="{DynamicResource IconOffenePosten}"
                                  Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}" />
                            <TextBlock Grid.Column="2" Classes="kpi-label" Text="Offene Posten" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="kpi-wert" Text="{Binding OffenePostenText}" />
                        <TextBlock Classes="kpi-hinweis" Text="{Binding OffenePostenHinweis}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </Button>

                <Button Classes="kachel" Margin="8,0,0,0"
                        IsEnabled="{Binding NaechsteFaelligkeitVorhanden}"
                        ToolTip.Tip="Zeigt diese Vorlage unter „Wiederkehrende Ausgaben“"
                        Command="{Binding NaechsteFaelligkeitOeffnenCommand}">
                <Border Classes="kpi">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,6,*">
                            <Path Grid.Column="0" Data="{DynamicResource IconVorlagen}"
                                  Width="{anzeige:Breite 16}" Height="{anzeige:Breite 16}"
                                  Stretch="Uniform" StrokeThickness="1.75"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Fill="Transparent" Stroke="{DynamicResource TextTertiaerFarbe}" />
                            <TextBlock Grid.Column="2" Classes="kpi-label" Text="Nächste fällige Vorlage" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock FontSize="{DynamicResource SchriftUeberschrift}" FontWeight="Bold"
                                   Text="{Binding NaechsteFaelligkeitTitel}" TextWrapping="Wrap"
                                   Classes.archiviert="{Binding !NaechsteFaelligkeitVorhanden}" />
                        <TextBlock Classes="kpi-hinweis" Text="{Binding NaechsteFaelligkeitHinweis}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </Button>
            </UniformGrid>

            <!-- ============ Netto-Trend + Letzte Buchungen ============ -->
            <Grid ColumnDefinitions="2*,16,1*">
                <Border Grid.Column="0" Classes="karte">
                    <DockPanel>
                        <!-- ============ Kopf: Titel und Bedienung ============ -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="ueberschrift" TextWrapping="Wrap"
                                           Text="{Binding DiagrammUeberschrift}" />
                                <TextBlock Classes="klein" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaerFarbe}"
                                           Text="{Binding DiagrammZusammenfassung}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Top">
                                <!-- Ansicht. Dasselbe Muster wie die Zeitraum-
                                     Schnellwahl der Auswertung: der aktive Knopf
                                     traegt die Klasse "aktiv" (siehe TextGleich). -->
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="secondary klein" Content="Detail"
                                            Command="{Binding AnsichtWaehlenCommand}" CommandParameter="Detail"
                                            Classes.aktiv="{Binding AktiveAnsicht,
                                                Converter={x:Static anzeige:TextGleich.Instanz},
                                                ConverterParameter=Detail}" />
                                    <Button Classes="secondary klein" Content="Netto"
                                            Command="{Binding AnsichtWaehlenCommand}" CommandParameter="Netto"
                                            Classes.aktiv="{Binding AktiveAnsicht,
                                                Converter={x:Static anzeige:TextGleich.Instanz},
                                                ConverterParameter=Netto}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="secondary klein" Content="6 M"
                                            Command="{Binding ZeitraumWaehlenCommand}" CommandParameter="6"
                                            Classes.aktiv="{Binding AktiverZeitraum,
                                                Converter={x:Static anzeige:TextGleich.Instanz},
                                                ConverterParameter=6}" />
                                    <Button Classes="secondary klein" Content="12 M"
                                            Command="{Binding ZeitraumWaehlenCommand}" CommandParameter="12"
                                            Classes.aktiv="{Binding AktiverZeitraum,
                                                Converter={x:Static anzeige:TextGleich.Instanz},
                                                ConverterParameter=12}" />
                                    <Button Classes="secondary klein" Content="24 M"
                                            Command="{Binding ZeitraumWaehlenCommand}" CommandParameter="24"
                                            Classes.aktiv="{Binding AktiverZeitraum,
                                                Converter={x:Static anzeige:TextGleich.Instanz},
                                                ConverterParameter=24}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ============ Legende ============
                             Farbe ist immer nur Zusatz (Regel 10) - was welche
                             Farbe bedeutet, steht hier als Text daneben. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Spacing="16" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding Detailansicht}">
                                <Border Classes="legende eigene-ausgabe" />
                                <TextBlock Classes="klein" Text="Selbst gezahlt" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding Detailansicht}">
                                <Border Classes="legende offene-ausgabe" />
                                <TextBlock Classes="klein" Text="Ausgelegt, noch offen" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding Detailansicht}">
                                <Border Classes="legende einnahme" />
                                <TextBlock Classes="klein" Text="Eingenommen" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding !Detailansicht}">
                                <Border Classes="legende einnahme" />
                                <TextBlock Classes="klein" Text="Überschuss" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding !Detailansicht}">
                                <Border Classes="legende eigene-ausgabe" />
                                <TextBlock Classes="klein" Text="Ausgabenüberhang" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="legende durchschnitt" />
                                <TextBlock Classes="klein" Text="Durchschnitt" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ============ Zeichenflaeche ============
                             EINE Flaeche fuer alles: Gitternetz, Balken und
                             beide Achsenbeschriftungen. Die Koordinaten rechnet
                             Core (Charts.BarChart) aus der gemeldeten Groesse -
                             kein gedachter Koordinatenraum und kein Viewbox
                             mehr, der Strichstaerken und Strichelmuster
                             verzerren wuerde.

                             Jedes ItemsControl braucht ausdruecklich ein Canvas
                             als ItemsPanel: ohne diese Angabe legt Avalonia die
                             Eintraege in einem StackPanel ab, und die absoluten
                             Koordinaten wirken nicht - daran war das Diagramm
                             hier schon einmal unsichtbar. -->
                        <Grid Height="{anzeige:Breite 240}" SizeChanged="Zeichenflaeche_Groesse">
                            <!-- Gitternetz und Nulllinie, ganz hinten -->
                            <ItemsControl ItemsSource="{Binding DiagrammLinien}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagrammLinie">
                                        <Line StartPoint="{Binding Von}" EndPoint="{Binding Bis}"
                                              ToolTip.Tip="{Binding Hinweis}"
                                              Classes.gitter="{Binding IstGitter}"
                                              Classes.nulllinie="{Binding IstNulllinie}"
                                              Classes.durchschnitt="{Binding IstDurchschnitt}"
                                              Classes.durchschnitt-ausgaben="{Binding IstDurchschnittAusgaben}"
                                              Classes.durchschnitt-einnahmen="{Binding IstDurchschnittEinnahmen}"
                                              Classes.durchschnitt-netto="{Binding IstDurchschnittNetto}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Balken. Als Button, damit der Klick in die
                                 Buchungen des Monats springt - und damit die
                                 Flaeche mit der Tastatur erreichbar bleibt. -->
                            <ItemsControl ItemsSource="{Binding DiagrammBalken}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!-- Ungepruefte Bindungen: die Setter binden
                                         an den Listeneintrag, der Bindungspruefer
                                         nimmt hier aber den Typ der Ansicht an. -->
                                    <ControlTheme TargetType="ContentPresenter" x:CompileBindings="False">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagrammBalken">
                                        <Button Classes="balken"
                                                Width="{Binding Breite}" Height="{Binding Hoehe}"
                                                ToolTip.Tip="{Binding Hinweis}"
                                                Command="{Binding $parent[ItemsControl].((vm:StartseiteViewModel)DataContext).MonatOeffnenCommand}"
                                                CommandParameter="{Binding Schluessel}"
                                                Classes.eigene-ausgabe="{Binding IstEigeneAusgabe}"
                                                Classes.offene-ausgabe="{Binding IstOffeneFremdausgabe}"
                                                Classes.einnahme="{Binding IstEinnahme}"
                                                Classes.netto-positiv="{Binding IstNettoPositiv}"
                                                Classes.netto-negativ="{Binding IstNettoNegativ}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Wertachse links -->
                            <ItemsControl ItemsSource="{Binding DiagrammWertachse}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!-- Ungepruefte Bindungen: die Setter binden
                                         an den Listeneintrag, der Bindungspruefer
                                         nimmt hier aber den Typ der Ansicht an. -->
                                    <ControlTheme TargetType="ContentPresenter" x:CompileBindings="False">
                                        <Setter Property="Canvas.Left" Value="0" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagrammWertBeschriftung">
                                        <TextBlock Text="{Binding Text}" Classes="klein"
                                                   Width="{Binding Breite}" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextTertiaerFarbe}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Zeitachse unten -->
                            <ItemsControl ItemsSource="{Binding DiagrammZeitachse}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerTheme>
                                    <!-- Ungepruefte Bindungen: die Setter binden
                                         an den Listeneintrag, der Bindungspruefer
                                         nimmt hier aber den Typ der Ansicht an. -->
                                    <ControlTheme TargetType="ContentPresenter" x:CompileBindings="False">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </ControlTheme>
                                </ItemsControl.ItemContainerTheme>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagrammZeitBeschriftung">
                                        <TextBlock Text="{Binding Text}" Classes="klein"
                                                   Width="{Binding Breite}" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiaerFarbe}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Leerzustand: ein Satz statt einer leeren Flaeche -->
                            <TextBlock IsVisible="{Binding DiagrammLeer}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaerFarbe}"
                                       Text="In diesem Zeitraum ist noch nichts erfasst." />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Classes="karte">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="ueberschrift" Text="Letzte Buchungen" Margin="0,0,0,10" />

                        <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="-12,10,0,0"
                                Foreground="{DynamicResource AccentFarbe}"
                                Content="Alle Buchungen ansehen →"
                                Command="{Binding AlleBuchungenAnsehenCommand}" />

                        <ItemsControl ItemsSource="{Binding LetzteBuchungen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LetzteAusgabeZeile">
                                    <!-- Die ganze Zeile ist der Knopf: ein Klick
                                         zeigt genau diese Buchung in der
                                         Ausgabenliste. Der Befehl haengt am
                                         ViewModel der Ansicht, nicht an der Zeile -
                                         deshalb der Umweg ueber #Wurzel. -->
                                    <Button Classes="zeile"
                                            ToolTip.Tip="Diese Buchung in der Ausgabenliste zeigen"
                                            Command="{Binding #Wurzel.((vm:StartseiteViewModel)DataContext).BuchungOeffnenCommand}"
                                            CommandParameter="{Binding}">
                                        <Border BorderBrush="{DynamicResource BorderDezentFarbe}"
                                                BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding VorText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BetragText}"
                                                           Classes.offen="{Binding IstOffen}"
                                                           Classes.einnahme="{Binding IstEinnahme}"
                                                           Classes.beglichen-ausgabe="{Binding IstBeglichenAusgabe}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
