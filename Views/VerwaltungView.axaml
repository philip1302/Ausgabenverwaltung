<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ausgabenverwaltung.ViewModels"
             xmlns:views="using:Ausgabenverwaltung.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ausgabenverwaltung.Views.VerwaltungView"
             x:DataType="vm:VerwaltungViewModel">
    <TabControl Margin="16">
        <TabItem Header="Kategorien">
            <views:KategorienView DataContext="{Binding Kategorien}" />
        </TabItem>
        <TabItem Header="Personen">
            <views:PersonenView DataContext="{Binding Personen}" />
        </TabItem>
        <TabItem Header="Wiederkehrende Ausgaben">
            <views:VorlagenView DataContext="{Binding Vorlagen}" />
        </TabItem>
        <TabItem Header="Datensicherung">
            <views:DatensicherungView DataContext="{Binding Datensicherung}" />
        </TabItem>
        <TabItem Header="Darstellung">
            <views:DarstellungView DataContext="{Binding Darstellung}" />
        </TabItem>
    </TabControl>
</UserControl>
