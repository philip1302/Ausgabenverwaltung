<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Transitive Abhaengigkeit auf gepatchte Version anheben (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Massgebliches DB-Schema aus docs/ einbetten, damit die
         Initialisierung unabhaengig vom Arbeitsverzeichnis funktioniert.
         Aeltere schema_vN.sql bleiben eingebettet, obwohl neue Datenbanken
         nach schema_v3.sql entstehen: die Tests legen damit Datenbanken in
         alten Staenden an und pruefen die Migration gegen die echten
         alten Schemata statt gegen Nachbildungen. -->
    <EmbeddedResource Include="..\docs\schema_v1.sql" Link="schema_v1.sql" />
    <EmbeddedResource Include="..\docs\schema_v2.sql" Link="schema_v2.sql" />
    <EmbeddedResource Include="..\docs\schema_v3.sql" Link="schema_v3.sql" />
    <EmbeddedResource Include="..\docs\migration_v1_to_v2.sql" Link="migration_v1_to_v2.sql" />
    <EmbeddedResource Include="..\docs\migration_v2_to_v3.sql" Link="migration_v2_to_v3.sql" />
  </ItemGroup>

</Project>
